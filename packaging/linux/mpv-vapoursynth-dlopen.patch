+// VSScript checks its configuration against the path it was loaded from, and
+// `vapoursynth config` records the real file rather than the symlinks
+// distributions put in the library directory. So where the library can be
+// found it is opened by its real path, and by name only failing that.
+static void *open_vsscript(const char *name)
+{
+    static const char *const dirs[] = {
+        "/usr/local/lib", "/usr/lib", "/usr/lib64",
+        "/usr/lib/x86_64-linux-gnu", "/usr/lib/aarch64-linux-gnu",
+    };
+    char path[PATH_MAX], real[PATH_MAX];
+    for (size_t i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+        snprintf(path, sizeof(path), "%s/%s", dirs[i], name);
+        if (!realpath(path, real))
+            continue;
+        void *lib = dlopen(real, RTLD_NOW | RTLD_GLOBAL);
+        if (lib)
+            return lib;
+    }
+    return dlopen(name, RTLD_NOW | RTLD_GLOBAL);
+}
+
+// VSScript is looked up when the filter is first used rather than linked, so
+// that a libmpv built with this filter still loads where VapourSynth is not
+// installed; the filter alone then fails, saying why.
+static const VSSCRIPTAPI *load_vsscript(void)
+{
+    static const char *const names[] = {
+        "libvapoursynth-script.so.0",
+        "libvapoursynth-script.so",
+        "libvsscript.so",
+    };
+    for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+        void *lib = open_vsscript(names[i]);
+        if (!lib)
+            continue;
+        const VSSCRIPTAPI *(*get)(int) =
+            (const VSSCRIPTAPI *(*)(int))dlsym(lib, "getVSScriptAPI");
+        if (get)
+            return get(VSSCRIPT_API_VERSION);
+        dlclose(lib);
+    }
+    return NULL;
+}
+
 static int drv_vss_init(struct priv *p)
 {
-    p->vs_script_api = getVSScriptAPI(VSSCRIPT_API_VERSION);
+    p->vs_script_api = load_vsscript();
