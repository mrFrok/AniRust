//
// A release as a browsing screen shows it.

import { MaterialPalette } from "../globals/material-palette.slint";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing, Motion } from "../globals/shape.slint";
import { ReleaseCard } from "../structs.slint";

/// One tab of a destination.
///
/// An underline rather than a pill: tabs name the parts of one thing, and the
/// official client marks the current one the same way. The whole label is the
/// target, which on a desktop is what a pointer expects.
export component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;

    width: label-text.preferred-width;
    background: transparent;

    label-text := Text {
        text: root.label;
        color: root.selected
            ? MaterialPalette.primary
            : (touch.has-hover ? MaterialPalette.on-surface : MaterialPalette.on-surface-variant);
        font-size: Typography.title-medium-size;
        font-weight: root.selected
            ? Typography.title-medium-weight-em
            : Typography.label-large-weight;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    Rectangle {
        y: parent.height - self.height - 4px;
        height: 3px;
        width: root.selected ? parent.width : 0px;
        x: (parent.width - self.width) / 2;
        border-radius: 2px;
        background: MaterialPalette.primary;
        animate width { duration: Motion.enter-duration; easing: Motion.enter; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A selectable chip, for choosing a section or a genre.
///
/// The player has one of these too, but that one lives on video and is white on
/// translucency; this one sits on a surface and uses the palette.
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    /// A quieter size, for the long second row of genres.
    in property <bool> small: false;
    callback clicked;

    height: root.small ? 30px : 34px;
    width: text.preferred-width + (root.small ? Spacing.base : Spacing.comfortable);
    border-radius: touch.pressed ? Shape.small : Shape.pill;
    border-width: root.selected ? 0px : 1px;
    border-color: MaterialPalette.outline-variant;
    background: root.selected
        ? MaterialPalette.primary-container
        : (touch.has-hover ? MaterialPalette.surface-container-high : transparent);
    animate border-radius { duration: Motion.spring-duration; easing: Motion.spring; }
    animate background { duration: Motion.standard-duration; easing: Motion.standard; }

    text := Text {
        text: root.label;
        color: root.selected
            ? MaterialPalette.on-primary-container
            : MaterialPalette.on-surface-variant;
        font-size: root.small ? Typography.label-medium-size : Typography.label-large-size;
        font-weight: root.selected
            ? Typography.label-large-weight-em
            : Typography.label-large-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One poster with its title underneath.
export component PosterCard inherits Rectangle {
    in property <ReleaseCard> card;
    callback clicked;

    background: transparent;

    VerticalLayout {
        spacing: Spacing.tight;

        Rectangle {
            vertical-stretch: 1;
            border-radius: Shape.large;
            clip: true;
            background: MaterialPalette.surface-container-high;
            // Lifts slightly under the pointer, which is the whole hover
            // affordance a poster needs.
            border-width: touch.has-hover ? 2px : 0px;
            border-color: MaterialPalette.primary;
            animate border-width { duration: Motion.standard-duration; easing: Motion.standard; }

            Image {
                source: root.card.poster;
                image-fit: cover;
                width: 100%;
                height: 100%;
                opacity: root.card.poster-loaded ? 1.0 : 0.0;
                animate opacity { duration: Motion.enter-duration; easing: Motion.enter; }
            }

            // Score sits on the poster, as it does on every catalogue that has
            // ever shown one.
            if root.card.score != "": Rectangle {
                x: parent.width - self.width - Spacing.small;
                y: Spacing.small;
                height: 22px;
                width: score.preferred-width + Spacing.medium;
                border-radius: Shape.small;
                background: #000000B3;

                score := Text {
                    text: "★ " + root.card.score;
                    color: #FFFFFF;
                    font-size: Typography.label-small-size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // Two lines at most, then elided: a wall of cards lives on its
        // rhythm, and a title long enough to need a third is long enough to
        // cut.
        Text {
            text: root.card.title;
            color: MaterialPalette.on-surface;
            font-size: Typography.body-medium-size;
            wrap: word-wrap;
            // `max-lines` cuts the third line; `elide` on its own would cut at
            // the first, because eliding and wrapping are alternatives.
            max-lines: 2;
            height: 38px;
        }

        Text {
            text: root.card.subtitle;
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.label-small-size;
            height: 16px;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
