    public pure function block-kind(kind: string) -> string {
        kind == "header" ? (lang == "ru" ? "Заголовок" : "Heading")
        : kind == "list" ? (lang == "ru" ? "Список" : "List")
        : kind == "quote" ? (lang == "ru" ? "Цитата" : "Quote")
        : kind == "delimiter" ? (lang == "ru" ? "Разделитель" : "Divider")
        : kind == "paragraph" ? (lang == "ru" ? "Абзац" : "Paragraph")
        : (lang == "ru" ? "Вложение" : "Attachment")
    }
    public pure function post-error(key: string) -> string {
        key == "no-channel" ? (lang == "ru" ? "Выберите, куда писать." : "Choose where to post.")
        : key == "empty" ? (lang == "ru" ? "В записи нет текста." : "The post has no text.")
        : key == "no-blog" ? (lang == "ru" ? "Блог пока не завести: сервису мало репутации аккаунта." : "No blog yet: the service wants more reputation first.")
        : (lang == "ru" ? "Не получилось. Попробуйте ещё раз." : "That did not work. Try again.")
    }
