    /// The words for the outcome of a settings change Rust has named.
    public pure function settings-message(key: string) -> string {
        key == "saved" ? (lang == "ru" ? "Сохранено" : "Saved")
        : key == "avatar-saved" ? (lang == "ru" ? "Аватар обновлён" : "Picture updated")
        : key == "avatar-unreadable" ? (lang == "ru" ? "Этот файл не прочитать" : "That file could not be read")
        : key == "login-saved" ? (lang == "ru" ? "Логин изменён" : "Login changed")
        : key == "login-bad" ? (lang == "ru" ? "Такой логин не подойдёт" : "That login will not do")
        : key == "login-taken" ? (lang == "ru" ? "Логин занят" : "That login is taken")
        : key == "login-too-soon" ? (lang == "ru" ? "Логин менялся слишком недавно" : "The login was changed too recently")
        : key == "password-saved" ? (lang == "ru" ? "Пароль изменён" : "Password changed")
        : key == "password-bad" ? (lang == "ru" ? "Новый пароль слишком простой или короткий" : "The new password is too short or too simple")
        : key == "password-wrong" ? (lang == "ru" ? "Текущий пароль неверный" : "The current password is wrong")
        : key == "email-code-sent" ? (lang == "ru" ? "Код отправлен на новую почту" : "A code went to the new email")
        : key == "email-saved" ? (lang == "ru" ? "Почта изменена" : "Email changed")
        : key == "email-wrong-password" ? (lang == "ru" ? "Неверный пароль" : "Wrong password")
        : key == "email-wrong-current" ? (lang == "ru" ? "Текущая почта указана неверно" : "That is not the current email")
        : key == "email-bad" ? (lang == "ru" ? "Это не похоже на почту" : "That does not look like an email")
        : key == "email-taken" ? (lang == "ru" ? "На эту почту уже есть аккаунт" : "That email already has an account")
        : key == "wrong-code" ? (lang == "ru" ? "Неверный или устаревший код" : "Wrong or expired code")
        : key == "cannot-send" ? (lang == "ru" ? "Не получилось отправить письмо" : "The email could not be sent")
        : key == "appeal-sent" ? root.appeal-sent
        : key == "imported" ? (lang == "ru" ? "Закладки перенесены" : "Bookmarks imported")
        : key == "import-too-soon" ? (lang == "ru" ? "Импорт возможен раз в месяц — этот уже был" : "One import a month, and this month's is done")
        : key == "import-unreadable" ? (lang == "ru" ? "Это не выгрузка Shikimori" : "That is not a Shikimori export")
        : key == "exported" ? (lang == "ru" ? "Закладки выгружены" : "Bookmarks exported")
        : key == "export-unwritable" ? (lang == "ru" ? "Файл не записать" : "The file could not be written")
        : (lang == "ru" ? "Не получилось. Попробуйте ещё раз." : "That did not work. Try again.")
    }
    public pure function settings-message-is-error(key: string) -> bool {
        key != "saved" && key != "avatar-saved" && key != "login-saved"
            && key != "password-saved" && key != "email-code-sent" && key != "email-saved"
            && key != "imported" && key != "exported" && key != "appeal-sent"
    }

    /// The words for a refusal Rust has named.
    public pure function auth-error(key: string) -> string {
        key == "unknown-login" ? root.unknown-login
        : key == "wrong-password" ? root.wrong-password
        : key == "bad-login" ? (lang == "ru" ? "Такой логин не подойдёт" : "That login will not do")
        : key == "login-taken" ? (lang == "ru" ? "Логин занят" : "That login is taken")
        : key == "bad-email" ? (lang == "ru" ? "Это не похоже на почту" : "That does not look like an email")
        : key == "email-taken" ? (lang == "ru" ? "На эту почту уже есть аккаунт" : "That email already has an account")
        : key == "email-service" ? (lang == "ru" ? "Почту этого сервиса не принимают" : "That email service is not accepted")
        : key == "bad-password" ? (lang == "ru" ? "Пароль слишком простой или короткий" : "The password is too short or too simple")
        : key == "wrong-code" ? (lang == "ru" ? "Неверный код" : "Wrong code")
        : key == "code-expired" ? (lang == "ru" ? "Код устарел — отправьте новый" : "The code expired; send a new one")
        : key == "cannot-send" ? (lang == "ru" ? "Не получилось отправить письмо. Попробуйте позже." : "The email could not be sent. Try again later.")
        : key == "too-many" ? (lang == "ru" ? "Слишком много регистраций. Попробуйте позже." : "Too many sign-ups. Try again later.")
        : key == "not-found" ? (lang == "ru" ? "Такого аккаунта нет" : "No such account")
        : key == "start-over" ? (lang == "ru" ? "Что-то пошло не так. Начните сначала." : "Something went wrong. Start over.")
        : (lang == "ru" ? "Не получилось. Попробуйте позже." : "That did not work. Try again later.")
    }
}
