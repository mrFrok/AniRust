    out property <string> stats-hidden: lang == "ru" ? "Статистика скрыта настройками приватности." : "Statistics are hidden by privacy settings.";
    /// Minutes as days and hours, the way the official client words it:
    /// "~ 35 дней 3 часа".
    public pure function duration(minutes: int) -> string {
        root.lang == "ru"
            ? "~ " + floor(minutes / 1440) + " " + root.plural(floor(minutes / 1440), "день", "дня", "дней")
                + " " + floor(Math.mod(minutes, 1440) / 60) + " " + root.plural(floor(Math.mod(minutes, 1440) / 60), "час", "часа", "часов")
            : "~ " + floor(minutes / 1440) + (floor(minutes / 1440) == 1 ? " day " : " days ")
                + floor(Math.mod(minutes, 1440) / 60) + (floor(Math.mod(minutes, 1440) / 60) == 1 ? " hour" : " hours")
    }
