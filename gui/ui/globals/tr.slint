    out property <string> nk-collection-comments: lang == "ru" ? "К коллекциям" : "On collections";
    /// The line a notification opens with, by its kind.
    public pure function notification-headline(kind: string) -> string {
        kind == "episode" ? (root.lang == "ru" ? "Новая серия" : "New episode")
        : kind == "friend" ? (root.lang == "ru" ? "Друзья" : "Friends")
        : kind == "article" ? (root.lang == "ru" ? "Новая запись" : "New post")
        : kind == "reply" ? (root.lang == "ru" ? "Ответ на ваш комментарий" : "Reply to your comment")
        : kind == "related" ? (root.lang == "ru" ? "Вышел связанный релиз" : "A related release is out")
        : kind == "article-comment" ? (root.lang == "ru" ? "Комментарий к записи" : "Comment on a post")
        : kind == "collection-comment" ? (root.lang == "ru" ? "Комментарий к коллекции" : "Comment on a collection")
        : (root.lang == "ru" ? "Уведомление" : "Notification")
    }
    out property <string> ns-episodes: lang == "ru" ? "Новые серии" : "New episodes";
    out property <string> ns-first-episode: lang == "ru" ? "Только первая серия из озвучек" : "Only the first voice-over of an episode";
    out property <string> ns-comments: lang == "ru" ? "Ответы на комментарии" : "Replies to comments";
