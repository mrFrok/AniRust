        : "Nothing here yet. Subscribe to channels from the Latest tab.";
    out property <string> remove-from-history: lang == "ru" ? "Убрать из истории" : "Remove from history";
    out property <string> recently-watched: lang == "ru" ? "Просмотрено недавно" : "Watched recently";
    out property <string> nothing-watched: lang == "ru"
        ? "Пока ничего не просмотрено."
        : "Nothing watched yet.";

    /// Which episode, worded as each language words it.
    public pure function episode-of(number: int) -> string {
        root.lang == "ru" ? number + " серия" : "Episode " + number
    }

    /// How long ago, from a number of minutes.
    ///
    /// The counting words are here rather than in Rust because this is
    /// language, and Russian needs three forms of every one of them where
    /// English needs two. A number crosses the boundary; a sentence does not.
    public pure function ago(minutes: int) -> string {
        minutes < 1 ? (root.lang == "ru" ? "только что" : "just now")
        : minutes < 60 ? root.since(minutes, "минуту", "минуты", "минут", "minute")
        : minutes < 1440 ? root.since(floor(minutes / 60), "час", "часа", "часов", "hour")
        : root.since(floor(minutes / 1440), "день", "дня", "дней", "day")
    }

    /// "5 минут назад", "2 hours ago".
    pure function since(count: int, one: string, few: string, many: string, english: string) -> string {
        root.lang == "ru"
            ? count + " " + root.plural(count, one, few, many) + " назад"
            : count + " " + english + (count == 1 ? "" : "s") + " ago"
    }

    /// The form Russian puts after a number.
    pure function plural(count: int, one: string, few: string, many: string) -> string {
        Math.mod(count, 100) >= 11 && Math.mod(count, 100) <= 14 ? many
        : Math.mod(count, 10) == 1 ? one
        : Math.mod(count, 10) >= 2 && Math.mod(count, 10) <= 4 ? few
        : many
    }
    out property <string> votes: lang == "ru" ? "Оценки" : "Ratings";
    out property <string> comments: lang == "ru" ? "Комментарии" : "Comments";
    out property <string> collections: lang == "ru" ? "Коллекции" : "Collections";
    out property <string> friends: lang == "ru" ? "Друзья" : "Friends";
    out property <string> sign-in-to-profile: lang == "ru"
        ? "Войдите, чтобы видеть свои списки и синхронизировать прогресс."
        : "Sign in to see your lists and sync your progress.";

    out property <string> appearance: lang == "ru" ? "Оформление" : "Appearance";
    out property <string> appearance-why: lang == "ru"
        ? "AMOLED — это тёмная тема, в которой фон гаснет полностью: на OLED-экране такие пиксели не светятся вовсе."
        : "AMOLED is the dark theme with the background taken to black: on an OLED panel those pixels are switched off rather than lit.";
    out property <string> appearance-system: lang == "ru" ? "Как в системе" : "System";
    out property <string> appearance-light: lang == "ru" ? "Светлая" : "Light";
    out property <string> appearance-dark: lang == "ru" ? "Тёмная" : "Dark";
    out property <string> appearance-amoled: lang == "ru" ? "AMOLED" : "AMOLED";

    // ---- account ---------------------------------------------------------
    out property <string> sign-in: lang == "ru" ? "Войти" : "Sign in";
    out property <string> sign-out: lang == "ru" ? "Выйти" : "Sign out";
    out property <string> login-field: lang == "ru" ? "Логин или почта" : "Login or email";
    out property <string> password-field: lang == "ru" ? "Пароль" : "Password";
    out property <string> cancel: lang == "ru" ? "Отмена" : "Cancel";
    out property <string> sign-in-title: lang == "ru" ? "Вход в Anixart" : "Sign in to Anixart";
    out property <string> sign-in-why: lang == "ru"
        ? "Списки, история и прогресс просмотра синхронизируются с аккаунтом."
        : "Lists, history and watch progress sync with the account.";
    out property <string> unknown-login: lang == "ru" ? "Такого логина нет" : "No such login";
    out property <string> wrong-password: lang == "ru" ? "Неверный пароль" : "Wrong password";
    out property <string> sign-in-failed: lang == "ru"
        ? "Не удалось войти. Попробуйте позже."
        : "Could not sign in. Try again later.";
    out property <string> sign-up-title: lang == "ru" ? "Регистрация" : "Create an account";
    out property <string> restore-title: lang == "ru" ? "Восстановление пароля" : "Reset your password";
    out property <string> restore-why: lang == "ru"
        ? "Пришлём код на почту, к которой привязан аккаунт."
        : "A code goes to the email the account is tied to.";
    out property <string> code-sent: lang == "ru"
        ? "Мы отправили код на почту. Введите его здесь."
        : "A code is on its way to your email. Enter it here.";
    out property <string> new-login-field: lang == "ru" ? "Логин" : "Login";
    out property <string> email-field: lang == "ru" ? "Почта" : "Email";
    out property <string> code-field: lang == "ru" ? "Код из письма" : "Code from the email";
    out property <string> new-password-field: lang == "ru" ? "Новый пароль" : "New password";
    out property <string> create-account: lang == "ru" ? "Создать аккаунт" : "Create an account";
    out property <string> forgot-password: lang == "ru" ? "Забыли пароль?" : "Forgot password?";
    out property <string> have-account: lang == "ru" ? "Ко входу" : "Back to sign in";
    out property <string> resend-code: lang == "ru" ? "Отправить код ещё раз" : "Send the code again";
    out property <string> confirm: lang == "ru" ? "Подтвердить" : "Confirm";
    out property <string> continue: lang == "ru" ? "Продолжить" : "Continue";

    /// The words for a refusal Rust has named.
    public pure function auth-error(key: string) -> string {
        key == "unknown-login" ? root.unknown-login
        : key == "wrong-password" ? root.wrong-password
        : key == "bad-login" ? (lang == "ru" ? "Такой логин не подойдёт" : "That login will not do")
        : key == "login-taken" ? (lang == "ru" ? "Логин занят" : "That login is taken")
        : key == "bad-email" ? (lang == "ru" ? "Это не похоже на почту" : "That does not look like an email")
        : key == "email-taken" ? (lang == "ru" ? "На эту почту уже есть аккаунт" : "That email already has an account")
        : key == "email-service" ? (lang == "ru" ? "Почту этого сервиса не принимают" : "That email service is not accepted")
        : key == "bad-password" ? (lang == "ru" ? "Пароль слишком простой или короткий" : "The password is too short or too simple")
        : key == "wrong-code" ? (lang == "ru" ? "Неверный код" : "Wrong code")
        : key == "code-expired" ? (lang == "ru" ? "Код устарел — отправьте новый" : "The code expired; send a new one")
        : key == "cannot-send" ? (lang == "ru" ? "Не получилось отправить письмо. Попробуйте позже." : "The email could not be sent. Try again later.")
        : key == "too-many" ? (lang == "ru" ? "Слишком много регистраций. Попробуйте позже." : "Too many sign-ups. Try again later.")
        : key == "not-found" ? (lang == "ru" ? "Такого аккаунта нет" : "No such account")
        : key == "start-over" ? (lang == "ru" ? "Что-то пошло не так. Начните сначала." : "Something went wrong. Start over.")
        : (lang == "ru" ? "Не получилось. Попробуйте позже." : "That did not work. Try again later.")
    }
}
