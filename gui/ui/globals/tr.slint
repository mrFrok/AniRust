        : status == "accepted" ? (lang == "ru" ? "Апелляция принята" : "Appeal accepted")
        : status == "rejected" ? (lang == "ru" ? "Апелляция отклонена" : "Appeal rejected")
        : status == "revoked" ? (lang == "ru" ? "Отменено" : "Revoked")
        : ""
    }
