    public pure function replies-label(n: int, open: bool) -> string {
        open
            ? (root.lang == "ru" ? "Скрыть ответы" : "Hide replies")
            : (root.lang == "ru"
                ? n + " " + root.plural(n, "ответ", "ответа", "ответов")
                : n + (n == 1 ? " reply" : " replies"))
    }
