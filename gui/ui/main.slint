import { MaterialPalette, MaterialSchemes, NavigationRail } from "@material";
import { Scheme, Appearance } from "globals/scheme.slint";
import { Tr } from "globals/tr.slint";
import { PlayerPage } from "pages/player.slint";
import { ReleasePage } from "pages/release.slint";
import { HomePage } from "pages/home.slint";
import { SignInSheet } from "components/sign-in.slint";
import { DownloadsPage } from "pages/downloads.slint";
import { ProfilePage } from "pages/profile.slint";
import { FeedPage } from "pages/feed.slint";
import { PickerOption, EpisodeItem, ReleaseCard, DownloadItem, Account, HistoryItem, FeedPost } from "structs.slint";

export component MainWindow inherits Window {
    title: "AniRust";
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 400px;
    // Stated so the window's own size stops depending on what the release
    // screen asks for: the screen's layout reads the width it is given, and a
    // window sizing itself from that layout would be reading its own output.
    max-width: 100000px;
    max-height: 100000px;
    background: MaterialPalette.background;

    // Language, pushed from Rust and mirrored into the global so every string
    // on screen re-evaluates the moment it changes.
    in property <string> lang: "en";
    init => {
        Tr.lang = root.lang;
        Scheme.appearance = root.appearance;
        MaterialPalette.schemes = root.schemes;
        root.measure();
    }
    changed lang => { Tr.lang = root.lang; }

    // Which colour scheme is in force. Dark is the default: a room being used
    // to watch something is not a lit one.
    in property <Appearance> appearance: Appearance.dark;
    changed appearance => { Scheme.appearance = root.appearance; }

    // The scheme, mirrored here so it can be pushed.
    //
    // `MaterialPalette.schemes` is an `in` property belonging to a global,
    // which no binding may reach; a mirror with a `changed` handler is the way
    // to keep it level with the appearance as that changes underneath.
    property <MaterialSchemes> schemes: Scheme.schemes;
    changed schemes => { MaterialPalette.schemes = self.schemes; }

    // ---- release ---------------------------------------------------------
    in property <string> release-title;
    in property <string> release-original-title;
    in property <string> release-year;
    in property <string> release-genres;
    in property <string> release-studio;
    in property <string> release-status;
    in property <string> release-description;
    in property <string> release-score;
    in property <string> release-episodes-label;
    in property <image> release-poster;
    in property <bool> poster-loaded: false;
    in property <image> release-backdrop;
    in property <bool> backdrop-loaded: false;
    in property <bool> release-loading: true;
    in property <[PickerOption]> dubbers: [];
    in property <int> dubber: 0;
    in property <[PickerOption]> sources: [];
    in property <int> source: 0;
    in property <[EpisodeItem]> episodes: [];
    in property <bool> all-episodes-watched: false;
    in property <int> resume-episode: 0;
    /// The last attempt to start an episode failed.
    in property <bool> episode-failed: false;

    /// The account's view of the release on screen.
    in property <int> release-list: 0;
    in property <bool> release-favourite: false;
    in property <int> release-vote: 0;
    callback set-release-list(int);
    callback toggle-release-favourite();
    callback set-release-vote(int);
    callback toggle-watched(int);
    callback toggle-all-watched();

    callback select-dubber(int);
    callback select-source(int);
    callback play-episode(int);
    callback download-episode(int);
    callback go-back();

    // ---- player ----------------------------------------------------------
    in property <image> video-frame;
    in property <bool> has-video: false;
    /// Whether the player holds an episode at all — loading counts, since the
    /// picture area belongs to it from the moment the viewer asks for one.
    in property <bool> playing: false;
    in property <string> episode-label;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0.0;
    in property <float> buffered: 0.0;
    in property <bool> paused: false;
    in property <string> state: "idle";
    in property <string> quality-label: "—";
    in property <string> decoder-label: "HW";
    in property <string> speed-label: "1x";
    /// Index into the upscale presets: 0 off, 1 fast, 2 balanced, 3 quality.
    in property <int> upscale: 0;
    in property <bool> interpolation: false;
    in property <[string]> qualities: [];
    in property <int> quality: 0;
    in property <int> decoder: 0;
    in property <[string]> subtitle-tracks: [];
    in property <int> subtitle-track: 0;
    in property <[string]> audio-tracks: [];
    in property <int> audio-track: 0;
    in property <bool> fullscreen: false;
    in property <bool> has-skip: false;
    in property <bool> has-previous: false;
    in property <bool> has-next: false;
    /// A brief readout of what a key press just changed.
    in property <string> hint;
    /// The episode in the player, so the list can mark it and the transport can
    /// step to its neighbours.
    in-out property <int> current-episode: 0;
    /// Where that episode sits in the list, which the list scrolls to.
    in property <int> current-index: 0;
    /// The player fills the window, with the release stepped aside.
    in-out property <bool> theatre: false;
    /// Mirrored up from the player so the status timer can leave the seek bar
    /// alone while it is being dragged.
    out property <bool> scrubbing: player.scrubbing;

    callback toggle-pause();
    callback seek-fraction(float);
    callback seek-relative(float);
    callback skip-opening();
    callback previous-episode();
    callback next-episode();
    callback set-speed(float);
    callback set-upscale(int);
    callback set-quality(int);
    callback set-decoder(int);
    callback set-subtitle-track(int);
    callback set-audio-track(int);
    callback toggle-interpolation();
    callback toggle-fullscreen();
    callback toggle-muted();
    /// Loudness, by a step up or down.
    callback adjust-volume(int);
    /// Playback rate, by one notch along the speed menu.
    callback adjust-speed(int);
    /// One frame forward or back, which pauses as a side effect.
    callback step-frame(bool);
    /// Subtitles on or off, keeping whichever track was last chosen.
    callback toggle-captions();
    /// The player was closed. Playback stops: a stream decoding behind a screen
    /// nobody is looking at costs bandwidth for nothing.
    callback close-player();

    /// Below this the release screen stacks instead of splitting in two.
    ///
    /// Assigned on resize rather than bound to the width. A binding would make
    /// the window's own size depend on a layout that depends on the window's
    /// size; assigning it breaks that circle while giving the same answer.
    property <length> narrow-threshold: 900px;
    property <bool> narrow: false;
    changed width => { root.measure(); }
    function measure() { root.narrow = root.width < root.narrow-threshold; }

    /// Which screen is up: "home" or "release".
    ///
    /// The release screen stays instantiated while the browsing screen is up,
    /// because the player inside it owns the video texture and rebuilding that
    /// to change screens would throw away the stream.
    in-out property <string> screen: "home";

    // ---- browsing --------------------------------------------------------
    in property <[ReleaseCard]> results: [];
    /// Whether the grid is showing search results or the default list.
    in property <bool> searching: false;
    in property <bool> results-loading: false;
    in-out property <string> query;

    /// Which destination is open: 0 home, 1 browse, 2 saved, 3 feed,
    /// 4 profile, 5 downloads.
    ///
    /// The rail carries the first five, which are the five the client this one
    /// follows has, in its order. The queue is the sixth and is reached from
    /// the toolbar,
    /// because it is this client's own addition rather than one of theirs —
    /// and because it is somewhere you go when something is downloading, not
    /// somewhere you browse.
    ///
    /// Pushed onto the rail rather than bound to it: the rail writes its own
    /// `current-index` on a click, and a property written to keeps no binding.
    /// Rust moving the destination on its own still has to land on the rail.
    in-out property <int> destination: 0;
    changed destination => { rail.current-index = root.destination; }
    /// Which of the destination's tabs is selected.
    in property <int> tab: 0;
    in property <[string]> genres: [];
    in property <int> genre: 0;
    /// Shown instead of the grid when there is a reason it is empty.
    in property <string> notice;
    in property <[DownloadItem]> downloads: [];
    /// How many of them are still queued or running, which is what the
    /// toolbar's badge counts.
    in property <int> downloads-working: 0;

    // ---- feed ------------------------------------------------------------
    in property <[FeedPost]> posts: [];
    in property <bool> feed-loading: false;
    /// 0 the account's own feed, 1 the latest from everywhere.
    in property <int> feed-tab: 0;
    in property <string> feed-notice;
    callback select-feed-tab(int);
    callback toggle-subscription(int);

    callback clear-finished-downloads();

    callback search(string);
    callback open-release(int);
    callback select-destination(int);
    callback select-tab(int);
    callback select-genre(int);

    // ---- account ---------------------------------------------------------
    in property <bool> signed-in: false;
    in property <string> account-name;
    /// The rest of the account, which only the profile screen shows.
    in property <Account> account;
    in property <image> avatar;
    in property <bool> avatar-loaded: false;
    /// One of the account's own lists, by its place in the bookmarks tabs.
    callback open-list(int);
    /// What the account watched lately, and opening one of them.
    in property <[HistoryItem]> recent: [];
    callback open-recent(int);
    in-out property <bool> show-sign-in: false;
    in-out property <string> login;
    in-out property <string> password;
    in property <bool> sign-in-busy: false;
    /// Named by Rust: "", "unknown-login", "wrong-password" or "failed".
    in-out property <string> sign-in-error;

    callback submit-sign-in();
    callback sign-out();

    /// Which appearance is chosen, as a position in the row the profile
    /// screen offers. Rust owns that order, and writes it to the settings.
    in property <int> appearance-choice: 0;
    callback select-appearance(int);

    browsing := HorizontalLayout {
        width: 100%;
        height: 100%;
        visible: root.screen == "home";

        // The official client puts these five on a bar along the bottom, where
        // a thumb reaches them. A desktop window is wide rather than tall and
        // has no thumb, so the same five run down the left edge.
        rail := NavigationRail {
            alignment: start;
            items: [
                { icon: @image-url("icons/home.svg"), text: Tr.nav-home },
                { icon: @image-url("icons/compass.svg"), text: Tr.nav-catalogue },
                { icon: @image-url("icons/bookmark.svg"), text: Tr.nav-bookmarks },
                { icon: @image-url("icons/feed.svg"), text: Tr.nav-feed },
                { icon: @image-url("icons/person.svg"), text: Tr.nav-profile },
            ];

            init => { self.current-index = root.destination; }
            index-changed(i) => { root.select-destination(i); }
        }

        // Two destinations are not a grid of posters, so they are their own
        // pages beside the browsing one: the download queue, and the screen
        // about the application rather than about what to watch.
        if root.destination == 5: DownloadsPage {
            items: root.downloads;
            clear-finished => { root.clear-finished-downloads(); }
        }

        if root.destination == 3: FeedPage {
            posts: root.posts;
            loading: root.feed-loading;
            signed-in: root.signed-in;
            tab: root.feed-tab;
            notice: root.feed-notice;

            select-tab(i) => { root.select-feed-tab(i); }
            toggle-subscription(i) => { root.toggle-subscription(i); }
            sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
        }

        if root.destination == 4: ProfilePage {
            signed-in: root.signed-in;
            account: root.account;
            avatar: root.avatar;
            avatar-loaded: root.avatar-loaded;
            appearance: root.appearance-choice;
            recent: root.recent;

            sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
            sign-out => { root.sign-out(); }
            select-appearance(i) => { root.select-appearance(i); }
            open-list(i) => { root.open-list(i); }
            open-recent(i) => { root.open-recent(i); }
        }

        if root.destination < 3: HomePage {
            horizontal-stretch: 1;

            results: root.results;
            searching: root.searching;
            loading: root.results-loading;
            query <=> root.query;

            signed-in: root.signed-in;
            account-name: root.account-name;

            // What each destination is divided into. The names live here with
            // the rest of the translations; which one is selected, and what it
            // fetches, is Rust's business.
            tabs: root.destination == 0
                ? [{ text: Tr.tab-latest }, { text: Tr.tab-airing }, { text: Tr.tab-finished }]
                : root.destination == 1
                    ? [
                        { text: Tr.section-popular },
                        { text: Tr.section-top },
                        { text: Tr.section-films },
                        { text: Tr.section-announced },
                    ]
                    : root.destination == 2
                        ? [
                            { text: Tr.list-watching },
                            { text: Tr.list-planned },
                            { text: Tr.list-watched },
                            { text: Tr.list-hold },
                            { text: Tr.list-dropped },
                            { text: Tr.list-history },
                            { text: Tr.list-favourites },
                        ]
                        : [];
            tab: root.tab;
            genres: root.genres;
            genre: root.genre;
            notice: root.notice;
            downloads-working: root.downloads-working;

            search(q) => { root.search(q); }
            open-downloads => { root.select-destination(5); }
            open-release(i) => { root.open-release(i); }
            select-tab(i) => { root.select-tab(i); }
            select-genre(i) => { root.select-genre(i); }
            sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
            sign-out => { root.sign-out(); }
        }
    }

    release := ReleasePage {
        visible: root.screen == "release";
        width: 100%;
        height: 100%;
        narrow: root.narrow;

        title: root.release-title;
        original-title: root.release-original-title;
        year: root.release-year;
        genres: root.release-genres;
        studio: root.release-studio;
        status: root.release-status;
        description: root.release-description;
        score: root.release-score;
        episodes-label: root.release-episodes-label;
        poster: root.release-poster;
        poster-loaded: root.poster-loaded;
        backdrop: root.release-backdrop;
        backdrop-loaded: root.backdrop-loaded;
        loading: root.release-loading;
        dubbers: root.dubbers;
        dubber: root.dubber;
        sources: root.sources;
        source: root.source;
        episodes: root.episodes;
        all-watched: root.all-episodes-watched;
        resume-episode: root.resume-episode;
        failed: root.episode-failed;
        current-episode: root.current-episode;
        current-index: root.current-index;
        playing: root.playing;
        theatre: root.theatre;
        signed-in: root.signed-in;
        list: root.release-list;
        favourite: root.release-favourite;
        vote: root.release-vote;

        set-list(i) => { root.set-release-list(i); }
        toggle-favourite => { root.toggle-release-favourite(); }
        set-vote(n) => { root.set-release-vote(n); }
        toggle-watched(p) => { root.toggle-watched(p); }
        toggle-all-watched => { root.toggle-all-watched(); }
        sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
        select-dubber(i) => { root.select-dubber(i); }
        select-source(i) => { root.select-source(i); }
        play-episode(p) => { root.play-episode(p); }
        download-episode(p) => { root.download-episode(p); }
        go-back => { root.go-back(); }

        // The player is declared here and placed by the release screen, so the
        // one instance holding the video texture survives every layout change
        // around it.
        player := PlayerPage {
            visible: root.playing;

            video-frame: root.video-frame;
            has-video: root.has-video;
            title: root.release-title;
            episode-label: root.episode-label;
            position-text: root.position-text;
            duration-text: root.duration-text;
            progress: root.progress;
            buffered: root.buffered;
            paused: root.paused;
            state: root.state;
            quality-label: root.quality-label;
            decoder-label: root.decoder-label;
            speed-label: root.speed-label;
            upscale: root.upscale;
            interpolation: root.interpolation;
            qualities: root.qualities;
            quality: root.quality;
            decoder: root.decoder;
            subtitle-tracks: root.subtitle-tracks;
            subtitle-track: root.subtitle-track;
            audio-tracks: root.audio-tracks;
            audio-track: root.audio-track;
            fullscreen: root.fullscreen;
            theatre: root.theatre;
            has-skip: root.has-skip;
            has-previous: root.has-previous;
            has-next: root.has-next;
            hint: root.hint;

            toggle-pause => { root.toggle-pause(); }
            seek-fraction(f) => { root.seek-fraction(f); }
            seek-relative(d) => { root.seek-relative(d); }
            skip-opening => { root.skip-opening(); }
            previous-episode => { root.previous-episode(); }
            next-episode => { root.next-episode(); }
            set-speed(v) => { root.set-speed(v); }
            set-upscale(v) => { root.set-upscale(v); }
            set-quality(v) => { root.set-quality(v); }
            set-decoder(v) => { root.set-decoder(v); }
            set-subtitle-track(v) => { root.set-subtitle-track(v); }
            set-audio-track(v) => { root.set-audio-track(v); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
            toggle-interpolation => { root.toggle-interpolation(); }
            toggle-theatre => { root.theatre = !root.theatre; }
            close => { root.theatre = false; root.close-player(); }
        }
    }

    if root.show-sign-in: SignInSheet {
        width: 100%;
        height: 100%;
        login <=> root.login;
        password <=> root.password;
        busy: root.sign-in-busy;
        error: root.sign-in-error;

        submit => { root.submit-sign-in(); }
        dismiss => { root.show-sign-in = false; root.password = ""; }
    }

    forward-focus: keys;

    // The bindings a viewer already has in their fingers, from the player
    // everyone has used. Deviating from them would be a novelty nobody asked
    // for; the three that have no counterpart there — skipping an opening,
    // upscaling, interpolation — take letters YouTube leaves free.
    keys := FocusScope {
        key-pressed(event) => {
            if (root.show-sign-in || !root.playing) { return reject; }

            // ---- transport ----
            if (event.text == " " || event.text == "k") { root.toggle-pause(); return accept; }
            if (event.text == "j") { root.seek-relative(-10); return accept; }
            if (event.text == "l") { root.seek-relative(10); return accept; }
            if (event.text == Key.LeftArrow) { root.seek-relative(-5); return accept; }
            if (event.text == Key.RightArrow) { root.seek-relative(5); return accept; }
            if (event.text == Key.Home) { root.seek-fraction(0); return accept; }
            if (event.text == Key.End) { root.seek-fraction(1); return accept; }

            // Digits jump to tenths of the episode, as they do everywhere.
            if (event.text >= "0" && event.text <= "9") {
                root.seek-fraction(digit(event.text) / 10);
                return accept;
            }

            // ---- episodes ----
            if (event.text == "p" && event.modifiers.shift) { root.previous-episode(); return accept; }
            if (event.text == "n" && event.modifiers.shift) { root.next-episode(); return accept; }

            // ---- sound ----
            if (event.text == "m") { root.toggle-muted(); return accept; }
            if (event.text == Key.UpArrow) { root.adjust-volume(5); return accept; }
            if (event.text == Key.DownArrow) { root.adjust-volume(-5); return accept; }

            // ---- rate, and stepping while paused ----
            if (event.text == "<") { root.adjust-speed(-1); return accept; }
            if (event.text == ">") { root.adjust-speed(1); return accept; }
            if (event.text == ",") { root.step-frame(false); return accept; }
            if (event.text == ".") { root.step-frame(true); return accept; }

            // ---- the screen ----
            if (event.text == "f") { root.toggle-fullscreen(); return accept; }
            if (event.text == "t") { root.theatre = !root.theatre; return accept; }
            if (event.text == Key.Escape) {
                if (root.fullscreen) { root.toggle-fullscreen(); return accept; }
                if (root.theatre) { root.theatre = false; return accept; }
                return reject;
            }

            // ---- ours ----
            if (event.text == "c") { root.toggle-captions(); return accept; }
            if (event.text == "s") { root.skip-opening(); return accept; }
            if (event.text == "u") { root.set-upscale(Math.mod(root.upscale + 1, 4)); return accept; }
            if (event.text == "i") { root.toggle-interpolation(); return accept; }
            reject
        }
    }

    /// A digit's value. Slint has no string-to-number, and ten comparisons
    /// beat ten separate key clauses.
    pure function digit(text: string) -> int {
        text == "1" ? 1 : text == "2" ? 2 : text == "3" ? 3 : text == "4" ? 4
            : text == "5" ? 5 : text == "6" ? 6 : text == "7" ? 7 : text == "8" ? 8
            : text == "9" ? 9 : 0
    }
}
