// SPDX-License-Identifier: GPL-3.0-or-later

import { MaterialPalette, MaterialSchemes, NavigationRail } from "@material";
import { Scheme, Appearance } from "globals/scheme.slint";
import { Tr } from "globals/tr.slint";
import { PlayerPage } from "pages/player.slint";
import { ReleasePage } from "pages/release.slint";
import { HomePage } from "pages/home.slint";
import { SignInSheet } from "components/sign-in.slint";
import { DownloadsPage } from "pages/downloads.slint";
import { ProfilePage } from "pages/profile.slint";
import { FeedPage } from "pages/feed.slint";
import { CommentsSheet } from "components/comments.slint";
import { NotificationsSheet } from "components/notifications.slint";
import { CollectionEditor, CollectionPicker } from "components/collections.slint";
import { AccountSettingsSheet } from "components/account-settings.slint";
import { ReportSheet } from "components/report.slint";
import { DeletionSheet } from "components/deletion.slint";
import { PostEditor } from "components/post-editor.slint";
import { ChannelAdmin } from "components/channel-admin.slint";
import { ConfirmSheet } from "components/confirm.slint";
import { PickerOption, EpisodeItem, ReleaseCard, DownloadItem, Account, HistoryItem, FeedPost, LinkItem, CommentItem, NotificationItem, PersonItem, ChannelItem, CollectionItem, AccountSettings, VideoItem, EnforcementItem, DraftBlock, SuggestionItem } from "structs.slint";

export component MainWindow inherits Window {
    title: "AniRust";
    icon: @image-url("../../packaging/icons/anirust.svg");
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 400px;
    // Stated so the window's own size stops depending on what the release
    // screen asks for: the screen's layout reads the width it is given, and a
    // window sizing itself from that layout would be reading its own output.
    max-width: 100000px;
    max-height: 100000px;
    background: MaterialPalette.background;

    // Language, pushed from Rust and mirrored into the global so every string
    // on screen re-evaluates the moment it changes.
    in property <string> lang: "en";
    init => {
        Tr.lang = root.lang;
        Scheme.appearance = root.appearance;
        MaterialPalette.schemes = root.schemes;
        root.measure();
    }
    changed lang => { Tr.lang = root.lang; }

    // Which colour scheme is in force. Dark is the default: a room being used
    // to watch something is not a lit one.
    in property <Appearance> appearance: Appearance.dark;
    changed appearance => { Scheme.appearance = root.appearance; }

    // The scheme, mirrored here so it can be pushed.
    //
    // `MaterialPalette.schemes` is an `in` property belonging to a global,
    // which no binding may reach; a mirror with a `changed` handler is the way
    // to keep it level with the appearance as that changes underneath.
    property <MaterialSchemes> schemes: Scheme.schemes;
    changed schemes => { MaterialPalette.schemes = self.schemes; }

    // ---- release ---------------------------------------------------------
    in property <string> release-title;
    in property <string> release-original-title;
    in property <string> release-year;
    in property <string> release-genres;
    in property <string> release-studio;
    in property <string> release-status;
    in property <string> release-description;
    in property <string> release-score;
    in property <bool> release-rateable: true;
    in property <string> release-episodes-label;
    in property <image> release-poster;
    in property <bool> poster-loaded: false;
    in property <image> release-backdrop;
    in property <bool> backdrop-loaded: false;
    in property <bool> release-loading: true;
    in property <[PickerOption]> dubbers: [];
    in property <int> dubber: 0;
    in property <[PickerOption]> sources: [];
    in property <int> source: 0;
    in property <[EpisodeItem]> episodes: [];
    in property <bool> all-episodes-watched: false;
    in property <int> resume-episode: 0;
    /// The last attempt to start an episode failed.
    in property <bool> episode-failed: false;

    /// The account's view of the release on screen.
    in property <int> release-list: 0;
    in property <bool> release-favourite: false;
    in property <int> release-vote: 0;
    callback set-release-list(int);
    callback toggle-release-favourite();

    // ---- writing posts ---------------------------------------------------
    in-out property <bool> editor-open: false;
    in property <bool> editor-editing: false;
    in property <bool> editor-suggesting: false;
    in property <[PickerOption]> editor-channels: [];
    in property <int> editor-channel: 0;
    in property <[DraftBlock]> editor-blocks: [];
    in property <bool> editor-can-sign: false;
    in-out property <bool> editor-signed: false;
    in property <bool> editor-busy: false;
    in property <bool> editor-loading: false;
    in property <string> editor-error;
    in property <bool> feed-can-write: false;
    callback write-post();
    callback edit-post(int);
    callback pin-post(int);
    callback delete-post(int);
    callback editor-select-channel(int);
    callback editor-add-block(string);
    callback editor-set-text(int, string);
    callback editor-set-caption(int, string);
    callback editor-move-block(int, int);
    callback editor-remove-block(int);
    callback editor-publish();

    // ---- running channels ------------------------------------------------
    in-out property <bool> admin-open: false;
    in property <bool> admin-creating: false;
    in property <bool> admin-creator: false;
    in property <int> admin-tab: 0;
    in-out property <string> admin-title;
    in-out property <string> admin-description;
    in-out property <bool> admin-commenting: true;
    in-out property <bool> admin-suggestions: false;
    in property <[SuggestionItem]> admin-suggested: [];
    in property <[PersonItem]> admin-admins: [];
    in property <[PersonItem]> admin-blocked: [];
    in property <[PersonItem]> admin-found: [];
    in property <bool> admin-busy: false;
    in property <bool> admin-loading: false;
    in property <string> admin-message;
    callback manage-channel();
    callback create-channel();
    callback create-blog();
    callback admin-save();
    callback admin-change-avatar();
    callback admin-change-cover();
    callback admin-delete-cover();
    callback admin-select-tab(int);
    callback admin-publish(int, bool);
    callback admin-reject(int);
    callback admin-remove-admin(int);
    callback admin-unblock(int);
    callback admin-search(string);
    callback admin-make-admin(int);
    callback admin-block(int);

    // ---- reports ---------------------------------------------------------
    /// Reports something: "release", "profile", "channel", "collection"
    /// (each the one on screen), or "comment" and "post" at a row.
    callback report(string, int);
    in-out property <bool> report-open: false;
    in property <string> report-subject;
    in property <[string]> report-reasons: [];
    in property <bool> report-loading: false;
    in property <bool> report-busy: false;
    in property <string> report-outcome;
    callback send-report(int, string);

    // ---- account settings ------------------------------------------------
    in-out property <bool> settings-open: false;
    in property <AccountSettings> account-settings;
    in property <bool> settings-loading: false;
    in property <bool> settings-busy: false;
    in property <string> settings-message;
    in property <bool> email-code-pending: false;
    in property <[string]> settings-login-suggestions: [];
    callback open-settings();
    callback change-avatar();
    callback delete-avatar();
    callback save-status(string);
    callback set-privacy(int, int);
    callback toggle-incognito();
    callback save-socials(string, string, string, string, string);
    callback change-login(string);
    callback change-password(string, string);
    callback change-email(string, string, string);
    callback verify-email(string);
    callback resend-email();
    callback import-bookmarks();
    callback export-bookmarks();
    in property <string> standing;
    in property <[EnforcementItem]> enforcements: [];
    callback appeal(int, string);

    // ---- deleting the account --------------------------------------------
    in-out property <bool> deletion-open: false;
    in property <bool> deletion-loading: false;
    in property <bool> deletion-pending: false;
    in property <string> deletion-at;
    in property <bool> deletion-busy: false;
    in property <string> deletion-error;
    callback open-deletion();
    callback request-deletion(string);
    callback cancel-deletion();

    /// A further page of the grid is on its way.
    in property <bool> results-loading-more: false;
    /// The grid was scrolled near its end.
    callback load-more-results();

    // ---- search beyond releases -------------------------------------------
    in property <[PersonItem]> found-people: [];
    in property <[PersonItem]> found-channels: [];
    callback open-found-person(int);
    callback open-found-channel(int);

    // ---- collections -----------------------------------------------------
    in property <bool> collection-open: false;
    in property <CollectionItem> open-collection-item;
    callback close-collection();
    callback toggle-collection-favourite();
    callback open-collection-comments();
    callback open-collection-creator();
    /// Opens the editor on the open collection.
    callback edit-collection();
    /// Opens the editor on a new collection, holding the release on screen
    /// when one is (-1 otherwise).
    callback new-collection(int);
    in-out property <bool> collection-editor-open: false;
    in property <bool> collection-editing: false;
    in-out property <string> collection-draft-title;
    in-out property <string> collection-draft-description;
    in-out property <bool> collection-draft-private: false;
    in property <bool> collection-busy: false;
    in property <bool> collection-failed: false;
    callback save-collection();
    callback delete-collection();
    callback change-collection-cover();
    /// The sheet listing the account's collections, from a release.
    in-out property <bool> collection-picker-open: false;
    in property <[string]> my-collection-titles: [];
    in property <bool> my-collections-loading: false;
    callback add-to-collection();
    callback pick-collection(int);
    callback set-release-vote(int);
    in property <[LinkItem]> release-related: [];
    in property <[LinkItem]> release-platforms: [];
    callback open-related(int);
    callback open-platform(int);
    in property <[VideoItem]> release-videos: [];
    callback open-video(int);
    callback toggle-watched(int);
    callback toggle-all-watched();
    callback toggle-dubber-pin();

    callback select-dubber(int);
    callback select-source(int);
    callback play-episode(int);
    callback download-episode(int);
    callback go-back();

    // ---- player ----------------------------------------------------------
    in property <image> video-frame;
    in property <bool> has-video: false;
    /// Whether the player holds an episode at all — loading counts, since the
    /// picture area belongs to it from the moment the viewer asks for one.
    in property <bool> playing: false;
    in property <string> episode-label;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0.0;
    in property <float> buffered: 0.0;
    in property <bool> paused: false;
    in property <string> state: "idle";
    in property <string> quality-label: "—";
    in property <string> decoder-label: "HW";
    in property <string> speed-label: "1x";
    /// Index into the upscale presets: 0 off, 1 fast, 2 balanced, 3 quality.
    in property <int> upscale: 0;
    in property <bool> interpolation: false;
    in property <[string]> qualities: [];
    in property <int> quality: 0;
    in property <int> decoder: 0;
    in property <[string]> subtitle-tracks: [];
    in property <int> subtitle-track: 0;
    in property <[string]> audio-tracks: [];
    in property <int> audio-track: 0;
    in property <bool> fullscreen: false;
    in property <bool> has-skip: false;
    in property <bool> has-previous: false;
    in property <bool> has-next: false;
    /// A brief readout of what a key press just changed.
    in property <string> hint;
    /// The episode in the player, so the list can mark it and the transport can
    /// step to its neighbours.
    in-out property <int> current-episode: 0;
    /// Where that episode sits in the list, which the list scrolls to.
    in property <int> current-index: 0;
    /// The player fills the window, with the release stepped aside.
    in-out property <bool> theatre: false;
    /// Mirrored up from the player so the status timer can leave the seek bar
    /// alone while it is being dragged.
    out property <bool> scrubbing: player.scrubbing;

    callback toggle-pause();
    callback seek-fraction(float);
    callback seek-relative(float);
    callback skip-opening();
    callback previous-episode();
    callback next-episode();
    callback set-speed(float);
    callback set-upscale(int);
    callback set-quality(int);
    callback set-decoder(int);
    callback set-subtitle-track(int);
    callback set-audio-track(int);
    callback toggle-interpolation();
    callback toggle-fullscreen();
    callback toggle-muted();
    /// Loudness, by a step up or down.
    callback adjust-volume(int);
    /// Playback rate, by one notch along the speed menu.
    callback adjust-speed(int);
    /// One frame forward or back, which pauses as a side effect.
    callback step-frame(bool);
    /// Subtitles on or off, keeping whichever track was last chosen.
    callback toggle-captions();
    /// The player was closed. Playback stops: a stream decoding behind a screen
    /// nobody is looking at costs bandwidth for nothing.
    callback close-player();

    /// Below this the release screen stacks instead of splitting in two.
    ///
    /// Assigned on resize rather than bound to the width. A binding would make
    /// the window's own size depend on a layout that depends on the window's
    /// size; assigning it breaks that circle while giving the same answer.
    property <length> narrow-threshold: 900px;
    property <bool> narrow: false;
    changed width => { root.measure(); }
    function measure() { root.narrow = root.width < root.narrow-threshold; }

    /// Which screen is up: "home" or "release".
    ///
    /// The release screen stays instantiated while the browsing screen is up,
    /// because the player inside it owns the video texture and rebuilding that
    /// to change screens would throw away the stream.
    in-out property <string> screen: "home";

    // ---- browsing --------------------------------------------------------
    in property <[ReleaseCard]> results: [];
    /// Whether the grid is showing search results or the default list.
    in property <bool> searching: false;
    in property <bool> results-loading: false;
    in-out property <string> query;

    /// Which destination is open: 0 home, 1 browse, 2 saved, 3 feed,
    /// 4 profile, 5 downloads.
    ///
    /// The rail carries the first five, which are the five the client this one
    /// follows has, in its order. The queue is the sixth and is reached from
    /// the toolbar,
    /// because it is this client's own addition rather than one of theirs —
    /// and because it is somewhere you go when something is downloading, not
    /// somewhere you browse.
    ///
    /// Pushed onto the rail rather than bound to it: the rail writes its own
    /// `current-index` on a click, and a property written to keeps no binding.
    /// Rust moving the destination on its own still has to land on the rail.
    in-out property <int> destination: 0;
    changed destination => { rail.current-index = root.destination; }
    /// Which of the destination's tabs is selected.
    in property <int> tab: 0;
    in property <[string]> genres: [];
    in property <int> genre: 0;
    /// Whether the chip row is days of the week rather than genres.
    in property <bool> chips-are-days: false;
    callback open-random();
    /// Shown instead of the grid when there is a reason it is empty.
    in property <string> notice;
    in property <[DownloadItem]> downloads: [];
    /// How many of them are still queued or running, which is what the
    /// toolbar's badge counts.
    in property <int> downloads-working: 0;

    // ---- people ----------------------------------------------------------
    /// Whether the profile page shows the account's own profile.
    in property <bool> profile-is-mine: true;
    in property <[PersonItem]> profile-friends: [];
    in property <[PersonItem]> friend-requests: [];
    callback back-to-my-profile();
    callback friend-action();
    callback toggle-block();
    callback open-friend(int);
    callback open-request(int);
    callback answer-request(int, bool);
    callback open-comment-author(int);

    // ---- notifications ---------------------------------------------------
    in property <int> unseen: 0;
    in-out property <bool> notifications-open: false;
    in property <[NotificationItem]> notification-items: [];
    in property <bool> notifications-loading: false;
    in property <bool> notifications-has-more: false;
    in property <int> notification-kind: 0;
    in property <[bool]> notify-switches: [];
    callback open-notifications();
    callback close-notifications();
    callback select-notification-kind(int);
    callback load-more-notifications();
    callback mark-notifications-seen();
    callback clear-notifications();
    callback open-notification(int);
    callback delete-notification(int);
    callback flip-notify(int);

    // ---- comments --------------------------------------------------------
    /// The thread open in the sheet, if one is.
    in-out property <bool> comments-open: false;
    in property <string> comments-title;
    in property <[CommentItem]> comments: [];
    in property <int> comments-total: 0;
    in property <bool> comments-loading: false;
    in property <bool> comments-has-more: false;
    in property <int> comments-sort: 0;
    in property <string> comments-reply-to;
    in property <bool> comments-editing: false;
    in property <bool> comments-sending: false;
    in property <string> comments-error;
    in-out property <string> comment-draft;
    in-out property <bool> comment-draft-spoiler: false;
    /// The comment count of the release on screen, for the button that opens
    /// its thread.
    in property <int> release-comment-count: 0;

    callback open-release-comments();
    callback open-post-comments(int);
    callback close-comments();
    callback select-comments-sort(int);
    callback load-more-comments();
    callback send-comment();
    callback cancel-comment-reply();
    callback vote-comment(int, int);
    callback reply-to-comment(int);
    callback edit-comment(int);
    callback delete-comment(int);
    callback toggle-comment-replies(int);
    callback reveal-comment(int);

    // ---- feed ------------------------------------------------------------
    in property <[FeedPost]> posts: [];
    in property <bool> feed-loading: false;
    /// 0 the account's own feed, 1 the latest from everywhere.
    in property <int> feed-tab: 0;
    in property <string> feed-notice;
    callback select-feed-tab(int);
    callback toggle-subscription(int);
    callback toggle-like(int);
    in property <[ChannelItem]> feed-channels: [];
    in property <int> subscription-count: 0;
    in property <bool> channel-open: false;
    in property <ChannelItem> open-channel-item;
    callback open-post-channel(int);
    callback open-channel(int);
    callback close-channel();
    callback toggle-channel-subscription(int);
    callback toggle-channel-mute(int);

    callback clear-finished-downloads();

    callback search(string);
    callback open-release(int);
    callback select-destination(int);
    callback select-tab(int);
    callback select-genre(int);

    // ---- account ---------------------------------------------------------
    in property <bool> signed-in: false;
    in property <string> account-name;
    /// The rest of the account, which only the profile screen shows.
    in property <Account> account;
    in property <image> avatar;
    in property <bool> avatar-loaded: false;
    /// One of the account's own lists, by its place in the bookmarks tabs.
    callback open-list(int);
    /// What the account watched lately, and opening one of them.
    in property <[HistoryItem]> recent: [];
    callback open-recent(int);
    callback remove-recent(int);
    in-out property <bool> show-sign-in: false;
    in-out property <string> login;
    in-out property <string> password;
    in property <bool> sign-in-busy: false;
    /// Named by Rust; the sheet words it with `Tr.auth-error`.
    in-out property <string> sign-in-error;
    /// Which of the sheet's forms is up; see `SignInSheet.mode`.
    in-out property <string> sign-in-mode: "sign-in";
    in-out property <string> sign-up-email;
    in-out property <string> sign-in-code;
    in property <[string]> login-suggestions: [];

    /// Submits whichever form is up.
    callback submit-sign-in();
    callback resend-sign-in-code();
    callback sign-out();
    /// Signing out is asked about first.
    in-out property <bool> confirm-sign-out: false;
    in property <bool> remember-player: true;
    callback set-remember-player(bool);
    /// Someone's profile was opened from another screen.
    in property <bool> profile-can-go-back: false;
    callback profile-go-back();

    /// Which appearance is chosen, as a position in the row the profile
    /// screen offers. Rust owns that order, and writes it to the settings.
    in property <int> appearance-choice: 0;
    callback select-appearance(int);

    browsing := HorizontalLayout {
        width: 100%;
        height: 100%;
        visible: root.screen == "home";

        // The official client puts these five on a bar along the bottom, where
        // a thumb reaches them. A desktop window is wide rather than tall and
        // has no thumb, so the same five run down the left edge.
        rail := NavigationRail {
            alignment: start;
            items: [
                { icon: @image-url("icons/home.svg"), text: Tr.nav-home },
                { icon: @image-url("icons/compass.svg"), text: Tr.nav-catalogue },
                { icon: @image-url("icons/bookmark.svg"), text: Tr.nav-bookmarks },
                { icon: @image-url("icons/feed.svg"), text: Tr.nav-feed },
                { icon: @image-url("icons/person.svg"), text: Tr.nav-profile },
            ];

            init => { self.current-index = root.destination; }
            index-changed(i) => { root.select-destination(i); }
        }

        // Two destinations are not a grid of posters, so they are their own
        // pages beside the browsing one: the download queue, and the screen
        // about the application rather than about what to watch.
        if root.destination == 5: DownloadsPage {
            items: root.downloads;
            clear-finished => { root.clear-finished-downloads(); }
        }

        if root.destination == 3: FeedPage {
            posts: root.posts;
            loading: root.feed-loading;
            signed-in: root.signed-in;
            tab: root.feed-tab;
            notice: root.feed-notice;

            select-tab(i) => { root.select-feed-tab(i); }
            toggle-subscription(i) => { root.toggle-subscription(i); }
            open-comments(i) => { root.open-post-comments(i); }
            report-post(i) => { root.report("post", i); }
            edit-post(i) => { root.edit-post(i); }
            pin-post(i) => { root.pin-post(i); }
            delete-post(i) => { root.delete-post(i); }
            write-post => { root.write-post(); }
            manage-channel => { root.manage-channel(); }
            create-channel => { root.create-channel(); }
            create-blog => { root.create-blog(); }
            can-write: root.feed-can-write;
            report-channel => { root.report("channel", -1); }
            toggle-like(i) => { root.toggle-like(i); }
            channels: root.feed-channels;
            subscription-count: root.subscription-count;
            channel-open: root.channel-open;
            channel: root.open-channel-item;
            open-post-channel(i) => { root.open-post-channel(i); }
            open-channel(i) => { root.open-channel(i); }
            close-channel => { root.close-channel(); }
            toggle-channel-subscription(i) => { root.toggle-channel-subscription(i); }
            toggle-channel-mute(i) => { root.toggle-channel-mute(i); }
            sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
        }

        if root.destination == 4: ProfilePage {
            signed-in: root.signed-in;
            account: root.account;
            avatar: root.avatar;
            avatar-loaded: root.avatar-loaded;
            appearance: root.appearance-choice;
            recent: root.recent;

            sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
            sign-out => { root.confirm-sign-out = true; }
            open-settings => { root.open-settings(); }
            select-appearance(i) => { root.select-appearance(i); }
            remember-player: root.remember-player;
            set-remember-player(on) => { root.set-remember-player(on); }
            open-list(i) => { root.open-list(i); }
            open-recent(i) => { root.open-recent(i); }
            notify: root.notify-switches;
            mine: root.profile-is-mine;
            friends: root.profile-friends;
            requests: root.friend-requests;
            back-to-mine => { root.back-to-my-profile(); }
            can-go-back: root.profile-can-go-back;
            go-back => { root.profile-go-back(); }
            friend-action => { root.friend-action(); }
            toggle-block => { root.toggle-block(); }
            report => { root.report("profile", -1); }
            open-friend(i) => { root.open-friend(i); }
            open-request(i) => { root.open-request(i); }
            answer-request(i, yes) => { root.answer-request(i, yes); }
            flip-notify(i) => { root.flip-notify(i); }
            remove-recent(i) => { root.remove-recent(i); }
        }

        if root.destination < 3: HomePage {
            horizontal-stretch: 1;

            results: root.results;
            searching: root.searching;
            loading: root.results-loading;
            query <=> root.query;

            signed-in: root.signed-in;
            account-name: root.account-name;

            // What each destination is divided into. The names live here with
            // the rest of the translations; which one is selected, and what it
            // fetches, is Rust's business.
            tabs: root.destination == 0
                ? [
                    { text: Tr.tab-latest },
                    { text: Tr.tab-airing },
                    { text: Tr.tab-finished },
                    { text: Tr.tab-interesting },
                    { text: Tr.tab-recommended },
                    { text: Tr.tab-watching },
                    { text: Tr.tab-discussing },
                    { text: Tr.tab-schedule },
                ]
                : root.destination == 1
                    ? [
                        { text: Tr.section-popular },
                        { text: Tr.section-top },
                        { text: Tr.section-films },
                        { text: Tr.section-announced },
                        { text: Tr.tab-collections },
                    ]
                    : root.destination == 2
                        ? [
                            { text: Tr.list-watching },
                            { text: Tr.list-planned },
                            { text: Tr.list-watched },
                            { text: Tr.list-hold },
                            { text: Tr.list-dropped },
                            { text: Tr.list-history },
                            { text: Tr.list-favourites },
                            { text: Tr.my-collections },
                        ]
                        : [];
            tab: root.tab;
            genres: root.genres;
            genre: root.genre;
            chips-are-days: root.chips-are-days;
            open-random => { root.open-random(); }
            notice: root.notice;
            downloads-working: root.downloads-working;
            unseen: root.unseen;
            open-notifications => { root.open-notifications(); }
            collection-open: root.collection-open;
            collection: root.open-collection-item;
            can-create-collection: root.destination == 2 && root.tab == 7 && root.signed-in;
            close-collection => { root.close-collection(); }
            toggle-collection-favourite => { root.toggle-collection-favourite(); }
            open-collection-comments => { root.open-collection-comments(); }
            open-collection-creator => { root.open-collection-creator(); }
            edit-collection => { root.edit-collection(); }
            report-collection => { root.report("collection", -1); }
            new-collection => { root.new-collection(-1); }

            loading-more: root.results-loading-more;
            load-more => { root.load-more-results(); }
            found-people: root.found-people;
            found-channels: root.found-channels;
            open-found-person(i) => { root.open-found-person(i); }
            open-found-channel(i) => { root.open-found-channel(i); }

            search(q) => { root.search(q); }
            open-downloads => { root.select-destination(5); }
            open-release(i) => { root.open-release(i); }
            select-tab(i) => { root.select-tab(i); }
            select-genre(i) => { root.select-genre(i); }
            sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
            sign-out => { root.confirm-sign-out = true; }
            open-profile => { root.select-destination(4); }
        }
    }

    release := ReleasePage {
        visible: root.screen == "release";
        width: 100%;
        height: 100%;
        narrow: root.narrow;

        title: root.release-title;
        original-title: root.release-original-title;
        year: root.release-year;
        genres: root.release-genres;
        studio: root.release-studio;
        status: root.release-status;
        description: root.release-description;
        score: root.release-score;
        rateable: root.release-rateable;
        episodes-label: root.release-episodes-label;
        poster: root.release-poster;
        poster-loaded: root.poster-loaded;
        backdrop: root.release-backdrop;
        backdrop-loaded: root.backdrop-loaded;
        loading: root.release-loading;
        dubbers: root.dubbers;
        dubber: root.dubber;
        sources: root.sources;
        source: root.source;
        episodes: root.episodes;
        all-watched: root.all-episodes-watched;
        resume-episode: root.resume-episode;
        failed: root.episode-failed;
        current-episode: root.current-episode;
        current-index: root.current-index;
        playing: root.playing;
        theatre: root.theatre;
        signed-in: root.signed-in;
        list: root.release-list;
        favourite: root.release-favourite;
        vote: root.release-vote;

        set-list(i) => { root.set-release-list(i); }
        toggle-favourite => { root.toggle-release-favourite(); }
        add-to-collection => { root.add-to-collection(); }
        report => { root.report("release", -1); }
        set-vote(n) => { root.set-release-vote(n); }
        related: root.release-related;
        platforms: root.release-platforms;
        videos: root.release-videos;
        open-video(i) => { root.open-video(i); }
        open-related(i) => { root.open-related(i); }
        comment-count: root.release-comment-count;
        open-comments => { root.open-release-comments(); }
        open-platform(i) => { root.open-platform(i); }
        toggle-watched(p) => { root.toggle-watched(p); }
        toggle-all-watched => { root.toggle-all-watched(); }
        toggle-pin => { root.toggle-dubber-pin(); }
        sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
        select-dubber(i) => { root.select-dubber(i); }
        select-source(i) => { root.select-source(i); }
        play-episode(p) => { root.play-episode(p); }
        download-episode(p) => { root.download-episode(p); }
        go-back => { root.go-back(); }

        // The player is declared here and placed by the release screen, so the
        // one instance holding the video texture survives every layout change
        // around it.
        player := PlayerPage {
            visible: root.playing;

            video-frame: root.video-frame;
            has-video: root.has-video;
            title: root.release-title;
            episode-label: root.episode-label;
            position-text: root.position-text;
            duration-text: root.duration-text;
            progress: root.progress;
            buffered: root.buffered;
            paused: root.paused;
            state: root.state;
            quality-label: root.quality-label;
            decoder-label: root.decoder-label;
            speed-label: root.speed-label;
            upscale: root.upscale;
            interpolation: root.interpolation;
            qualities: root.qualities;
            quality: root.quality;
            decoder: root.decoder;
            subtitle-tracks: root.subtitle-tracks;
            subtitle-track: root.subtitle-track;
            audio-tracks: root.audio-tracks;
            audio-track: root.audio-track;
            fullscreen: root.fullscreen;
            theatre: root.theatre;
            has-skip: root.has-skip;
            has-previous: root.has-previous;
            has-next: root.has-next;
            hint: root.hint;

            toggle-pause => { root.toggle-pause(); }
            seek-fraction(f) => { root.seek-fraction(f); }
            seek-relative(d) => { root.seek-relative(d); }
            skip-opening => { root.skip-opening(); }
            previous-episode => { root.previous-episode(); }
            next-episode => { root.next-episode(); }
            set-speed(v) => { root.set-speed(v); }
            set-upscale(v) => { root.set-upscale(v); }
            set-quality(v) => { root.set-quality(v); }
            set-decoder(v) => { root.set-decoder(v); }
            set-subtitle-track(v) => { root.set-subtitle-track(v); }
            set-audio-track(v) => { root.set-audio-track(v); }
            toggle-fullscreen => { root.toggle-fullscreen(); }
            toggle-interpolation => { root.toggle-interpolation(); }
            toggle-theatre => { root.theatre = !root.theatre; }
            close => { root.theatre = false; root.close-player(); }
        }
    }

    if root.notifications-open: NotificationsSheet {
        width: 100%;
        height: 100%;
        items: root.notification-items;
        loading: root.notifications-loading;
        has-more: root.notifications-has-more;
        kind: root.notification-kind;
        close => { root.close-notifications(); }
        select-kind(i) => { root.select-notification-kind(i); }
        load-more => { root.load-more-notifications(); }
        mark-all-seen => { root.mark-notifications-seen(); }
        clear-all => { root.clear-notifications(); }
        open(i) => { root.open-notification(i); }
        delete(i) => { root.delete-notification(i); }
    }

    // Under the sign-in form, which the sheet itself can ask for.
    if root.comments-open: CommentsSheet {
        width: 100%;
        height: 100%;
        title: root.comments-title;
        comments: root.comments;
        total: root.comments-total;
        loading: root.comments-loading;
        has-more: root.comments-has-more;
        signed-in: root.signed-in;
        sort: root.comments-sort;
        reply-to: root.comments-reply-to;
        editing: root.comments-editing;
        sending: root.comments-sending;
        error: root.comments-error;
        draft <=> root.comment-draft;
        draft-spoiler <=> root.comment-draft-spoiler;

        close => { root.close-comments(); }
        select-sort(i) => { root.select-comments-sort(i); }
        load-more => { root.load-more-comments(); }
        send => { root.send-comment(); }
        cancel-reply => { root.cancel-comment-reply(); }
        vote(i, v) => { root.vote-comment(i, v); }
        reply(i) => { root.reply-to-comment(i); }
        edit(i) => { root.edit-comment(i); }
        delete(i) => { root.delete-comment(i); }
        report(i) => { root.report("comment", i); }
        toggle-replies(i) => { root.toggle-comment-replies(i); }
        reveal(i) => { root.reveal-comment(i); }
        open-author(i) => { root.open-comment-author(i); }
        sign-in => { root.sign-in-error = ""; root.show-sign-in = true; }
    }

    if root.editor-open: PostEditor {
        width: 100%;
        height: 100%;
        editing: root.editor-editing;
        suggesting: root.editor-suggesting;
        channels: root.editor-channels;
        channel: root.editor-channel;
        blocks: root.editor-blocks;
        can-sign: root.editor-can-sign;
        signed <=> root.editor-signed;
        busy: root.editor-busy;
        loading: root.editor-loading;
        error: root.editor-error;
        select-channel(i) => { root.editor-select-channel(i); }
        add-block(kind) => { root.editor-add-block(kind); }
        set-text(i, text) => { root.editor-set-text(i, text); }
        set-caption(i, text) => { root.editor-set-caption(i, text); }
        move-block(i, delta) => { root.editor-move-block(i, delta); }
        remove-block(i) => { root.editor-remove-block(i); }
        publish => { root.editor-publish(); }
        dismiss => { root.editor-open = false; }
    }

    if root.admin-open: ChannelAdmin {
        width: 100%;
        height: 100%;
        creating: root.admin-creating;
        creator: root.admin-creator;
        tab: root.admin-tab;
        title <=> root.admin-title;
        description <=> root.admin-description;
        commenting <=> root.admin-commenting;
        suggestions <=> root.admin-suggestions;
        suggested: root.admin-suggested;
        admins: root.admin-admins;
        blocked: root.admin-blocked;
        found: root.admin-found;
        busy: root.admin-busy;
        loading: root.admin-loading;
        message: root.admin-message;
        save => { root.admin-save(); }
        change-avatar => { root.admin-change-avatar(); }
        change-cover => { root.admin-change-cover(); }
        delete-cover => { root.admin-delete-cover(); }
        select-tab(i) => { root.admin-select-tab(i); }
        publish-suggestion(i, signed) => { root.admin-publish(i, signed); }
        reject-suggestion(i) => { root.admin-reject(i); }
        remove-admin(i) => { root.admin-remove-admin(i); }
        unblock(i) => { root.admin-unblock(i); }
        search-subscribers(q) => { root.admin-search(q); }
        make-admin(i) => { root.admin-make-admin(i); }
        block(i) => { root.admin-block(i); }
        dismiss => { root.admin-open = false; }
    }

    if root.report-open: ReportSheet {
        width: 100%;
        height: 100%;
        subject: root.report-subject;
        reasons: root.report-reasons;
        loading: root.report-loading;
        busy: root.report-busy;
        outcome: root.report-outcome;
        send(reason, message) => { root.send-report(reason, message); }
        dismiss => { root.report-open = false; }
    }

    if root.settings-open: AccountSettingsSheet {
        width: 100%;
        height: 100%;
        settings: root.account-settings;
        loading: root.settings-loading;
        busy: root.settings-busy;
        message: root.settings-message;
        email-code-pending: root.email-code-pending;
        login-suggestions: root.settings-login-suggestions;
        change-avatar => { root.change-avatar(); }
        delete-avatar => { root.delete-avatar(); }
        save-status(s) => { root.save-status(s); }
        set-privacy(what, value) => { root.set-privacy(what, value); }
        toggle-incognito => { root.toggle-incognito(); }
        save-socials(a, b, c, d, e) => { root.save-socials(a, b, c, d, e); }
        change-login(l) => { root.change-login(l); }
        change-password(a, b) => { root.change-password(a, b); }
        change-email(a, b, c) => { root.change-email(a, b, c); }
        verify-email(c) => { root.verify-email(c); }
        resend-email => { root.resend-email(); }
        import-bookmarks => { root.import-bookmarks(); }
        export-bookmarks => { root.export-bookmarks(); }
        standing: root.standing;
        enforcements: root.enforcements;
        appeal(i, text) => { root.appeal(i, text); }
        open-deletion => { root.open-deletion(); }
        dismiss => { root.settings-open = false; }
    }

    if root.deletion-open: DeletionSheet {
        width: 100%;
        height: 100%;
        login: root.account.login;
        loading: root.deletion-loading;
        pending: root.deletion-pending;
        delete-at: root.deletion-at;
        busy: root.deletion-busy;
        error: root.deletion-error;
        request(password) => { root.request-deletion(password); }
        cancel-request => { root.cancel-deletion(); }
        dismiss => { root.deletion-open = false; }
    }

    if root.collection-editor-open: CollectionEditor {
        width: 100%;
        height: 100%;
        title <=> root.collection-draft-title;
        description <=> root.collection-draft-description;
        private <=> root.collection-draft-private;
        editing: root.collection-editing;
        busy: root.collection-busy;
        failed: root.collection-failed;
        save => { root.save-collection(); }
        delete => { root.delete-collection(); }
        change-cover => { root.change-collection-cover(); }
        dismiss => { root.collection-editor-open = false; }
    }

    if root.collection-picker-open: CollectionPicker {
        width: 100%;
        height: 100%;
        collections: root.my-collection-titles;
        loading: root.my-collections-loading;
        failed: root.collection-failed;
        pick(i) => { root.pick-collection(i); }
        create => { root.collection-picker-open = false; root.new-collection(0); }
        dismiss => { root.collection-picker-open = false; }
    }

    if root.confirm-sign-out: ConfirmSheet {
        width: 100%;
        height: 100%;
        title: Tr.sign-out-question(root.account-name);
        text: Tr.sign-out-why;
        action: Tr.sign-out;
        confirm => {
            root.confirm-sign-out = false;
            root.sign-out();
        }
        dismiss => { root.confirm-sign-out = false; }
    }

    if root.show-sign-in: SignInSheet {
        width: 100%;
        height: 100%;
        mode <=> root.sign-in-mode;
        login <=> root.login;
        password <=> root.password;
        email <=> root.sign-up-email;
        code <=> root.sign-in-code;
        busy: root.sign-in-busy;
        error: root.sign-in-error;
        suggestions: root.login-suggestions;

        submit => { root.submit-sign-in(); }
        resend => { root.resend-sign-in-code(); }
        dismiss => {
            root.show-sign-in = false;
            root.password = "";
            root.sign-in-code = "";
            root.sign-in-mode = "sign-in";
            root.sign-in-error = "";
        }
    }

    forward-focus: keys;

    // The bindings a viewer already has in their fingers, from the player
    // everyone has used. Deviating from them would be a novelty nobody asked
    // for; the three that have no counterpart there — skipping an opening,
    // upscaling, interpolation — take letters YouTube leaves free.
    keys := FocusScope {
        key-pressed(event) => {
            if (root.notifications-open && event.text == Key.Escape) {
                root.close-notifications();
                return accept;
            }
            if (root.comments-open && event.text == Key.Escape) {
                root.close-comments();
                return accept;
            }
            if (root.show-sign-in || root.comments-open || root.notifications-open || root.collection-editor-open || root.collection-picker-open || root.settings-open || root.report-open || root.deletion-open || root.editor-open || root.admin-open || root.confirm-sign-out || !root.playing) { return reject; }

            // ---- transport ----
            if (event.text == " " || event.text == "k") { root.toggle-pause(); return accept; }
            if (event.text == "j") { root.seek-relative(-10); return accept; }
            if (event.text == "l") { root.seek-relative(10); return accept; }
            if (event.text == Key.LeftArrow) { root.seek-relative(-5); return accept; }
            if (event.text == Key.RightArrow) { root.seek-relative(5); return accept; }
            if (event.text == Key.Home) { root.seek-fraction(0); return accept; }
            if (event.text == Key.End) { root.seek-fraction(1); return accept; }

            // Digits jump to tenths of the episode, as they do everywhere.
            if (event.text >= "0" && event.text <= "9") {
                root.seek-fraction(digit(event.text) / 10);
                return accept;
            }

            // ---- episodes ----
            if (event.text == "p" && event.modifiers.shift) { root.previous-episode(); return accept; }
            if (event.text == "n" && event.modifiers.shift) { root.next-episode(); return accept; }

            // ---- sound ----
            if (event.text == "m") { root.toggle-muted(); return accept; }
            if (event.text == Key.UpArrow) { root.adjust-volume(5); return accept; }
            if (event.text == Key.DownArrow) { root.adjust-volume(-5); return accept; }

            // ---- rate, and stepping while paused ----
            if (event.text == "<") { root.adjust-speed(-1); return accept; }
            if (event.text == ">") { root.adjust-speed(1); return accept; }
            if (event.text == ",") { root.step-frame(false); return accept; }
            if (event.text == ".") { root.step-frame(true); return accept; }

            // ---- the screen ----
            if (event.text == "f") { root.toggle-fullscreen(); return accept; }
            if (event.text == "t") { root.theatre = !root.theatre; return accept; }
            if (event.text == Key.Escape) {
                if (root.fullscreen) { root.toggle-fullscreen(); return accept; }
                if (root.theatre) { root.theatre = false; return accept; }
                return reject;
            }

            // ---- ours ----
            if (event.text == "c") { root.toggle-captions(); return accept; }
            if (event.text == "s") { root.skip-opening(); return accept; }
            if (event.text == "u") { root.set-upscale(Math.mod(root.upscale + 1, 4)); return accept; }
            if (event.text == "i") { root.toggle-interpolation(); return accept; }
            reject
        }
    }

    /// A digit's value. Slint has no string-to-number, and ten comparisons
    /// beat ten separate key clauses.
    pure function digit(text: string) -> int {
        text == "1" ? 1 : text == "2" ? 2 : text == "3" ? 3 : text == "4" ? 4
            : text == "5" ? 5 : text == "6" ? 6 : text == "7" ? 7 : text == "8" ? 8
            : text == "9" ? 9 : 0
    }
}
