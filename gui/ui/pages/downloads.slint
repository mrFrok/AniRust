//
// What has been saved, and what is still coming.

import { ScrollView } from "std-widgets.slint";
import { MaterialPalette, LinearProgressIndicator, SegmentedButton, FilledButton } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { DownloadItem } from "../structs.slint";
import { Dropdown } from "../components/release-parts.slint";
import { QuietButton } from "../components/quiet-button.slint";

component QueueRow inherits Rectangle {
    in property <DownloadItem> item;
    callback play();
    callback enhance();
    callback stop();

    height: 72px;
    border-radius: Shape.medium;
    background: MaterialPalette.surface-container;
    property <string> status-label: root.item.status == "queued" ? Tr.dl-queued
        : root.item.status == "running"
            ? (root.item.enhancing ? Tr.enhance-running : Tr.dl-running)
        : root.item.status == "done" ? (root.item.enhancing ? Tr.dl-improved : Tr.dl-done)
        : root.item.status == "unchanged" ? Tr.enhance-unchanged
        : root.item.enhancing && root.item.detail == "" ? Tr.enhance-stopped
        : Tr.dl-failed;

    VerticalLayout {
        padding: Spacing.medium;
        spacing: Spacing.tight;

        HorizontalLayout {
            spacing: Spacing.small;

            Text {
                text: root.item.title;
                color: MaterialPalette.on-surface;
                font-size: Typography.body-large-size;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.item.can-enhance: QuietButton {
                text: Tr.enhance;
                clicked => { root.enhance(); }
            }

            if root.item.status == "done": FilledButton {
                icon: @image-url("../icons/play.svg");
                text: Tr.watch;
                clicked => { root.play(); }
            }

            if root.item.enhancing && (root.item.status == "running" || root.item.status == "queued"): QuietButton {
                text: Tr.enhance-stop;
                clicked => { root.stop(); }
            }
        }

        HorizontalLayout {
            spacing: Spacing.medium;

            Text {
                text: root.item.detail == "starting" && root.item.status == "running"
                    ? Tr.enhance-starting : root.status-label;
                color: root.item.status == "failed"
                    ? MaterialPalette.error : MaterialPalette.on-surface-variant;
                font-size: Typography.label-small-size;
                vertical-alignment: center;
            }

            if root.item.status == "running" && root.item.detail != "starting": VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                LinearProgressIndicator { progress: root.item.progress; }
            }

            if root.item.status != "running": Text {
                text: root.item.detail != "" ? root.item.detail : root.item.dubber;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-small-size;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}

export component DownloadsPage inherits Rectangle {
    in property <[DownloadItem]> items: [];
    /// What this machine can do to a saved episode.
    in property <bool> can-upscale;
    in property <bool> can-generate;
    in property <bool> working;
    in property <bool> playback-error;
    callback play(int);
    callback clear-finished();
    callback enhance(int, bool, int, int);
    in property <int> saved-profile: 2;
    property <int> profile: 2;
    callback stop-enhance(int);

    /// The row the choice is open for, or -1.
    property <int> picking: -1;
    property <bool> upscale: root.can-upscale;
    property <int> rate: root.can-generate ? 2 : 0;

    background: MaterialPalette.surface;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    VerticalLayout {
        padding: Spacing.base;
        spacing: Spacing.medium;

        HorizontalLayout {
            spacing: Spacing.small;

            Text {
                text: Tr.nav-downloads;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-large-size;
                font-weight: Typography.title-large-weight-em;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            if root.items.length > 0: VerticalLayout {
                alignment: center;

                QuietButton {
                    text: Tr.clear-finished;
                    enabled: !root.working;
                    clicked => { root.clear-finished(); }
                }
            }
        }

        if root.playback-error: Text {
            text: Tr.dl-playback-error;
            color: MaterialPalette.error;
            font-size: Typography.body-medium-size;
            wrap: word-wrap;
        }

        if root.items.length == 0: Text {
            text: Tr.no-downloads;
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.body-large-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if root.items.length > 0: ScrollView {
            vertical-stretch: 1;
            content-height: queue.preferred-height;

            queue := VerticalLayout {
                spacing: Spacing.small;
                alignment: start;

                for item[index] in root.items: QueueRow {
                    item: item;
                    play => { root.play(index); }
                    enhance => {
                        root.upscale = root.can-upscale;
                        root.rate = root.can-generate ? 2 : 0;
                        root.profile = root.saved-profile;
                        root.picking = index;
                    }
                    stop => { root.stop-enhance(index); }
                }
            }
        }
    }

    // What to do to it: two choices, the most this machine can do already
    // picked.
    if root.picking >= 0: Rectangle {
        background: #000000A6;

        TouchArea {
            clicked => { root.picking = -1; }
        }

        Rectangle {
            width: min(440px, parent.width - 2 * Spacing.comfortable);
            height: min(form.preferred-height, parent.height - 2 * Spacing.base);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Shape.extra-large;
            background: MaterialPalette.surface-container-high;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000080;

            TouchArea {}

            ScrollView {
                content-height: form.preferred-height;
                form := VerticalLayout {
                    padding: Spacing.comfortable;
                    spacing: Spacing.base;
                    alignment: start;

                    Text {
                        text: Tr.enhance-title;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.title-large-size;
                        font-weight: Typography.title-large-weight-em;
                    }

                    Text {
                        text: Tr.enhance-why;
                        color: MaterialPalette.on-surface-variant;
                        font-size: Typography.body-medium-size;
                        wrap: word-wrap;
                    }

                VerticalLayout {
                    spacing: Spacing.small;

                    Text {
                        text: Tr.processing-profile;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.title-small-size;
                        font-weight: Typography.title-small-weight-em;
                    }

                    for name[index] in [Tr.economy, Tr.balanced, Tr.quality-high, Tr.quality-max]: Rectangle {
                        height: 52px;
                        border-radius: Shape.medium;
                        border-width: root.profile == index ? 1px : 0px;
                        border-color: root.profile == index ? MaterialPalette.primary : transparent;
                        background: root.profile == index
                            ? MaterialPalette.secondary-container
                            : MaterialPalette.surface-container;

                        HorizontalLayout {
                            padding-left: Spacing.medium;
                            padding-right: Spacing.medium;
                            spacing: Spacing.base;

                            Text {
                                text: name;
                                color: MaterialPalette.on-surface;
                                font-size: Typography.body-medium-size;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: index == 0 ? Tr.profile-economy
                                    : index == 1 ? Tr.profile-balanced
                                    : index == 2 ? Tr.profile-high
                                    : Tr.profile-maximum;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-small-size;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.profile = index; }
                        }
                    }
                }

                    if root.can-upscale: VerticalLayout {
                        spacing: Spacing.small;

                        Text {
                            text: Tr.sharpness;
                            color: MaterialPalette.on-surface;
                            font-size: Typography.title-small-size;
                            font-weight: Typography.title-small-weight-em;
                        }

                        HorizontalLayout {
                            alignment: start;

                            SegmentedButton {
                                items: [{ text: Tr.enhance-as-is }, { text: Tr.enhance-double-size }];
                                init => { self.current-index = root.upscale ? 1 : 0; }
                                index-changed(i) => { root.upscale = i == 1; }
                            }
                        }
                    }

                    if root.can-generate: VerticalLayout {
                        spacing: Spacing.small;

                        Text {
                            text: Tr.smoothness;
                            color: MaterialPalette.on-surface;
                            font-size: Typography.title-small-size;
                            font-weight: Typography.title-small-weight-em;
                        }

                        Dropdown {
                            model: [{ label: Tr.enhance-as-is }, { label: "×2" }, { label: "60 FPS" },
                                { label: "120 FPS" }, { label: Tr.frame-rate-display }];
                            current: root.rate;
                            selected(i) => { root.rate = i; }
                        }
                    }

                    HorizontalLayout {
                        spacing: Spacing.small;
                        alignment: end;

                        QuietButton {
                            text: Tr.cancel;
                            clicked => { root.picking = -1; }
                        }

                        FilledButton {
                            text: Tr.enhance-start;
                            enabled: root.upscale || root.rate > 0;
                            clicked => {
                                root.enhance(root.picking, root.upscale, root.rate, root.profile);
                                root.picking = -1;
                            }
                        }
                    }
                }
            }
        }
    }
}
