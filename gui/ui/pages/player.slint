// SPDX-License-Identifier: GPL-3.0-or-later
//
// The player screen.
//
// Laid out after the official Anixart player, which is the interface this
// audience already has in their hands. Three clusters of chrome float over the
// picture — a top bar, a centre transport, and a bottom row — and settings
// open as sheets rather than crowding the overlay. Everything sits flat on the
// video; the gradients at the edges carry legibility so the controls do not
// need panels of their own.

import { MaterialPalette } from "../globals/material-palette.slint";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing, Motion } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { IconButton, TextIndicator, SeekBar, SettingChip, SettingOption } from "../components/player-controls.slint";

export component PlayerPage inherits Rectangle {
    // ---- from Rust -------------------------------------------------------
    in property <image> video-frame;
    in property <bool> has-video: false;
    in property <string> title;
    in property <string> episode-label;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0.0;
    in property <float> buffered: 0.0;
    in property <bool> paused: false;
    /// One of: idle, loading, buffering, playing, paused, ended.
    in property <string> state: "idle";
    in property <string> quality-label: "—";
    in property <string> decoder-label: "HW";
    in property <string> speed-label: "1x";
    /// Index into the upscale presets: 0 off, 1 fast, 2 balanced, 3 quality.
    in property <int> upscale: 0;
    in property <bool> interpolation: false;
    in property <bool> has-skip: false;
    /// Whether the source has an episode either side of this one, so the
    /// transport can say when it is at an end rather than doing nothing.
    in property <bool> has-previous: false;
    in property <bool> has-next: false;
    /// A line about what just changed — volume, rate, muting. Shown briefly and
    /// then dropped: a key that alters something invisible has to say so, and a
    /// label that stays would be clutter.
    in property <string> hint;
    /// Available renditions, highest first, as "1080p" and the like.
    in property <[string]> qualities: [];
    in property <int> quality: 0;
    /// 0 automatic, 1 hardware, 2 software.
    in property <int> decoder: 0;
    /// Subtitle tracks the file carries, with "off" already first in the list.
    in property <[string]> subtitle-tracks: [];
    in property <int> subtitle-track: 0;
    /// Audio tracks. A file with one is not a choice, so the section hides.
    in property <[string]> audio-tracks: [];
    in property <int> audio-track: 0;
    in property <bool> fullscreen: false;
    /// Filling the window, with the release screen stepped aside.
    in property <bool> theatre: false;

    out property <bool> scrubbing: false;

    // ---- to Rust ---------------------------------------------------------
    callback toggle-pause();
    callback seek-fraction(float);
    callback seek-relative(float);
    callback skip-opening();
    callback previous-episode();
    callback next-episode();
    callback set-speed(float);
    callback set-upscale(int);
    callback set-quality(int);
    callback set-decoder(int);
    callback set-subtitle-track(int);
    callback set-audio-track(int);
    callback toggle-interpolation();
    callback toggle-fullscreen();
    /// Fill the window, or give the release screen its place back.
    callback toggle-theatre();
    /// Put the picture away entirely and stop playing.
    callback close();

    background: #000000;

    // The overlay floats over the picture and never dictates how large the
    // picture should be, so the page's constraints are stated rather than
    // derived from the chrome inside it. Leaving them to the children lets the
    // controls push back on the layout that positions them.
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    property <bool> chrome-visible: true;
    property <bool> waiting: root.state == "loading" || root.state == "buffering";
    /// Which sheet is open: "", "speed", "upscale".
    property <string> sheet: "";
    /// Locked hides every control but the lock itself, so a stray touch
    /// cannot pause or seek. The reference has this because a phone lives in
    /// a pocket; on a desktop it is just as useful against a cat.
    property <bool> locked: false;
    /// Chrome stays put while a sheet is up, or the sheet would be orphaned.
    property <bool> chrome-pinned: root.sheet != "" || root.state != "playing";
    /// Anime4K counts as working only once something is actually applied.
    property <bool> enhancing: root.upscale != 0 || root.interpolation;

    video := Image {
        source: root.video-frame;
        // Letterbox rather than crop: cutting frames off a video is never a
        // friendly default.
        image-fit: contain;
        width: 100%;
        height: 100%;
        visible: root.has-video;
    }

    Text {
        text: root.state == "loading" ? Tr.loading
            : root.state == "buffering" ? Tr.buffering
            : root.state == "ended" ? Tr.ended
            : Tr.idle;
        color: #FFFFFFB3;
        font-size: Typography.body-large-size;
        visible: !root.has-video || root.waiting;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    // The chrome hides itself once the picture is running, whether or not the
    // pointer ever moved over it. Waiting for a `moved` meant that someone who
    // pressed play and then sat still kept the controls on screen for the whole
    // episode.
    changed state => { root.wake(); }
    changed paused => { root.wake(); }

    function wake() {
        if (root.locked) { return; }
        root.chrome-visible = true;
        linger.running = false;
        linger.running = true;
    }

    // Hidden on a timer rather than by whoever wrote the hint: several keys
    // write here, and none of them should have to remember to tidy up. Rust
    // appends a counter to the text so that pressing the same key twice is a
    // change and starts the timer again.
    property <bool> hint-showing: false;
    changed hint => {
        root.hint-showing = root.hint != "";
        hint-linger.running = false;
        hint-linger.running = root.hint-showing;
    }

    hint-linger := Timer {
        interval: 1200ms;
        running: false;
        triggered => { root.hint-showing = false; self.running = false; }
    }

    hint-box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height / 5;
        width: hint-text.preferred-width + 2 * Spacing.comfortable;
        height: 48px;
        border-radius: Shape.medium;
        background: #000000B3;
        opacity: root.hint-showing ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: Motion.standard-duration; easing: Motion.standard; }

        hint-text := Text {
            text: root.hint;
            color: #FFFFFF;
            font-size: Typography.title-medium-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    // Woken by the pointer's position rather than by `moved`, which Slint only
    // reports while a button is held: with the chrome hiding itself properly,
    // that left no way to bring it back short of clicking, and clicking pauses.
    changed mouse-at => { root.wake(); }
    property <length> mouse-at: hover.mouse-x + hover.mouse-y;

    hover := TouchArea {
        mouse-cursor: root.chrome-visible ? MouseCursor.default : MouseCursor.none;
        clicked => {
            // A click inside a sheet must not also toggle playback, and a
            // locked overlay must not react at all.
            if (root.locked) { return; }
            if (root.sheet != "") { root.sheet = ""; } else { root.toggle-pause(); }
        }
    }

    linger := Timer {
        interval: Motion.overlay-linger;
        running: false;
        triggered => {
            if (root.chrome-pinned) {
                // Something is still holding the chrome up — a sheet, or a
                // picture that is not running. Come back and ask again rather
                // than leaving it visible for ever.
                return;
            }
            root.chrome-visible = false;
            self.running = false;
        }
    }

    // ---- top bar ---------------------------------------------------------
    Rectangle {
        y: 0;
        height: 84px;
        width: 100%;
        background: @linear-gradient(180deg, #000000B3 0%, #00000000 100%);
        opacity: root.chrome-visible && !root.locked ? 1.0 : 0.0;
        // Opacity alone leaves a bar in the hit-test tree, so an invisible
        // one still swallows clicks. Locking has to remove it outright.
        visible: root.chrome-visible && !root.locked;
        animate opacity { duration: Motion.enter-duration; easing: Motion.enter; }

        // One row, one height, everything centred on the same axis. Sizing
        // each control independently put the back button, the title and the
        // indicators on three different centre lines.
        HorizontalLayout {
            y: Spacing.small;
            height: Spacing.touch-target;
            padding-left: Spacing.small;
            padding-right: Spacing.small;
            spacing: Spacing.hair;
            alignment: stretch;

            IconButton {
                icon: root.theatre
                    ? @image-url("../icons/back.svg")
                    : @image-url("../icons/close.svg");
                clicked => {
                    if (root.theatre) { root.toggle-theatre(); } else { root.close(); }
                }
            }

            // The two title lines are a block of their own, centred against
            // the icons rather than stretched to the row's full height.
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                VerticalLayout {
                    y: (parent.height - self.preferred-height) / 2;
                    width: 100%;
                    spacing: 1px;

                    if root.theatre: Text {
                        text: root.title;
                        color: #FFFFFF;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: Spacing.tight;
                        alignment: start;
                        visible: root.episode-label != "";

                        Text {
                            // The word belongs to the translations; the number
                            // and voice-over come from Rust.
                            text: Tr.episode + " " + root.episode-label;
                            color: #FFFFFFA6;
                            font-size: Typography.label-medium-size;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Image {
                            source: @image-url("../icons/chevron.svg");
                            colorize: #FFFFFFA6;
                            width: 12px;
                            height: 12px;
                            y: 1px;
                        }
                    }
                }
            }

            TextIndicator {
                text: root.quality-label;
            }

            TextIndicator {
                text: root.decoder-label;
            }

            // Green while enhancement is actually in effect: the indicator
            // answers "is this doing anything right now", which a dimmed
            // white glyph does not.
            IconButton {
                icon: @image-url("../icons/sparkle.svg");
                tint: root.enhancing ? #6BD97F : #FFFFFF;
                dimmed: !root.enhancing;
                clicked => { root.sheet = root.sheet == "anime4k" ? "" : "anime4k"; }
            }

            IconButton {
                icon: @image-url("../icons/settings.svg");
                clicked => { root.sheet = root.sheet == "settings" ? "" : "settings"; }
            }
        }
    }

    // ---- centre transport ------------------------------------------------
    HorizontalLayout {
        y: (parent.height - self.height) / 2;
        height: 72px;
        width: 100%;
        alignment: center;
        spacing: Spacing.loose;
        opacity: root.chrome-visible && !root.locked ? 1.0 : 0.0;
        visible: root.sheet == "" && !root.locked && root.has-video;
        animate opacity { duration: Motion.enter-duration; easing: Motion.enter; }

        // One box size across the row, so the glyphs share a centre line
        // however differently sized they are.
        IconButton {
            icon: @image-url("../icons/prev-episode.svg");
            size: 30px;
            box: 72px;
            dimmed: !root.has-previous;
            clicked => { if (root.has-previous) { root.previous-episode(); } }
        }

        IconButton {
            icon: root.paused
                ? @image-url("../icons/play.svg")
                : @image-url("../icons/pause.svg");
            size: 52px;
            box: 72px;
            clicked => { root.toggle-pause(); }
        }

        IconButton {
            icon: @image-url("../icons/next-episode.svg");
            size: 30px;
            box: 72px;
            dimmed: !root.has-next;
            clicked => { if (root.has-next) { root.next-episode(); } }
        }
    }

    // ---- bottom chrome ---------------------------------------------------
    Rectangle {
        y: parent.height - self.height;
        height: 132px;
        width: 100%;
        background: @linear-gradient(0deg, #000000CC 0%, #00000000 100%);
        opacity: root.chrome-visible && !root.locked ? 1.0 : 0.0;
        visible: root.chrome-visible && !root.locked;
        animate opacity { duration: Motion.enter-duration; easing: Motion.enter; }

        VerticalLayout {
            padding-left: Spacing.small;
            padding-right: Spacing.small;
            padding-bottom: Spacing.small;
            alignment: end;
            spacing: Spacing.tight;

            // Secondary controls, split to the edges the way the reference
            // does: the middle stays clear of the picture.
            HorizontalLayout {
                spacing: Spacing.tight;

                IconButton {
                    icon: @image-url("../icons/lock.svg");
                    size: 22px;
                    clicked => { root.locked = true; }
                }

                IconButton {
                    icon: @image-url("../icons/speed.svg");
                    size: 22px;
                    clicked => { root.sheet = root.sheet == "speed" ? "" : "speed"; }
                }

                Rectangle { horizontal-stretch: 1; }

                // One button, not two: a separate "skip opening" label beside
                // a fast-forward that jumped the same distance was the same
                // action twice.
                IconButton {
                    icon: @image-url("../icons/fast-forward.svg");
                    size: 22px;
                    clicked => { root.skip-opening(); }
                }

                // Taller or shorter, which is a different request from
                // filling the screen — so a different glyph from the corner
                // brackets beside it.
                IconButton {
                    icon: root.theatre
                        ? @image-url("../icons/collapse.svg")
                        : @image-url("../icons/expand.svg");
                    size: 22px;
                    clicked => { root.toggle-theatre(); }
                }

                IconButton {
                    icon: root.fullscreen
                        ? @image-url("../icons/fullscreen-exit.svg")
                        : @image-url("../icons/fullscreen.svg");
                    size: 22px;
                    clicked => { root.toggle-fullscreen(); }
                }
            }

            // Time flanks the bar, as in the reference: both ends are read at
            // a glance without the eye leaving the row.
            HorizontalLayout {
                spacing: Spacing.medium;
                padding-left: Spacing.small;
                padding-right: Spacing.small;

                Text {
                    text: root.position-text;
                    color: #FFFFFF;
                    font-size: Typography.body-medium-size;
                    vertical-alignment: center;
                    min-width: 52px;
                }

                SeekBar {
                    horizontal-stretch: 1;
                    position: root.progress;
                    buffered: root.buffered;
                    seek(fraction) => { root.seek-fraction(fraction); }
                    scrubbing(active) => { root.scrubbing = active; }
                }

                Text {
                    text: root.duration-text;
                    color: #FFFFFF;
                    font-size: Typography.body-medium-size;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 52px;
                }
            }
        }
    }

    // The one control that survives the lock, so it can be undone. Declared
    // after the video's touch area so it receives the click first.
    if root.locked: Rectangle {
        x: Spacing.base;
        y: parent.height - self.height - Spacing.comfortable;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: #000000A6;

        Image {
            source: @image-url("../icons/lock.svg");
            colorize: #FFFFFF;
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.locked = false;
                // Come back with the chrome showing and the hide countdown
                // restarted; otherwise the overlay returns to whatever state
                // it happened to be in when the lock went on.
                root.chrome-visible = true;
                linger.running = false;
                linger.running = true;
            }
        }
    }

    Text {
        text: Tr.lock-hint;
        color: #FFFFFF8C;
        font-size: Typography.label-medium-size;
        visible: root.locked;
        horizontal-alignment: center;
        y: parent.height - 40px;
        width: 100%;
    }

    // ---- sheets ----------------------------------------------------------
    //
    // Anchored to the bottom with a large top radius, matching the reference.
    // Settings that need explaining get room to explain themselves, which an
    // inline chip never has.
    if root.sheet != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000073;

        TouchArea {
            clicked => { root.sheet = ""; }
        }

        sheet := Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: sheet-body.preferred-height + Spacing.loose;
            background: MaterialPalette.surface-container;
            border-top-left-radius: Shape.extra-large;
            border-top-right-radius: Shape.extra-large;

            // Swallow clicks so they do not reach the scrim behind.
            TouchArea {}

            sheet-body := VerticalLayout {
                padding: Spacing.comfortable;
                spacing: Spacing.base;

                HorizontalLayout {
                    Text {
                        text: root.sheet == "anime4k" ? "Anime4K"
                            : root.sheet == "settings" ? Tr.settings
                            : Tr.speed;
                        color: #FFFFFF;
                        font-size: Typography.headline-small-size;
                        horizontal-stretch: 1;
                    }

                    IconButton {
                        icon: @image-url("../icons/close.svg");
                        size: 20px;
                        clicked => { root.sheet = ""; }
                    }
                }

                if root.sheet == "anime4k": VerticalLayout {
                    spacing: Spacing.medium;

                    Text {
                        text: Tr.upscale-hint;
                        color: #FFFFFF8C;
                        font-size: Typography.body-medium-size;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Spacing.small;
                        alignment: start;

                        SettingChip {
                            label: Tr.off;
                            selected: root.upscale == 0;
                            clicked => { root.set-upscale(0); }
                        }

                        SettingChip {
                            label: Tr.preset-fast;
                            selected: root.upscale == 1;
                            clicked => { root.set-upscale(1); }
                        }

                        SettingChip {
                            label: Tr.preset-balanced;
                            recommended: true;
                            selected: root.upscale == 2;
                            clicked => { root.set-upscale(2); }
                        }

                        SettingChip {
                            label: Tr.preset-quality;
                            heavy: true;
                            selected: root.upscale == 3;
                            clicked => { root.set-upscale(3); }
                        }
                    }

                    SettingOption {
                        label: Tr.interpolation;
                        description: Tr.interpolation-hint;
                        selected: root.interpolation;
                        clicked => { root.toggle-interpolation(); }
                    }
                }

                if root.sheet == "settings": VerticalLayout {
                    spacing: Spacing.base;

                    Text {
                        text: Tr.quality;
                        color: #FFFFFF;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                    }

                    HorizontalLayout {
                        spacing: Spacing.small;
                        alignment: start;

                        for name[index] in root.qualities: SettingChip {
                            label: name;
                            selected: index == root.quality;
                            clicked => { root.set-quality(index); }
                        }
                    }

                    // Only worth a section when there is a choice. A single
                    // audio track is not one, and "off" alone is not either.
                    if root.audio-tracks.length > 1: Text {
                        text: Tr.audio-track;
                        color: #FFFFFF;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                    }

                    if root.audio-tracks.length > 1: HorizontalLayout {
                        spacing: Spacing.small;
                        alignment: start;

                        for name[index] in root.audio-tracks: SettingChip {
                            label: name;
                            selected: index == root.audio-track;
                            clicked => { root.set-audio-track(index); }
                        }
                    }

                    if root.subtitle-tracks.length > 1: Text {
                        text: Tr.subtitles;
                        color: #FFFFFF;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                    }

                    if root.subtitle-tracks.length > 1: HorizontalLayout {
                        spacing: Spacing.small;
                        alignment: start;

                        for name[index] in root.subtitle-tracks: SettingChip {
                            label: name;
                            selected: index == root.subtitle-track;
                            clicked => { root.set-subtitle-track(index); }
                        }
                    }

                    Text {
                        text: Tr.decoder;
                        color: #FFFFFF;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                    }

                    Text {
                        text: Tr.decoder-hint;
                        color: #FFFFFF8C;
                        font-size: Typography.body-medium-size;
                        wrap: word-wrap;
                    }

                    SettingOption {
                        label: Tr.decoder-auto;
                        description: Tr.decoder-auto-hint;
                        selected: root.decoder == 0;
                        clicked => { root.set-decoder(0); }
                    }

                    SettingOption {
                        label: Tr.decoder-hw;
                        description: Tr.decoder-hw-hint;
                        badge: "HW";
                        selected: root.decoder == 1;
                        clicked => { root.set-decoder(1); }
                    }

                    SettingOption {
                        label: Tr.decoder-sw;
                        description: Tr.decoder-sw-hint;
                        badge: "SW";
                        selected: root.decoder == 2;
                        clicked => { root.set-decoder(2); }
                    }
                }

                if root.sheet == "speed": HorizontalLayout {
                    spacing: Spacing.small;
                    alignment: start;

                    SettingChip {
                        label: "0.5x";
                        selected: root.speed-label == "0.5x";
                        clicked => { root.set-speed(0.5); }
                    }
                    SettingChip {
                        label: "0.75x";
                        selected: root.speed-label == "0.75x";
                        clicked => { root.set-speed(0.75); }
                    }
                    SettingChip {
                        label: "1x";
                        recommended: true;
                        selected: root.speed-label == "1x";
                        clicked => { root.set-speed(1.0); }
                    }
                    SettingChip {
                        label: "1.25x";
                        selected: root.speed-label == "1.25x";
                        clicked => { root.set-speed(1.25); }
                    }
                    SettingChip {
                        label: "1.5x";
                        selected: root.speed-label == "1.5x";
                        clicked => { root.set-speed(1.5); }
                    }
                    SettingChip {
                        label: "2x";
                        selected: root.speed-label == "2x";
                        clicked => { root.set-speed(2.0); }
                    }
                }
            }
        }
    }
}
