// SPDX-License-Identifier: GPL-3.0-or-later
//
// The player screen.
//
// Laid out after the official Anixart player, which is the interface this
// audience already has in their hands. Three clusters of chrome float over the
// picture — a top bar, a centre transport, and a bottom row — and settings
// open as sheets rather than crowding the overlay. Everything sits flat on the
// video; the gradients at the edges carry legibility so the controls do not
// need panels of their own.

import { MaterialPalette } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing, Motion } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { IconButton, TextIndicator, SeekBar, SettingChip, SettingOption } from "../components/player-controls.slint";

/// A shift in time, in tenths of a second either way, with a way back to
/// none.
component DelayRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    callback step(int);

    spacing: Spacing.small;
    alignment: start;

    Text {
        text: root.label;
        color: #FFFFFFB3;
        font-size: Typography.body-medium-size;
        vertical-alignment: center;
        min-width: 190px;
    }

    SettingChip {
        label: "−0.1";
        clicked => { root.step(-1); }
    }

    Text {
        text: root.value;
        color: #FFFFFF;
        font-size: Typography.body-large-size;
        vertical-alignment: center;
        horizontal-alignment: center;
        min-width: 64px;
    }

    SettingChip {
        label: "+0.1";
        clicked => { root.step(1); }
    }

    SettingChip {
        label: Tr.reset;
        clicked => { root.step(0); }
    }
}

export component PlayerPage inherits Rectangle {
    // ---- from Rust -------------------------------------------------------
    in property <image> video-frame;
    in property <bool> has-video: false;
    in property <string> title;
    in property <string> episode-label;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> progress: 0.0;
    in property <float> buffered: 0.0;
    in property <bool> paused: false;
    /// One of: idle, loading, buffering, playing, paused, ended.
    in property <string> state: "idle";
    in property <string> quality-label: "—";
    in property <string> decoder-label: "HW";
    in property <string> speed-label: "1x";
    /// Index into the upscale modes: 0 off, 1–6 Anime4K's A, B, C, A+A, B+B,
    /// C+A.
    in property <int> upscale: 0;
    /// Index into the qualities: 0 fast, 1 high, 2 max, 3 ultra.
    in property <int> upscale-quality: 1;
    /// Rendering at 4K whatever the window's size.
    in property <bool> force-4k: false;
    callback toggle-force-4k();
    in property <bool> interpolation: false;
    in property <bool> has-skip: false;
    /// Whether the source has an episode either side of this one, so the
    /// transport can say when it is at an end rather than doing nothing.
    in property <bool> has-previous: false;
    in property <bool> has-next: false;
    /// A line about what just changed — volume, rate, muting. Shown briefly and
    /// then dropped: a key that alters something invisible has to say so, and a
    /// label that stays would be clutter.
    in property <string> hint;
    /// Available renditions, highest first, as "1080p" and the like.
    in property <[string]> qualities: [];
    in property <int> quality: 0;
    /// 0 automatic, 1 hardware, 2 software.
    in property <int> decoder: 0;
    /// Subtitle tracks the file carries, with "off" already first in the list.
    in property <[string]> subtitle-tracks: [];
    in property <int> subtitle-track: 0;
    /// Audio tracks. A file with one is not a choice, so the section hides.
    in property <[string]> audio-tracks: [];
    in property <int> audio-track: 0;
    in property <bool> fullscreen: false;
    /// Filling the window, with the release screen stepped aside.
    in property <bool> theatre: false;

    out property <bool> scrubbing: false;

    // ---- to Rust ---------------------------------------------------------
    callback toggle-pause();
    /// The controls have hidden themselves; the pointer, at this point in
    /// the window, should go with them.
    callback pointer-hidden(length, length);
    callback seek-fraction(float);
    callback seek-relative(float);
    callback skip-opening();
    callback previous-episode();
    callback next-episode();
    callback set-speed(float);
    callback set-upscale(int);
    callback set-upscale-quality(int);
    callback set-quality(int);
    callback set-decoder(int);
    callback set-subtitle-track(int);
    callback set-audio-track(int);
    callback toggle-interpolation();
    /// Pressed and held on the picture: play fast until let go.
    callback hold-speed(bool);
    callback step-frame(bool);
    /// Playing the episode over again instead of going on to the next.
    in property <bool> repeat: false;
    callback toggle-repeat();
    /// Saves the frame on screen, with the subtitles on it or without.
    callback screenshot(bool);
    callback open-screenshots-folder();
    // Sound and subtitles. The delays arrive as words, already formatted.
    in property <string> audio-delay-label: "0";
    in property <string> subtitle-delay-label: "0";
    in property <bool> normalize: false;
    /// Index into the subtitle sizes: 75%, 100%, 125%, 150%, 200%.
    in property <int> subtitle-scale: 1;
    in property <bool> ass-override: false;
    /// Index into the colour presets: natural, brighter, vivid, soft, dark room.
    in property <int> picture: 0;
    callback set-picture(int);
    /// Frame generation: 0 off, 1 ×2, 2 60, 3 the screen's rate.
    in property <int> frame-rate: 0;
    /// 0 the fast RIFE network, 1 the cleaner one.
    in property <int> rife-model: 0;
    /// Whether RIFE was found at all.
    in property <bool> frames-available: false;
    /// The monitor's refresh rate, rounded; 0 when not known.
    in property <int> display-fps: 0;
    callback set-frame-rate(int);
    callback set-rife-model(int);
    /// The engine for the networks: 0 Vulkan, 1 TensorRT.
    in property <int> neural-engine: 0;
    /// Whether the program carries its part of the TensorRT engine, and
    /// whether NVIDIA's runtime is there to go with it.
    in property <bool> tensorrt-shipped: false;
    in property <bool> tensorrt-ready: false;
    /// What fetching NVIDIA's runtime is doing; empty when nothing.
    in property <string> tensorrt-fetch;
    in property <bool> neural-upscale: false;
    callback set-neural-engine(int);
    callback fetch-tensorrt();
    callback toggle-neural-upscale();
    /// Lowering the load by itself when frames drop.
    in property <bool> adaptive: true;
    callback toggle-adaptive();
    /// −1 earlier, +1 later, 0 back to none.
    callback step-audio-delay(int);
    callback step-subtitle-delay(int);
    callback toggle-normalize();
    callback set-subtitle-scale(int);
    callback toggle-ass-override();
    callback load-audio-file();
    callback load-subtitle-file();
    callback open-fonts-folder();
    callback toggle-fullscreen();
    /// Fill the window, or give the release screen its place back.
    callback toggle-theatre();
    /// Put the picture away entirely and stop playing.
    callback close();

    background: #000000;

    // The overlay floats over the picture and never dictates how large the
    // picture should be, so the page's constraints are stated rather than
    // derived from the chrome inside it. Leaving them to the children lets the
    // controls push back on the layout that positions them.
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    property <bool> chrome-visible: true;
    property <bool> waiting: root.state == "loading" || root.state == "buffering";
    /// Which sheet is open: "", "speed", "anime4k", "settings". Settable from
    /// outside so a key can open one, and a screenshot can show one.
    in-out property <string> sheet: "";
    /// Locked hides every control but the lock itself, so a stray touch
    /// cannot pause or seek. The reference has this because a phone lives in
    /// a pocket; on a desktop it is just as useful against a cat.
    property <bool> locked: false;
    /// Chrome stays put while a sheet is up, or the sheet would be orphaned.
    property <bool> chrome-pinned: root.sheet != "" || root.state != "playing";
    /// Anime4K counts as working only once something is actually applied.
    property <bool> enhancing: root.upscale != 0 || root.interpolation || root.frame-rate != 0;

    video := Image {
        source: root.video-frame;
        // Letterbox rather than crop: cutting frames off a video is never a
        // friendly default.
        image-fit: contain;
        width: 100%;
        height: 100%;
        visible: root.has-video;
    }

    Text {
        text: root.state == "loading" ? Tr.loading
            : root.state == "buffering" ? Tr.buffering
            : root.state == "ended" ? Tr.ended
            : Tr.idle;
        color: #FFFFFFB3;
        font-size: Typography.body-large-size;
        visible: !root.has-video || root.waiting;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    // The chrome hides itself once the picture is running, whether or not the
    // pointer ever moved over it. Waiting for a `moved` meant that someone who
    // pressed play and then sat still kept the controls on screen for the whole
    // episode.
    changed state => { root.wake(); }
    changed paused => { root.wake(); }

    function wake() {
        if (root.locked) { return; }
        root.chrome-visible = true;
        linger.running = false;
        linger.running = true;
    }

    // Hidden on a timer rather than by whoever wrote the hint: several keys
    // write here, and none of them should have to remember to tidy up. Rust
    // appends a counter to the text so that pressing the same key twice is a
    // change and starts the timer again.
    property <bool> hint-showing: false;
    changed hint => {
        root.hint-showing = root.hint != "";
        hint-linger.running = false;
        hint-linger.running = root.hint-showing;
    }

    hint-linger := Timer {
        interval: 1200ms;
        running: false;
        triggered => { root.hint-showing = false; self.running = false; }
    }

    hint-box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height / 5;
        width: hint-text.preferred-width + 2 * Spacing.comfortable;
        height: 48px;
        border-radius: Shape.medium;
        background: #000000B3;
        opacity: root.hint-showing ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: Motion.standard-duration; easing: Motion.standard; }

        hint-text := Text {
            text: root.hint;
            color: #FFFFFF;
            font-size: Typography.title-medium-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    // Woken by the pointer's position rather than by `moved`, which Slint only
    // reports while a button is held: with the chrome hiding itself properly,
    // that left no way to bring it back short of clicking, and clicking pauses.
    changed mouse-at => { root.wake(); }
    property <length> mouse-at: hover.mouse-x + hover.mouse-y;

    // Holding the button down on the picture plays it fast, as the official
    // player does with a long press; letting go puts the speed back. The
    // release that ends a hold is not also a click, or it would pause.
    property <bool> holding: false;
    property <bool> held: false;

    hold-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.locked || root.sheet != "" || root.paused || !root.has-video) { return; }
            root.holding = true;
            root.held = true;
            root.hold-speed(true);
        }
    }

    hover := TouchArea {
        mouse-cursor: root.chrome-visible ? MouseCursor.default : MouseCursor.none;
        pointer-event(event) => {
            if (event.button != PointerEventButton.left) { return; }
            if (event.kind == PointerEventKind.down) {
                root.held = false;
                hold-timer.running = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                hold-timer.running = false;
                if (root.holding) {
                    root.holding = false;
                    root.hold-speed(false);
                }
            }
        }
        clicked => {
            if (root.held) { root.held = false; return; }
            // A click inside a sheet must not also toggle playback, and a
            // locked overlay must not react at all.
            if (root.locked) { return; }
            if (root.sheet != "") { root.sheet = ""; } else { root.toggle-pause(); }
        }
    }

    linger := Timer {
        interval: Motion.overlay-linger;
        running: false;
        triggered => {
            if (root.chrome-pinned) {
                // Something is still holding the chrome up — a sheet, or a
                // picture that is not running. Come back and ask again rather
                // than leaving it visible for ever.
                return;
            }
            root.chrome-visible = false;
            self.running = false;
            // The cursor a TouchArea asks for takes effect on the next
            // pointer event, and a hand resting on the mouse sends none.
            root.pointer-hidden(
                hover.absolute-position.x + hover.mouse-x,
                hover.absolute-position.y + hover.mouse-y);
        }
    }

    // ---- top bar ---------------------------------------------------------
    Rectangle {
        y: 0;
        height: 84px;
        width: 100%;
        background: @linear-gradient(180deg, #000000B3 0%, #00000000 100%);
        opacity: root.chrome-visible && !root.locked ? 1.0 : 0.0;
        // Opacity alone leaves a bar in the hit-test tree, so an invisible
        // one still swallows clicks. Locking has to remove it outright.
        visible: root.chrome-visible && !root.locked;
        animate opacity { duration: Motion.enter-duration; easing: Motion.enter; }

        // One row, one height, everything centred on the same axis. Sizing
        // each control independently put the back button, the title and the
        // indicators on three different centre lines.
        HorizontalLayout {
            y: Spacing.small;
            height: Spacing.touch-target;
            padding-left: Spacing.small;
            padding-right: Spacing.small;
            spacing: Spacing.hair;
            alignment: stretch;

            IconButton {
                icon: root.theatre
                    ? @image-url("../icons/back.svg")
                    : @image-url("../icons/close.svg");
                clicked => {
                    if (root.theatre) { root.toggle-theatre(); } else { root.close(); }
                }
            }

            // The two title lines are a block of their own, centred against
            // the icons rather than stretched to the row's full height.
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                VerticalLayout {
                    y: (parent.height - self.preferred-height) / 2;
                    width: 100%;
                    spacing: 1px;

                    if root.theatre: Text {
                        text: root.title;
                        color: #FFFFFF;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: Spacing.tight;
                        alignment: start;
                        visible: root.episode-label != "";

                        Text {
                            // The word belongs to the translations; the number
                            // and voice-over come from Rust.
                            text: Tr.episode + " " + root.episode-label;
                            color: #FFFFFFA6;
                            font-size: Typography.label-medium-size;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Image {
                            source: @image-url("../icons/chevron.svg");
                            colorize: #FFFFFFA6;
                            width: 12px;
                            height: 12px;
                            y: 1px;
                        }
                    }
                }
            }

            TextIndicator {
                text: root.quality-label;
            }

            TextIndicator {
                text: root.decoder-label;
            }

            // Green while enhancement is actually in effect: the indicator
            // answers "is this doing anything right now", which a dimmed
            // white glyph does not.
            IconButton {
                icon: @image-url("../icons/sparkle.svg");
                tint: root.enhancing ? #6BD97F : #FFFFFF;
                dimmed: !root.enhancing;
                clicked => { root.sheet = root.sheet == "anime4k" ? "" : "anime4k"; }
            }

            IconButton {
                icon: @image-url("../icons/settings.svg");
                clicked => { root.sheet = root.sheet == "settings" ? "" : "settings"; }
            }
        }
    }

    // ---- centre transport ------------------------------------------------
    HorizontalLayout {
        y: (parent.height - self.height) / 2;
        height: 72px;
        width: 100%;
        alignment: center;
        spacing: Spacing.loose;
        opacity: root.chrome-visible && !root.locked ? 1.0 : 0.0;
        visible: root.sheet == "" && !root.locked && root.has-video;
        animate opacity { duration: Motion.enter-duration; easing: Motion.enter; }

        // One box size across the row, so the glyphs share a centre line
        // however differently sized they are.
        IconButton {
            icon: @image-url("../icons/prev-episode.svg");
            size: 30px;
            box: 72px;
            dimmed: !root.has-previous;
            clicked => { if (root.has-previous) { root.previous-episode(); } }
        }

        // Stepping a frame is something done paused, so the steps appear
        // either side of play only then.
        if root.paused: IconButton {
            icon: @image-url("../icons/frame-back.svg");
            size: 26px;
            box: 56px;
            clicked => { root.step-frame(false); }
        }

        IconButton {
            icon: root.paused
                ? @image-url("../icons/play.svg")
                : @image-url("../icons/pause.svg");
            size: 52px;
            box: 72px;
            clicked => { root.toggle-pause(); }
        }

        if root.paused: IconButton {
            icon: @image-url("../icons/frame-forward.svg");
            size: 26px;
            box: 56px;
            clicked => { root.step-frame(true); }
        }

        IconButton {
            icon: @image-url("../icons/next-episode.svg");
            size: 30px;
            box: 72px;
            dimmed: !root.has-next;
            clicked => { if (root.has-next) { root.next-episode(); } }
        }
    }

    // ---- bottom chrome ---------------------------------------------------
    Rectangle {
        y: parent.height - self.height;
        height: 132px;
        width: 100%;
        background: @linear-gradient(0deg, #000000CC 0%, #00000000 100%);
        opacity: root.chrome-visible && !root.locked ? 1.0 : 0.0;
        visible: root.chrome-visible && !root.locked;
        animate opacity { duration: Motion.enter-duration; easing: Motion.enter; }

        VerticalLayout {
            padding-left: Spacing.small;
            padding-right: Spacing.small;
            padding-bottom: Spacing.small;
            alignment: end;
            spacing: Spacing.tight;

            // Secondary controls, split to the edges the way the reference
            // does: the middle stays clear of the picture.
            HorizontalLayout {
                spacing: Spacing.tight;

                IconButton {
                    icon: @image-url("../icons/lock.svg");
                    size: 22px;
                    clicked => { root.locked = true; }
                }

                IconButton {
                    icon: @image-url("../icons/speed.svg");
                    size: 22px;
                    clicked => { root.sheet = root.sheet == "speed" ? "" : "speed"; }
                }

                Rectangle { horizontal-stretch: 1; }

                // One button, not two: a separate "skip opening" label beside
                // a fast-forward that jumped the same distance was the same
                // action twice.
                IconButton {
                    icon: @image-url("../icons/fast-forward.svg");
                    size: 22px;
                    clicked => { root.skip-opening(); }
                }

                // Taller or shorter, which is a different request from
                // filling the screen — so a different glyph from the corner
                // brackets beside it.
                IconButton {
                    icon: root.theatre
                        ? @image-url("../icons/collapse.svg")
                        : @image-url("../icons/expand.svg");
                    size: 22px;
                    clicked => { root.toggle-theatre(); }
                }

                IconButton {
                    icon: root.fullscreen
                        ? @image-url("../icons/fullscreen-exit.svg")
                        : @image-url("../icons/fullscreen.svg");
                    size: 22px;
                    clicked => { root.toggle-fullscreen(); }
                }
            }

            // Time flanks the bar, as in the reference: both ends are read at
            // a glance without the eye leaving the row.
            HorizontalLayout {
                spacing: Spacing.medium;
                padding-left: Spacing.small;
                padding-right: Spacing.small;

                Text {
                    text: root.position-text;
                    color: #FFFFFF;
                    font-size: Typography.body-medium-size;
                    vertical-alignment: center;
                    min-width: 52px;
                }

                SeekBar {
                    horizontal-stretch: 1;
                    position: root.progress;
                    buffered: root.buffered;
                    seek(fraction) => { root.seek-fraction(fraction); }
                    scrubbing(active) => { root.scrubbing = active; }
                }

                Text {
                    text: root.duration-text;
                    color: #FFFFFF;
                    font-size: Typography.body-medium-size;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 52px;
                }
            }
        }
    }

    // The one control that survives the lock, so it can be undone. Declared
    // after the video's touch area so it receives the click first.
    if root.locked: Rectangle {
        x: Spacing.base;
        y: parent.height - self.height - Spacing.comfortable;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: #000000A6;

        Image {
            source: @image-url("../icons/lock.svg");
            colorize: #FFFFFF;
            width: 22px;
            height: 22px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.locked = false;
                // Come back with the chrome showing and the hide countdown
                // restarted; otherwise the overlay returns to whatever state
                // it happened to be in when the lock went on.
                root.chrome-visible = true;
                linger.running = false;
                linger.running = true;
            }
        }
    }

    Text {
        text: Tr.lock-hint;
        color: #FFFFFF8C;
        font-size: Typography.label-medium-size;
        visible: root.locked;
        horizontal-alignment: center;
        y: parent.height - 40px;
        width: 100%;
    }

    // ---- sheets ----------------------------------------------------------
    //
    // Anchored to the bottom with a large top radius, matching the reference.
    // Settings that need explaining get room to explain themselves, which an
    // inline chip never has.
    if root.sheet != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000073;

        TouchArea {
            clicked => { root.sheet = ""; }
        }

        // As tall as its contents, up to the player's own height less a
        // strip of scrim to close it by; past that it scrolls. The player in
        // a release page is short, and the upscale sheet is not.
        sheet := Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: min(sheet-body.preferred-height + Spacing.loose, parent.height - 2 * Spacing.loose);
            background: MaterialPalette.surface-container;
            border-top-left-radius: Shape.extra-large;
            border-top-right-radius: Shape.extra-large;
            clip: true;

            // Swallow clicks so they do not reach the scrim behind.
            TouchArea {}

            sheet-flick := Flickable {
                width: 100%;
                height: 100%;
                content-width: self.width;
                content-height: sheet-body.preferred-height + Spacing.loose;

                sheet-body := VerticalLayout {
                    width: sheet-flick.width;
                    padding: Spacing.comfortable;
                    spacing: Spacing.base;

                    HorizontalLayout {
                        Text {
                            text: root.sheet == "anime4k" ? Tr.picture-sheet
                                : root.sheet == "settings" ? Tr.settings
                                : Tr.speed;
                            color: #FFFFFF;
                            font-size: Typography.headline-small-size;
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: @image-url("../icons/close.svg");
                            size: 20px;
                            clicked => { root.sheet = ""; }
                        }
                    }

                    if root.sheet == "anime4k": VerticalLayout {
                        spacing: Spacing.medium;

                        Text {
                            text: Tr.upscale-hint;
                            color: #FFFFFF8C;
                            font-size: Typography.body-medium-size;
                            wrap: word-wrap;
                        }

                        Text {
                            text: Tr.upscale-mode;
                            color: #FFFFFF;
                            font-size: Typography.title-small-size;
                            font-weight: Typography.title-small-weight-em;
                        }

                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            for name[index] in [Tr.off, "A", "B", "C", "A+A", "B+B", "C+A"]: SettingChip {
                                label: name;
                                recommended: index == 1;
                                selected: root.upscale == index;
                                clicked => { root.set-upscale(index); }
                            }
                        }

                        Text {
                            text: Tr.upscale-mode-hint(root.upscale);
                            color: #FFFFFF8C;
                            font-size: Typography.body-medium-size;
                            wrap: word-wrap;
                        }

                        // Quality means nothing with the shaders off, so it is
                        // not offered until a mode is.
                        if root.upscale != 0: VerticalLayout {
                            spacing: Spacing.medium;

                            Text {
                                text: Tr.upscale-quality;
                                color: #FFFFFF;
                                font-size: Typography.title-small-size;
                                font-weight: Typography.title-small-weight-em;
                            }

                            HorizontalLayout {
                                spacing: Spacing.small;
                                alignment: start;

                                for name[index] in [Tr.quality-fast, Tr.quality-high, Tr.quality-max, Tr.quality-ultra]: SettingChip {
                                    label: name;
                                    recommended: index == 1;
                                    heavy: index == 3;
                                    selected: root.upscale-quality == index;
                                    clicked => { root.set-upscale-quality(index); }
                                }
                            }
                        }

                        Text {
                            text: Tr.picture;
                            color: #FFFFFF;
                            font-size: Typography.title-small-size;
                            font-weight: Typography.title-small-weight-em;
                        }

                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            for name[index] in [Tr.picture-natural, Tr.picture-brighter, Tr.picture-vivid, Tr.picture-soft, Tr.picture-dark-room]: SettingChip {
                                label: name;
                                selected: root.picture == index;
                                clicked => { root.set-picture(index); }
                            }
                        }

                        // ---- the engine for the networks ----
                        if root.tensorrt-shipped: Text {
                            text: Tr.neural-engine;
                            color: #FFFFFF;
                            font-size: Typography.title-small-size;
                            font-weight: Typography.title-small-weight-em;
                        }

                        if root.tensorrt-shipped: HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            for name[index] in [Tr.engine-vulkan, Tr.engine-tensorrt]: SettingChip {
                                label: name;
                                recommended: index == 1;
                                selected: root.neural-engine == index;
                                clicked => { root.set-neural-engine(index); }
                            }
                        }

                        // TensorRT-RTX is NVIDIA's: fetched from NVIDIA, on
                        // the person's say-so, and said to be so.
                        if root.tensorrt-shipped && root.neural-engine == 1 && !root.tensorrt-ready: VerticalLayout {
                            spacing: Spacing.small;

                            Text {
                                text: Tr.tensorrt-needed;
                                color: #FFFFFF8C;
                                font-size: Typography.body-medium-size;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: Spacing.small;
                                alignment: start;

                                if root.tensorrt-fetch == "": SettingChip {
                                    label: Tr.tensorrt-fetch;
                                    clicked => { root.fetch-tensorrt(); }
                                }

                                if root.tensorrt-fetch != "": Text {
                                    text: root.tensorrt-fetch;
                                    color: #FFFFFF;
                                    font-size: Typography.body-medium-size;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.neural-engine == 1 && root.tensorrt-ready: SettingOption {
                            label: Tr.neural-upscale;
                            description: Tr.neural-upscale-hint;
                            selected: root.neural-upscale;
                            clicked => { root.toggle-neural-upscale(); }
                        }

                        Text {
                            text: Tr.frame-generation;
                            color: #FFFFFF;
                            font-size: Typography.title-small-size;
                            font-weight: Typography.title-small-weight-em;
                        }

                        Text {
                            text: root.frames-available ? Tr.frame-generation-hint : Tr.frame-generation-missing;
                            color: #FFFFFF8C;
                            font-size: Typography.body-medium-size;
                            wrap: word-wrap;
                        }

                        if root.frames-available: HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            // Half the screen's rate is where keeping up steps
                            // down to; it shows on the screen-rate chip.
                            for name[index] in [Tr.off, "×2", "60", root.display-fps <= 0 ? Tr.frame-rate-display
                                    : root.frame-rate == 4 ? Tr.frame-rate-display + " · " + floor(root.display-fps / 2)
                                    : Tr.frame-rate-display + " · " + root.display-fps]: SettingChip {
                                label: name;
                                selected: root.frame-rate == index || (index == 3 && root.frame-rate == 4);
                                clicked => { root.set-frame-rate(index); }
                            }
                        }

                        if root.frames-available && root.frame-rate != 0: HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            for name[index] in [Tr.rife-fast, Tr.rife-quality]: SettingChip {
                                label: name;
                                recommended: index == 0;
                                heavy: index == 1;
                                selected: root.rife-model == index;
                                clicked => { root.set-rife-model(index); }
                            }
                        }

                        SettingOption {
                            label: Tr.adaptive;
                            description: Tr.adaptive-hint;
                            selected: root.adaptive;
                            clicked => { root.toggle-adaptive(); }
                        }

                        SettingOption {
                            label: Tr.interpolation;
                            description: Tr.interpolation-hint;
                            selected: root.interpolation;
                            clicked => { root.toggle-interpolation(); }
                        }

                        SettingOption {
                            label: Tr.force-4k;
                            description: Tr.force-4k-hint;
                            selected: root.force-4k;
                            clicked => { root.toggle-force-4k(); }
                        }
                    }

                    if root.sheet == "settings": VerticalLayout {
                        spacing: Spacing.base;

                        Text {
                            text: Tr.quality;
                            color: #FFFFFF;
                            font-size: Typography.title-medium-size;
                            font-weight: Typography.title-medium-weight-em;
                        }

                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            for name[index] in root.qualities: SettingChip {
                                label: name;
                                selected: index == root.quality;
                                clicked => { root.set-quality(index); }
                            }
                        }

                        // ---- sound ----
                        Text {
                            text: Tr.audio-track;
                            color: #FFFFFF;
                            font-size: Typography.title-medium-size;
                            font-weight: Typography.title-medium-weight-em;
                        }

                        // A single track is no choice, so its chip would only
                        // be noise; the file button is always there.
                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            if root.audio-tracks.length > 1: HorizontalLayout {
                                spacing: Spacing.small;

                                for name[index] in root.audio-tracks: SettingChip {
                                    label: name;
                                    selected: index == root.audio-track;
                                    clicked => { root.set-audio-track(index); }
                                }
                            }

                            SettingChip {
                                label: Tr.from-file;
                                clicked => { root.load-audio-file(); }
                            }
                        }

                        DelayRow {
                            label: Tr.audio-delay;
                            value: root.audio-delay-label;
                            step(direction) => { root.step-audio-delay(direction); }
                        }

                        SettingOption {
                            label: Tr.normalize;
                            description: Tr.normalize-hint;
                            selected: root.normalize;
                            clicked => { root.toggle-normalize(); }
                        }

                        // ---- subtitles ----
                        Text {
                            text: Tr.subtitles;
                            color: #FFFFFF;
                            font-size: Typography.title-medium-size;
                            font-weight: Typography.title-medium-weight-em;
                        }

                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            if root.subtitle-tracks.length > 1: HorizontalLayout {
                                spacing: Spacing.small;

                                for name[index] in root.subtitle-tracks: SettingChip {
                                    label: name;
                                    selected: index == root.subtitle-track;
                                    clicked => { root.set-subtitle-track(index); }
                                }
                            }

                            SettingChip {
                                label: Tr.from-file;
                                clicked => { root.load-subtitle-file(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            Text {
                                text: Tr.subtitle-size;
                                color: #FFFFFFB3;
                                font-size: Typography.body-medium-size;
                                vertical-alignment: center;
                                min-width: 190px;
                            }

                            for name[index] in ["75%", "100%", "125%", "150%", "200%"]: SettingChip {
                                label: name;
                                selected: index == root.subtitle-scale;
                                clicked => { root.set-subtitle-scale(index); }
                            }
                        }

                        DelayRow {
                            label: Tr.subtitle-delay;
                            value: root.subtitle-delay-label;
                            step(direction) => { root.step-subtitle-delay(direction); }
                        }

                        SettingOption {
                            label: Tr.ass-override;
                            description: Tr.ass-override-hint;
                            selected: root.ass-override;
                            clicked => { root.toggle-ass-override(); }
                        }

                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            Text {
                                text: Tr.subtitle-fonts-hint;
                                color: #FFFFFF8C;
                                font-size: Typography.body-medium-size;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            SettingChip {
                                label: Tr.open-folder;
                                clicked => { root.open-fonts-folder(); }
                            }
                        }

                        SettingOption {
                            label: Tr.repeat;
                            description: Tr.repeat-hint;
                            selected: root.repeat;
                            clicked => { root.toggle-repeat(); }
                        }

                        Text {
                            text: Tr.screenshot;
                            color: #FFFFFF;
                            font-size: Typography.title-medium-size;
                            font-weight: Typography.title-medium-weight-em;
                        }

                        Text {
                            text: Tr.screenshot-hint;
                            color: #FFFFFF8C;
                            font-size: Typography.body-medium-size;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: Spacing.small;
                            alignment: start;

                            SettingChip {
                                label: Tr.screenshot-with-subtitles;
                                clicked => { root.screenshot(true); }
                            }

                            SettingChip {
                                label: Tr.screenshot-without-subtitles;
                                clicked => { root.screenshot(false); }
                            }

                            SettingChip {
                                label: Tr.open-folder;
                                clicked => { root.open-screenshots-folder(); }
                            }
                        }

                        Text {
                            text: Tr.decoder;
                            color: #FFFFFF;
                            font-size: Typography.title-medium-size;
                            font-weight: Typography.title-medium-weight-em;
                        }

                        Text {
                            text: Tr.decoder-hint;
                            color: #FFFFFF8C;
                            font-size: Typography.body-medium-size;
                            wrap: word-wrap;
                        }

                        SettingOption {
                            label: Tr.decoder-auto;
                            description: Tr.decoder-auto-hint;
                            selected: root.decoder == 0;
                            clicked => { root.set-decoder(0); }
                        }

                        SettingOption {
                            label: Tr.decoder-hw;
                            description: Tr.decoder-hw-hint;
                            badge: "HW";
                            selected: root.decoder == 1;
                            clicked => { root.set-decoder(1); }
                        }

                        SettingOption {
                            label: Tr.decoder-sw;
                            description: Tr.decoder-sw-hint;
                            badge: "SW";
                            selected: root.decoder == 2;
                            clicked => { root.set-decoder(2); }
                        }
                    }

                    if root.sheet == "speed": HorizontalLayout {
                        spacing: Spacing.small;
                        alignment: start;

                        SettingChip {
                            label: "0.5x";
                            selected: root.speed-label == "0.5x";
                            clicked => { root.set-speed(0.5); }
                        }
                        SettingChip {
                            label: "0.75x";
                            selected: root.speed-label == "0.75x";
                            clicked => { root.set-speed(0.75); }
                        }
                        SettingChip {
                            label: "1x";
                            recommended: true;
                            selected: root.speed-label == "1x";
                            clicked => { root.set-speed(1.0); }
                        }
                        SettingChip {
                            label: "1.25x";
                            selected: root.speed-label == "1.25x";
                            clicked => { root.set-speed(1.25); }
                        }
                        SettingChip {
                            label: "1.5x";
                            selected: root.speed-label == "1.5x";
                            clicked => { root.set-speed(1.5); }
                        }
                        SettingChip {
                            label: "2x";
                            selected: root.speed-label == "2x";
                            clicked => { root.set-speed(2.0); }
                        }
                    }
                }
            }
        }
    }
}
