//
// The account, and what the application is set to.
//
// The fifth destination on the rail, and the only one that is about the
// application rather than about what to watch. The account's own client shows
// the same things here: who you are, how much is in each of your lists, and
// how much you have had to say about it.
//
// Every count on the screen is a way into the list it counts. A number nobody
// can act on is decoration, and this client has no room for decoration it
// cannot click.

import { MaterialPalette, ListTile, SegmentedButton, HorizontalDivider, FilledButton, OutlineButton, FilledCard } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { Account, HistoryItem } from "../structs.slint";

/// One wedge of the ring.
///
/// An annulus segment, drawn the way the component set draws its progress
/// ring: out along the outer radius, in, back along the inner one. Angles run
/// from twelve o'clock clockwise, as a clock and every chart like this does.
component Wedge {
    /// Where it starts and how far it goes, each as a fraction of the circle.
    in property <float> start;
    in property <float> sweep;
    in property <color> tint;

    /// In viewbox units, of which the box is a hundred across.
    property <float> outer: 50;
    property <float> inner: 33;
    /// A hair of a gap, so two wedges of similar colour do not read as one.
    property <float> gap: 0.006;
    property <float> span: max(0, root.sweep - root.gap);
    property <float> finish: root.start + root.span;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: root.tint;
        visible: root.span > 0;

        MoveTo {
            x: 50 + root.outer * sin(root.start * 360deg);
            y: 50 - root.outer * cos(root.start * 360deg);
        }

        ArcTo {
            radius-x: root.outer;
            radius-y: root.outer;
            x: 50 + root.outer * sin(root.finish * 360deg);
            y: 50 - root.outer * cos(root.finish * 360deg);
            sweep: true;
            large-arc: root.span > 0.5;
        }

        LineTo {
            x: 50 + root.inner * sin(root.finish * 360deg);
            y: 50 - root.inner * cos(root.finish * 360deg);
        }

        ArcTo {
            radius-x: root.inner;
            radius-y: root.inner;
            x: 50 + root.inner * sin(root.start * 360deg);
            y: 50 - root.inner * cos(root.start * 360deg);
            sweep: false;
            large-arc: root.span > 0.5;
        }

        LineTo {
            x: 50 + root.outer * sin(root.start * 360deg);
            y: 50 - root.outer * cos(root.start * 360deg);
        }
    }
}

/// One line of the legend: the colour, what it counts, and how many.
///
/// The whole row is the target rather than the number alone — a count that
/// opens a list is worth the width of its own name to click.
component Reading inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <color> tint;
    callback clicked;

    height: 30px;
    border-radius: Shape.small;
    background: touch.has-hover ? MaterialPalette.surface-container-high : transparent;

    HorizontalLayout {
        padding-left: Spacing.small;
        padding-right: Spacing.small;
        spacing: Spacing.small;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.tint;
            }
        }

        Text {
            text: root.label;
            color: MaterialPalette.on-surface;
            font-size: Typography.body-medium-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.value;
            color: MaterialPalette.on-surface;
            font-size: Typography.body-medium-size;
            font-weight: Typography.body-medium-weight-em;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// One number, with what it counts under it.
///
/// A card rather than a plain box when it leads somewhere: the state layer a
/// card draws under its children is what says it can be pressed, and the two
/// pieces of text on top of it are transparent enough to let that through.
component Stat inherits Rectangle {
    in property <string> label;
    in property <int> value;
    /// Whether clicking it goes anywhere.
    in property <bool> opens: false;
    callback clicked;

    width: 146px;
    height: 76px;
    background: transparent;

    // Told to fill its box. A card sitting in a plain rectangle takes the size
    // of what is written on it otherwise, and a row of them then has one gap
    // per word length.
    FilledCard {
        width: 100%;
        height: 100%;
        clickable: root.opens;
        clicked => { root.clicked(); }

        VerticalLayout {
            padding: Spacing.medium;
            spacing: Spacing.hair;
            alignment: center;

            Text {
                text: root.value;
                color: MaterialPalette.on-surface;
                font-size: Typography.headline-small-size;
                font-weight: Typography.headline-small-weight;
            }

            Text {
                text: root.label;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
                overflow: elide;
            }
        }
    }
}

export component ProfilePage inherits Rectangle {
    in property <bool> signed-in: false;
    in property <Account> account;
    in property <image> avatar;
    in property <bool> avatar-loaded: false;
    /// Which appearance is chosen, as a position in the row of them. Rust owns
    /// the list and the order; this only says which one is lit.
    in property <int> appearance: 0;

    callback sign-in();
    callback sign-out();
    callback select-appearance(int);
    /// One of the account's own lists, by its place in the bookmarks tabs.
    callback open-list(int);
    /// What was watched lately, newest first, and opening one of them.
    in property <[HistoryItem]> recent: [];
    callback open-recent(int);

    // One colour per list, shared by the ring and the legend beside it — the
    // legend is only readable because the two agree. The scheme is one family
    // of violets, so the five are pulled apart by lightness and by the two
    // accents it does have rather than by five hues it does not.
    property <color> watching-colour: MaterialPalette.tertiary;
    property <color> planned-colour: MaterialPalette.secondary;
    property <color> watched-colour: MaterialPalette.inverse-primary;
    property <color> hold-colour: MaterialPalette.outline;
    property <color> dropped-colour: MaterialPalette.error;

    /// What the five add up to, and never zero: a ring divides by it.
    property <int> total: max(1, root.account.watching + root.account.planned
        + root.account.watched + root.account.hold + root.account.dropped);

    background: MaterialPalette.surface;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    VerticalLayout {
        padding: Spacing.base;
        spacing: Spacing.base;
        alignment: start;

        // ---- who ---------------------------------------------------------
        HorizontalLayout {
            spacing: Spacing.base;

            // The avatar is the account's own picture once it arrives, and a
            // filled circle until then — never a gap that fills in later and
            // moves everything sideways.
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: self.width / 2;
                background: MaterialPalette.primary-container;
                clip: true;

                Image {
                    source: root.avatar;
                    image-fit: cover;
                    width: 100%;
                    height: 100%;
                    visible: root.signed-in && root.avatar-loaded;
                }

                Image {
                    source: @image-url("../icons/person.svg");
                    colorize: MaterialPalette.on-primary-container;
                    width: 34px;
                    height: 34px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    visible: !root.signed-in || !root.avatar-loaded;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Spacing.hair;

                HorizontalLayout {
                    spacing: Spacing.small;
                    alignment: start;

                    Text {
                        text: root.signed-in ? root.account.login : Tr.signed-out;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.title-large-size;
                        font-weight: Typography.title-large-weight-em;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.signed-in && root.account.verified: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: badge.preferred-width + Spacing.medium;
                        border-radius: Shape.small;
                        background: MaterialPalette.secondary-container;

                        badge := Text {
                            text: Tr.verified;
                            color: MaterialPalette.on-secondary-container;
                            font-size: Typography.label-small-size;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                if root.signed-in && root.account.status != "": Text {
                    text: root.account.status;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.body-medium-size;
                    overflow: elide;
                }

                Text {
                    text: root.signed-in
                        ? (root.account.registered != ""
                            ? Tr.registered + " " + root.account.registered
                            : "")
                        : Tr.sign-in-to-profile;
                    color: MaterialPalette.on-surface-variant;
                    font-size: Typography.body-medium-size;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: center;

                // Signing in is the offer; signing out is the retreat from it.
                // Material spells that difference with the button, which is
                // why the two are not the same one with a different word in.
                if !root.signed-in: FilledButton {
                    text: Tr.sign-in;
                    clicked => { root.sign-in(); }
                }

                if root.signed-in: OutlineButton {
                    text: Tr.sign-out;
                    clicked => { root.sign-out(); }
                }
            }
        }

        // ---- what is in the lists ----------------------------------------
        //
        // Only with an account behind them. Five zeroes state nothing except
        // that nobody is signed in, which the line above already said.
        //
        // A ring beside the numbers, because the question the numbers answer
        // is what the account's viewing looks like as a whole, and a
        // proportion is a shape before it is a figure.
        if root.signed-in: VerticalLayout {
            spacing: Spacing.base;

            VerticalLayout {
                spacing: Spacing.small;

                Text {
                    text: Tr.lists;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.title-medium-size;
                    font-weight: Typography.title-medium-weight-em;
                }

                // As wide as it needs to be and no wider: a legend of five
                // short lines stretched across a desktop window puts each
                // number half a screen from the word it belongs to.
                HorizontalLayout {
                    alignment: start;

                Rectangle {
                    width: 520px;
                    height: 188px;
                    border-radius: Shape.large;
                    background: MaterialPalette.surface-container;

                    HorizontalLayout {
                        padding: Spacing.base;
                        spacing: Spacing.base;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: Spacing.hair;

                            Reading {
                                label: Tr.list-watching;
                                value: root.account.watching;
                                tint: root.watching-colour;
                                clicked => { root.open-list(0); }
                            }

                            Reading {
                                label: Tr.list-planned;
                                value: root.account.planned;
                                tint: root.planned-colour;
                                clicked => { root.open-list(1); }
                            }

                            Reading {
                                label: Tr.list-watched;
                                value: root.account.watched;
                                tint: root.watched-colour;
                                clicked => { root.open-list(2); }
                            }

                            Reading {
                                label: Tr.list-hold;
                                value: root.account.hold;
                                tint: root.hold-colour;
                                clicked => { root.open-list(3); }
                            }

                            Reading {
                                label: Tr.list-dropped;
                                value: root.account.dropped;
                                tint: root.dropped-colour;
                                clicked => { root.open-list(4); }
                            }
                        }

                        // The ring itself, and in its hole the number the five
                        // add up to: a total is what a reader works out from a
                        // ring otherwise, and works out wrong.
                        Rectangle {
                            width: 156px;

                            Wedge {
                                width: 100%;
                                height: 100%;
                                start: 0;
                                sweep: root.account.watching / root.total;
                                tint: root.watching-colour;
                            }

                            Wedge {
                                width: 100%;
                                height: 100%;
                                start: root.account.watching / root.total;
                                sweep: root.account.planned / root.total;
                                tint: root.planned-colour;
                            }

                            Wedge {
                                width: 100%;
                                height: 100%;
                                start: (root.account.watching + root.account.planned) / root.total;
                                sweep: root.account.watched / root.total;
                                tint: root.watched-colour;
                            }

                            Wedge {
                                width: 100%;
                                height: 100%;
                                start: (root.account.watching + root.account.planned
                                    + root.account.watched) / root.total;
                                sweep: root.account.hold / root.total;
                                tint: root.hold-colour;
                            }

                            Wedge {
                                width: 100%;
                                height: 100%;
                                start: (root.account.watching + root.account.planned
                                    + root.account.watched + root.account.hold) / root.total;
                                sweep: root.account.dropped / root.total;
                                tint: root.dropped-colour;
                            }

                            VerticalLayout {
                                alignment: center;

                                Text {
                                    text: root.total;
                                    color: MaterialPalette.on-surface;
                                    font-size: Typography.headline-small-size;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: Tr.releases-total;
                                    color: MaterialPalette.on-surface-variant;
                                    font-size: Typography.label-small-size;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
                }
            }

            // Counts of things this client has no screen for, so they are
            // under a heading of their own rather than sitting among lists
            // that open. They are still worth stating: they are the account's
            // own measure of itself.
            VerticalLayout {
                spacing: Spacing.small;

                Text {
                    text: Tr.activity;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.title-medium-size;
                    font-weight: Typography.title-medium-weight-em;
                }

                FlexboxLayout {
                    flex-wrap: wrap;
                    alignment: start;
                    spacing: Spacing.small;

                    Stat {
                        label: Tr.votes;
                        value: root.account.votes;
                    }

                    Stat {
                        label: Tr.comments;
                        value: root.account.comments;
                    }

                    Stat {
                        label: Tr.collections;
                        value: root.account.collections;
                    }

                    Stat {
                        label: Tr.friends;
                        value: root.account.friends;
                    }
                }
            }
        }

        // ---- what was watched lately -------------------------------------
        //
        // The same list the history tab holds, cut to what fits here. It is on
        // this screen because it is the answer to "where was I", and that is
        // the question an account is opened with.
        if root.signed-in: VerticalLayout {
            spacing: Spacing.small;

            Text {
                text: Tr.recently-watched;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
            }

            if root.recent.length == 0: Text {
                text: Tr.nothing-watched;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.body-medium-size;
            }

            for item[index] in root.recent: Rectangle {
                height: 64px;
                border-radius: Shape.medium;
                background: row-touch.has-hover
                    ? MaterialPalette.surface-container
                    : transparent;

                HorizontalLayout {
                    padding-left: Spacing.small;
                    padding-right: Spacing.base;
                    spacing: Spacing.medium;

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 36px;
                            height: 52px;
                            border-radius: Shape.small;
                            background: MaterialPalette.surface-container-high;
                            clip: true;

                            Image {
                                source: item.poster;
                                image-fit: cover;
                                width: 100%;
                                height: 100%;
                                visible: item.poster-loaded;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: Spacing.hair;

                        Text {
                            text: item.title;
                            color: MaterialPalette.on-surface;
                            font-size: Typography.body-large-size;
                            overflow: elide;
                        }

                        Text {
                            text: item.episode > 0
                                ? Tr.episode-of(item.episode) + " · " + Tr.ago(item.minutes-ago)
                                : Tr.ago(item.minutes-ago);
                            color: MaterialPalette.on-surface-variant;
                            font-size: Typography.label-medium-size;
                            overflow: elide;
                        }
                    }
                }

                row-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-recent(index); }
                }
            }
        }

        HorizontalDivider {}

        // ---- how it looks ------------------------------------------------
        VerticalLayout {
            spacing: Spacing.small;

            Text {
                text: Tr.appearance;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
            }

            Text {
                text: Tr.appearance-why;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.body-medium-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: start;

                choice := SegmentedButton {
                    items: [
                        { text: Tr.appearance-system },
                        { text: Tr.appearance-light },
                        { text: Tr.appearance-dark },
                        { text: Tr.appearance-amoled },
                    ];

                    // Pushed, not bound: the control writes its own index on a
                    // click, and what is actually in force is whatever Rust
                    // wrote to the settings file.
                    property <int> wanted: root.appearance;
                    init => { self.current-index = root.appearance; }
                    changed wanted => { self.current-index = self.wanted; }

                    index-changed(i) => { root.select-appearance(i); }
                }
            }
        }
    }
}
