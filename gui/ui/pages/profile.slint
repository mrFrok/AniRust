// SPDX-License-Identifier: GPL-3.0-or-later
//
// The account, and what the application is set to.
//
// The fifth destination on the rail, and the only one that is about the
// application rather than about what to watch. The account's own client shows
// the same things here: who you are, how much is in each of your lists, and
// how much you have had to say about it.
//
// Every count on the screen is a way into the list it counts. A number nobody
// can act on is decoration, and this client has no room for decoration it
// cannot click.

import { ScrollView } from "std-widgets.slint";
import { MaterialPalette, ListTile, SegmentedButton, HorizontalDivider, FilledButton, OutlineButton, FilledCard, IconButton, Switch, TextButton, TonalButton } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { Account, HistoryItem, PersonItem } from "../structs.slint";
import { PersonChip } from "../components/person-chip.slint";
import { Scheme, Accent } from "../globals/scheme.slint";

/// One wedge of the ring.
///
/// An annulus segment, drawn the way the component set draws its progress
/// ring: out along the outer radius, in, back along the inner one. Angles run
/// from twelve o'clock clockwise, as a clock and every chart like this does.
component Wedge {
    /// Where it starts and how far it goes, each as a fraction of the circle.
    in property <float> start;
    in property <float> sweep;
    in property <color> tint;

    /// In viewbox units, of which the box is a hundred across.
    property <float> outer: 50;
    property <float> inner: 33;
    /// A hair of a gap, so two wedges of similar colour do not read as one.
    property <float> gap: 0.006;
    property <float> span: max(0, root.sweep - root.gap);
    property <float> finish: root.start + root.span;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: root.tint;
        visible: root.span > 0;

        MoveTo {
            x: 50 + root.outer * sin(root.start * 360deg);
            y: 50 - root.outer * cos(root.start * 360deg);
        }

        ArcTo {
            radius-x: root.outer;
            radius-y: root.outer;
            x: 50 + root.outer * sin(root.finish * 360deg);
            y: 50 - root.outer * cos(root.finish * 360deg);
            sweep: true;
            large-arc: root.span > 0.5;
        }

        LineTo {
            x: 50 + root.inner * sin(root.finish * 360deg);
            y: 50 - root.inner * cos(root.finish * 360deg);
        }

        ArcTo {
            radius-x: root.inner;
            radius-y: root.inner;
            x: 50 + root.inner * sin(root.start * 360deg);
            y: 50 - root.inner * cos(root.start * 360deg);
            sweep: false;
            large-arc: root.span > 0.5;
        }

        LineTo {
            x: 50 + root.outer * sin(root.start * 360deg);
            y: 50 - root.outer * cos(root.start * 360deg);
        }
    }
}

/// One line of the legend: the colour, what it counts, and how many.
///
/// The whole row is the target rather than the number alone — a count that
/// opens a list is worth the width of its own name to click.
component Reading inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <color> tint;
    callback clicked;

    height: 30px;
    border-radius: Shape.small;
    background: touch.has-hover ? MaterialPalette.surface-container-high : transparent;

    HorizontalLayout {
        padding-left: Spacing.small;
        padding-right: Spacing.small;
        spacing: Spacing.small;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.tint;
            }
        }

        Text {
            text: root.label;
            color: MaterialPalette.on-surface;
            font-size: Typography.body-medium-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: root.value;
            color: MaterialPalette.on-surface;
            font-size: Typography.body-medium-size;
            font-weight: Typography.body-medium-weight-em;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A label and a number on one line.
component Stat2 inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;

    spacing: Spacing.small;

    Text {
        text: root.label + ":";
        color: MaterialPalette.on-surface-variant;
        font-size: Typography.body-medium-size;
    }

    Text {
        text: root.value;
        color: MaterialPalette.on-surface;
        font-size: Typography.body-medium-size;
        font-weight: Typography.body-medium-weight-em;
        horizontal-stretch: 1;
    }
}

/// Episodes per day as bars, the count over each bar and the day under it.
///
/// Scaled to the busiest day shown, so the shape of the week reads whatever
/// its size; a day with none keeps a stub, so it reads as a day with none
/// rather than as a gap.
component Bars inherits HorizontalLayout {
    in property <[int]> values;
    in property <[int]> days;

    property <int> most: root.biggest();
    property <length> tallest: 96px;

    spacing: Spacing.small;
    height: root.tallest + 44px;

    for value[i] in root.values: VerticalLayout {
        horizontal-stretch: 1;
        alignment: end;
        spacing: Spacing.tight;

        Text {
            text: value;
            color: MaterialPalette.on-surface;
            font-size: Typography.label-medium-size;
            horizontal-alignment: center;
        }

        Rectangle {
            height: max(6px, root.tallest * value / max(1, root.most));
            border-radius: Shape.small;
            background: value > 0 ? MaterialPalette.primary : MaterialPalette.surface-container-highest;
        }

        Text {
            text: i < root.days.length ? root.days[i] : "";
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.label-small-size;
            horizontal-alignment: center;
        }
    }

    /// The largest value, by hand: Slint has no max over a model. Eight days
    /// at most, which this unrolls.
    pure function biggest() -> int {
        max(
            max(root.at(0), root.at(1), root.at(2), root.at(3)),
            max(root.at(4), root.at(5), root.at(6), root.at(7)),
        )
    }

    pure function at(i: int) -> int {
        i < root.values.length ? root.values[i] : 0
    }
}

/// One number, with what it counts under it.
///
/// A card rather than a plain box when it leads somewhere: the state layer a
/// card draws under its children is what says it can be pressed, and the two
/// pieces of text on top of it are transparent enough to let that through.
component Stat inherits Rectangle {
    in property <string> label;
    in property <int> value;
    /// Whether clicking it goes anywhere.
    in property <bool> opens: false;
    callback clicked;

    min-width: 72px;
    horizontal-stretch: 1;
    height: 76px;
    background: transparent;

    // Told to fill its box. A card sitting in a plain rectangle takes the size
    // of what is written on it otherwise, and a row of them then has one gap
    // per word length.
    FilledCard {
        width: 100%;
        height: 100%;
        clickable: root.opens;
        clicked => { root.clicked(); }

        VerticalLayout {
            padding: Spacing.medium;
            spacing: Spacing.hair;
            alignment: center;

            Text {
                text: root.value;
                color: MaterialPalette.on-surface;
                font-size: Typography.headline-small-size;
                font-weight: Typography.headline-small-weight;
            }

            Text {
                text: root.label;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
                overflow: elide;
            }
        }
    }
}

/// The account's people and its recent viewing: beside the overview on a
/// wide window, under it on a narrow one.
component ProfileSide inherits VerticalLayout {
    in property <bool> signed-in;
    in property <bool> mine;
    in property <int> friend-count;
    in property <int> vote-count;
    in property <int> comment-count;
    in property <int> collection-count;
    in property <[PersonItem]> friends;
    in property <[PersonItem]> requests;
    in property <[HistoryItem]> recent;
    callback open-friend(int);
    callback open-request(int);
    callback answer-request(int, bool);
    callback open-recent(int);
    callback remove-recent(int);

    spacing: Spacing.base;
    alignment: start;

    // Counts of things this client has no screen for, so they are under a
    // heading of their own rather than among lists that open. They are still
    // the account's own measure of itself.
    if root.signed-in: VerticalLayout {
        spacing: Spacing.small;

        Text {
            text: Tr.activity;
            color: MaterialPalette.on-surface;
            font-size: Typography.title-medium-size;
            font-weight: Typography.title-medium-weight-em;
        }

        HorizontalLayout {
            spacing: Spacing.small;

            Stat { label: Tr.votes; value: root.vote-count; }
            Stat { label: Tr.comments; value: root.comment-count; }
            Stat { label: Tr.collections; value: root.collection-count; }
            Stat { label: Tr.friends; value: root.friend-count; }
        }
    }

    // ---- friends, and requests waiting --------------------------------
    if root.signed-in && (root.friends.length > 0 || (root.mine && root.requests.length > 0)): VerticalLayout {
        spacing: Spacing.small;

        if root.mine && root.requests.length > 0: VerticalLayout {
            spacing: Spacing.small;

            Text {
                text: Tr.friend-requests;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
            }

            for person[i] in root.requests: HorizontalLayout {
                spacing: Spacing.medium;
                max-width: 560px;

                PersonChip {
                    horizontal-stretch: 1;
                    person: person;
                    clicked => { root.open-request(i); }
                }

                VerticalLayout {
                    alignment: center;
                    FilledButton {
                        text: Tr.accept-friend;
                        clicked => { root.answer-request(i, true); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TextButton {
                        text: Tr.decline;
                        clicked => { root.answer-request(i, false); }
                    }
                }
            }
        }

        if root.friends.length > 0: VerticalLayout {
            spacing: Spacing.small;

            Text {
                text: Tr.friends + " · " + root.friend-count;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
            }

            FlexboxLayout {
                flex-wrap: wrap;
                alignment: start;
                spacing: Spacing.small;

                for person[i] in root.friends: PersonChip {
                    width: 200px;
                    person: person;
                    clicked => { root.open-friend(i); }
                }
            }
        }
    }

    // ---- what was watched lately -------------------------------------
    //
    // The same list the history tab holds, cut to what fits here. It is on
    // this screen because it is the answer to "where was I", and that is
    // the question an account is opened with.
    if root.signed-in && root.mine: VerticalLayout {
        spacing: Spacing.small;

        Text {
            text: Tr.recently-watched;
            color: MaterialPalette.on-surface;
            font-size: Typography.title-medium-size;
            font-weight: Typography.title-medium-weight-em;
        }

        if root.recent.length == 0: Text {
            text: Tr.nothing-watched;
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.body-medium-size;
        }

        for item[index] in root.recent: Rectangle {
            height: 64px;
            border-radius: Shape.medium;
            background: row-touch.has-hover || remove.has-hover
                ? MaterialPalette.surface-container
                : transparent;

            HorizontalLayout {
                padding-left: Spacing.small;
                padding-right: Spacing.base;
                spacing: Spacing.medium;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 36px;
                        height: 52px;
                        border-radius: Shape.small;
                        background: MaterialPalette.surface-container-high;
                        clip: true;

                        Image {
                            source: item.poster;
                            image-fit: cover;
                            width: 100%;
                            height: 100%;
                            visible: item.poster-loaded;
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: Spacing.hair;

                    Text {
                        text: item.title;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.body-large-size;
                        overflow: elide;
                    }

                    Text {
                        text: item.episode > 0
                            ? Tr.episode-of(item.episode) + " · " + Tr.ago(item.minutes-ago)
                            : Tr.ago(item.minutes-ago);
                        color: MaterialPalette.on-surface-variant;
                        font-size: Typography.label-medium-size;
                        overflow: elide;
                    }
                }

                // Taking a release out of the history is the official
                // client's long-press; on a desktop it is a button that
                // shows under the pointer.
                Rectangle {
                    width: 40px;

                    if row-touch.has-hover || remove.has-hover: VerticalLayout {
                        alignment: center;

                        IconButton {
                            icon: @image-url("../icons/close.svg");
                            tooltip: Tr.remove-from-history;
                            clicked => { root.remove-recent(index); }
                        }
                    }

                    remove := TouchArea {
                        z: -1;
                    }
                }
            }

            // Beneath the remove button, so the button gets its click.
            row-touch := TouchArea {
                z: -1;
                mouse-cursor: pointer;
                clicked => { root.open-recent(index); }
            }
        }
    }

}

export component ProfilePage inherits Rectangle {
    in property <bool> signed-in: false;
    /// Whether this is the account's own profile or someone else's. Someone
    /// else's leaves out what is the account's alone: its history, its
    /// settings, signing out.
    in property <bool> mine: true;
    /// One column rather than two.
    in property <bool> narrow: false;
    in property <[PersonItem]> friends: [];
    in property <[PersonItem]> requests: [];
    callback back-to-mine();
    /// The profile was opened from another screen, and can go back to it.
    in property <bool> can-go-back: false;
    callback go-back();
    callback friend-action();
    callback toggle-block();
    callback report();
    callback open-friend(int);
    callback open-request(int);
    callback answer-request(int, bool);
    in property <Account> account;
    in property <image> avatar;
    in property <bool> avatar-loaded: false;

    callback sign-in();
    callback open-settings();
    /// One of the account's own lists, by its place in the bookmarks tabs.
    callback open-list(int);
    in property <[HistoryItem]> recent: [];
    callback open-recent(int);
    callback remove-recent(int);

    // One colour per list, shared by the ring and the legend beside it — the
    // legend is only readable because the two agree. The scheme is one family
    // of violets, so the five are pulled apart by lightness and by the two
    // accents it does have rather than by five hues it does not.
    property <color> watching-colour: MaterialPalette.tertiary;
    property <color> planned-colour: MaterialPalette.secondary;
    property <color> watched-colour: MaterialPalette.inverse-primary;
    property <color> hold-colour: MaterialPalette.outline;
    property <color> dropped-colour: MaterialPalette.error;

    /// What the five add up to, and never zero: a ring divides by it.
    property <int> total: max(1, root.account.watching + root.account.planned
        + root.account.watched + root.account.hold + root.account.dropped);

    background: MaterialPalette.surface;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    // The page is longer than most windows once the lists, friends and
    // settings are on it, so it scrolls as one.
    ScrollView {
        width: 100%;
        height: 100%;

    page := VerticalLayout {
        padding: Spacing.base;
        spacing: Spacing.base;
        alignment: start;

        if !root.mine: HorizontalLayout {
            alignment: start;
            spacing: Spacing.small;

            // Back where the profile was opened from, when it was opened
            // from somewhere — a comment, a release.
            if root.can-go-back: TextButton {
                icon: @image-url("../icons/back.svg");
                text: Tr.back;
                clicked => { root.go-back(); }
            }

            TextButton {
                icon: root.can-go-back ? @image-url("../icons/person.svg") : @image-url("../icons/back.svg");
                text: Tr.my-profile;
                clicked => { root.back-to-mine(); }
            }
        }

        // ---- who ---------------------------------------------------------
        HorizontalLayout {
            spacing: Spacing.base;

            // The avatar is the account's own picture once it arrives, and a
            // filled circle until then — never a gap that fills in later and
            // moves everything sideways.
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: self.width / 2;
                background: MaterialPalette.primary-container;
                clip: true;

                Image {
                    source: root.avatar;
                    image-fit: cover;
                    width: 100%;
                    height: 100%;
                    visible: root.signed-in && root.avatar-loaded;
                }

                Image {
                    source: @image-url("../icons/person.svg");
                    colorize: MaterialPalette.on-primary-container;
                    width: 34px;
                    height: 34px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    visible: !root.signed-in || !root.avatar-loaded;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: Spacing.hair;

                HorizontalLayout {
                    spacing: Spacing.small;
                    alignment: start;

                    Text {
                        text: root.signed-in ? root.account.login : Tr.signed-out;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.title-large-size;
                        font-weight: Typography.title-large-weight-em;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.signed-in && root.account.verified: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: badge.preferred-width + Spacing.medium;
                        border-radius: Shape.small;
                        background: MaterialPalette.secondary-container;

                        badge := Text {
                            text: Tr.verified;
                            color: MaterialPalette.on-secondary-container;
                            font-size: Typography.label-small-size;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }

                if root.signed-in && root.account.status != "": Text {
                    text: root.account.status;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.body-medium-size;
                    overflow: elide;
                }

                Text {
                    text: root.signed-in
                        ? (root.account.registered != ""
                            ? Tr.registered + " " + root.account.registered
                            : "")
                        : Tr.sign-in-to-profile;
                    color: MaterialPalette.on-surface-variant;
                    font-size: Typography.body-medium-size;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: center;

                // Signing in is the offer; signing out is the retreat from it.
                // Material spells that difference with the button, which is
                // why the two are not the same one with a different word in.
                if !root.signed-in: FilledButton {
                    text: Tr.sign-in;
                    clicked => { root.sign-in(); }
                }

                // Picture and status are the profile's own; everything else
                // that can be set, and signing out, is under Settings.
                if root.signed-in && root.mine: TonalButton {
                    text: Tr.edit-profile;
                    clicked => { root.open-settings(); }
                }

                // Someone else's: the one friend button, saying what it will
                // do — the standing between the two decides — and a block.
                if root.signed-in && !root.mine: HorizontalLayout {
                    spacing: Spacing.small;

                    if !root.account.blocked: FilledButton {
                        text: root.account.friend-status == 2 ? Tr.unfriend
                            : root.account.friend-status == 1 ? Tr.accept-friend
                            : root.account.friend-status == 0 ? Tr.cancel-request
                            : Tr.add-friend;
                        enabled: root.account.friend-status >= 0 || !root.account.friend-requests-closed;
                        clicked => { root.friend-action(); }
                    }

                    OutlineButton {
                        text: root.account.blocked ? Tr.unblock : Tr.block;
                        clicked => { root.toggle-block(); }
                    }

                    IconButton {
                        icon: @image-url("../icons/flag.svg");
                        tooltip: Tr.report;
                        clicked => { root.report(); }
                    }
                }
            }
        }

        // Two columns on a wide window — the account as figures on the left,
        // its people and its viewing on the right — and one under the other
        // on a narrow one.
        HorizontalLayout {
            spacing: Spacing.comfortable;

            VerticalLayout {
                horizontal-stretch: 3;
                spacing: Spacing.base;
                alignment: start;

            // ---- what is in the lists ----------------------------------------
            //
            // Only with an account behind them. Five zeroes state nothing except
            // that nobody is signed in, which the line above already said.
            //
            // A ring beside the numbers, because the question the numbers answer
            // is what the account's viewing looks like as a whole, and a
            // proportion is a shape before it is a figure.
            if root.signed-in: VerticalLayout {
                spacing: Spacing.base;

                VerticalLayout {
                    spacing: Spacing.small;

                    Text {
                        text: Tr.lists;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                    }

                    // As wide as it needs to be and no wider: a legend of five
                    // short lines stretched across a desktop window puts each
                    // number half a screen from the word it belongs to.
                    HorizontalLayout {

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 188px;
                        border-radius: Shape.large;
                        background: MaterialPalette.surface-container;

                        HorizontalLayout {
                            padding: Spacing.base;
                            spacing: Spacing.base;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                max-width: 300px;
                                alignment: center;
                                spacing: Spacing.hair;

                                Reading {
                                    label: Tr.list-watching;
                                    value: root.account.watching;
                                    tint: root.watching-colour;
                                    clicked => { if (root.mine) { root.open-list(0); } }
                                }

                                Reading {
                                    label: Tr.list-planned;
                                    value: root.account.planned;
                                    tint: root.planned-colour;
                                    clicked => { if (root.mine) { root.open-list(1); } }
                                }

                                Reading {
                                    label: Tr.list-watched;
                                    value: root.account.watched;
                                    tint: root.watched-colour;
                                    clicked => { if (root.mine) { root.open-list(2); } }
                                }

                                Reading {
                                    label: Tr.list-hold;
                                    value: root.account.hold;
                                    tint: root.hold-colour;
                                    clicked => { if (root.mine) { root.open-list(3); } }
                                }

                                Reading {
                                    label: Tr.list-dropped;
                                    value: root.account.dropped;
                                    tint: root.dropped-colour;
                                    clicked => { if (root.mine) { root.open-list(4); } }
                                }
                            }

                            // The ring itself, and in its hole the number the five
                            // add up to: a total is what a reader works out from a
                            // ring otherwise, and works out wrong.
                            Rectangle { horizontal-stretch: 1; }

                            Rectangle {
                                width: 156px;

                                Wedge {
                                    width: 100%;
                                    height: 100%;
                                    start: 0;
                                    sweep: root.account.watching / root.total;
                                    tint: root.watching-colour;
                                }

                                Wedge {
                                    width: 100%;
                                    height: 100%;
                                    start: root.account.watching / root.total;
                                    sweep: root.account.planned / root.total;
                                    tint: root.planned-colour;
                                }

                                Wedge {
                                    width: 100%;
                                    height: 100%;
                                    start: (root.account.watching + root.account.planned) / root.total;
                                    sweep: root.account.watched / root.total;
                                    tint: root.watched-colour;
                                }

                                Wedge {
                                    width: 100%;
                                    height: 100%;
                                    start: (root.account.watching + root.account.planned
                                        + root.account.watched) / root.total;
                                    sweep: root.account.hold / root.total;
                                    tint: root.hold-colour;
                                }

                                Wedge {
                                    width: 100%;
                                    height: 100%;
                                    start: (root.account.watching + root.account.planned
                                        + root.account.watched + root.account.hold) / root.total;
                                    sweep: root.account.dropped / root.total;
                                    tint: root.dropped-colour;
                                }

                                VerticalLayout {
                                    alignment: center;

                                    Text {
                                        text: root.total;
                                        color: MaterialPalette.on-surface;
                                        font-size: Typography.headline-small-size;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: Tr.releases-total;
                                        color: MaterialPalette.on-surface-variant;
                                        font-size: Typography.label-small-size;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    }
                }

                // ---- statistics ------------------------------------------------
                //
                // What the account watches and how much, as the official profile
                // shows it: shares by genre, audience and theme, two totals, and
                // the last days as bars. Hidden accounts say so instead.
                VerticalLayout {
                    spacing: Spacing.small;

                    Text {
                        text: Tr.statistics;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.title-medium-size;
                        font-weight: Typography.title-medium-weight-em;
                    }

                    if root.account.stats-hidden: Text {
                        text: Tr.stats-hidden;
                        color: MaterialPalette.on-surface-variant;
                        font-size: Typography.body-medium-size;
                    }

                    if !root.account.stats-hidden: HorizontalLayout {

                        Rectangle {
                            horizontal-stretch: 1;
                            height: stats.preferred-height;
                            border-radius: Shape.large;
                            background: MaterialPalette.surface-container;

                            stats := VerticalLayout {
                                padding: Spacing.base;
                                spacing: Spacing.tight;

                                for row in [
                                    { label: Tr.stat-genres, value: root.account.genres },
                                    { label: Tr.stat-audiences, value: root.account.audiences },
                                    { label: Tr.stat-themes, value: root.account.themes },
                                ]: HorizontalLayout {
                                    spacing: Spacing.small;
                                    // A share the account has none of takes no
                                    // line, rather than a label with nothing by it.
                                    visible: row.value != "";
                                    height: row.value != "" ? self.preferred-height : 0px;

                                    Text {
                                        text: row.label + ":";
                                        color: MaterialPalette.on-surface;
                                        font-size: Typography.body-medium-size;
                                        font-weight: Typography.body-medium-weight-em;
                                    }

                                    Text {
                                        text: row.value;
                                        color: MaterialPalette.on-surface;
                                        font-size: Typography.body-medium-size;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                Rectangle { height: Spacing.small; }

                                Stat2 {
                                    label: Tr.stat-episodes;
                                    value: root.account.episodes-watched;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.small;

                                    Text {
                                        text: Tr.stat-time + ":";
                                        color: MaterialPalette.on-surface-variant;
                                        font-size: Typography.body-medium-size;
                                    }

                                    Text {
                                        text: Tr.duration(root.account.minutes-watched);
                                        color: MaterialPalette.on-surface;
                                        font-size: Typography.body-medium-size;
                                        font-weight: Typography.body-medium-weight-em;
                                        horizontal-stretch: 1;
                                    }
                                }

                                if root.account.dynamics.length > 0: VerticalLayout {
                                    padding-top: Spacing.base;
                                    spacing: Spacing.small;

                                    Text {
                                        text: Tr.stat-dynamics;
                                        color: MaterialPalette.on-surface;
                                        font-size: Typography.title-small-size;
                                        font-weight: Typography.title-small-weight-em;
                                    }

                                    Bars {
                                        values: root.account.dynamics;
                                        days: root.account.dynamics-days;
                                    }
                                }
                            }
                        }
                    }
                }

            }
            }

            if !root.narrow && root.signed-in: ProfileSide {
                    horizontal-stretch: 2;
                    signed-in: root.signed-in;
                    mine: root.mine;
                    friend-count: root.account.friends;
                    vote-count: root.account.votes;
                    comment-count: root.account.comments;
                    collection-count: root.account.collections;
                    friends: root.friends;
                    requests: root.requests;
                    recent: root.recent;
                    open-friend(i) => { root.open-friend(i); }
                    open-request(i) => { root.open-request(i); }
                    answer-request(i, yes) => { root.answer-request(i, yes); }
                    open-recent(i) => { root.open-recent(i); }
                    remove-recent(i) => { root.remove-recent(i); }
                }
        }

        if root.narrow && root.signed-in: ProfileSide {
            signed-in: root.signed-in;
            mine: root.mine;
            friend-count: root.account.friends;
            vote-count: root.account.votes;
            comment-count: root.account.comments;
            collection-count: root.account.collections;
            friends: root.friends;
            requests: root.requests;
            recent: root.recent;
            open-friend(i) => { root.open-friend(i); }
            open-request(i) => { root.open-request(i); }
            answer-request(i, yes) => { root.answer-request(i, yes); }
            open-recent(i) => { root.open-recent(i); }
            remove-recent(i) => { root.remove-recent(i); }
    }
    }
    }
}
