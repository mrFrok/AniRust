// SPDX-License-Identifier: GPL-3.0-or-later
//
// Finding something to watch.
//
// One page behind every destination on the rail: a search field, a row of tabs,
// an optional row of genres, and a wall of posters. What the tabs are called
// and what they fetch is the window's business — this only says which is
// selected.
//
// The wall is a `FlexboxLayout`, which wraps to the next row on its own: the
// cards never have to know how many fit across, and nothing has to read the
// width it is being given to work it out.

import { ScrollView } from "std-widgets.slint";
import { MaterialPalette, SecondaryTabBar, FilterChip, NavigationItem, OutlineButton, CircularProgressIndicator } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { ReleaseCard } from "../structs.slint";
import { PosterCard } from "../components/release-cards.slint";

/// A genre, as one of a row where exactly one of them is chosen.
///
/// A filter chip owns its checked state and flips it on a click, which is a
/// toggle; this row is a choice. So the chip is put back to what the app says
/// after every click: picking the chosen one again leaves it chosen, and
/// picking another clears it because the app says so.
component GenreChip inherits FilterChip {
    in property <bool> selected;
    callback picked();

    init => { self.checked = root.selected; }
    changed selected => { self.checked = root.selected; }
    changed checked => {
        if (self.checked == root.selected) { return; }
        if (self.checked) { root.picked(); }
        self.checked = root.selected;
    }
}

export component HomePage inherits Rectangle {
    in property <[ReleaseCard]> results;
    /// Whether the grid is showing search results rather than a tab.
    in property <bool> searching: false;
    in property <bool> loading: false;
    in-out property <string> query;
    /// The tabs of the current destination, and which is selected.
    in property <[NavigationItem]> tabs: [];
    in property <int> tab: 0;
    /// Genre names the catalogue knows, supplied by Rust because they are data
    /// rather than interface text. Index 0 of the chip row is "all", which is
    /// not one of them. Empty everywhere but the catalogue.
    in property <[string]> genres: [];
    in property <int> genre: 0;
    /// Shown instead of the grid when there is a reason it is empty.
    in property <string> notice;
    in property <bool> signed-in: false;
    in property <string> account-name;

    callback search(string);
    callback open-release(int);
    callback sign-in();
    callback sign-out();
    callback select-tab(int);
    /// 0 means every genre.
    callback select-genre(int);

    background: MaterialPalette.surface;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    property <length> card-width: 160px;
    property <length> card-height: 280px;
    property <length> gutter: Spacing.base;

    VerticalLayout {
        // ---- search ------------------------------------------------------
        Rectangle {
            height: 72px;
            background: MaterialPalette.surface-container;
            // Painted after its siblings, so that what hangs below it — the
            // account button's tooltip — is not drawn over by the tabs and
            // the genres, which come after it in the column.
            z: 1;

            HorizontalLayout {
                padding-left: Spacing.base;
                padding-right: Spacing.base;
                spacing: Spacing.base;

                Text {
                    text: "AniRust";
                    color: MaterialPalette.primary;
                    font-size: Typography.title-large-size;
                    font-weight: Typography.title-large-weight-em;
                    vertical-alignment: center;
                }

                field := Rectangle {
                    horizontal-stretch: 1;
                    height: Spacing.touch-target;
                    y: (parent.height - self.height) / 2;
                    border-radius: Shape.pill;
                    background: MaterialPalette.surface-container-highest;
                    border-width: input.has-focus ? 1px : 0px;
                    border-color: MaterialPalette.primary;

                    HorizontalLayout {
                        padding-left: Spacing.base;
                        padding-right: Spacing.base;
                        spacing: Spacing.small;

                        // In its own box, because a fixed-size image in a
                        // row sits at the top of it rather than on the row's
                        // centre line.
                        Rectangle {
                            width: 18px;
                            background: transparent;

                            Image {
                                source: @image-url("../icons/search.svg");
                                colorize: MaterialPalette.on-surface-variant;
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            if root.query == "" && !input.has-focus: Text {
                                text: Tr.search-hint;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-large-size;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            input := TextInput {
                                text <=> root.query;
                                color: MaterialPalette.on-surface;
                                font-size: Typography.body-large-size;
                                vertical-alignment: center;
                                single-line: true;
                                width: 100%;
                                height: 100%;
                                accepted => { root.search(self.text); }
                            }
                        }
                    }
                }

                // Signed in, the name is the control, and what clicking it
                // does is in its tooltip. A menu for a single item is a menu
                // nobody wants.
                VerticalLayout {
                    alignment: center;

                    OutlineButton {
                        text: root.signed-in ? root.account-name : Tr.sign-in;
                        tooltip: root.signed-in ? Tr.sign-out : "";

                        clicked => {
                            if (root.signed-in) { root.sign-out(); } else { root.sign-in(); }
                        }
                    }
                }
            }
        }

        // ---- tabs --------------------------------------------------------
        //
        // Hidden while searching: the tabs name a part of the catalogue, and a
        // search is not one of them.
        if !root.searching && root.tabs.length > 0: HorizontalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;

            // Stretched across the page, which is what divides the width
            // evenly between the tabs: the bar draws its indicator under one
            // such division, so an indicator only lines up with its label
            // when the bar has the room the labels were divided from.
            SecondaryTabBar {
                items: root.tabs;
                horizontal-stretch: 1;

                // Pushed, not bound: the bar writes its own index on a click,
                // and Rust decides which tab a destination opens on.
                property <int> wanted: root.tab;
                init => { self.current-index = root.tab; }
                changed wanted => { self.current-index = self.wanted; }

                index-changed(i) => { root.select-tab(i); }
            }
        }

        // Wrapped rather than scrolled sideways: nineteen chips do not fit on
        // one line of any window, and a row that runs off the edge hides half
        // the filter.
        if !root.searching && root.genres.length > 0: FlexboxLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            flex-wrap: wrap;
            alignment: start;
            spacing: Spacing.small;
            padding-bottom: Spacing.small;

            GenreChip {
                text: Tr.all-genres;
                selected: root.genre == 0;
                picked => { root.select-genre(0); }
            }

            for name[index] in root.genres: GenreChip {
                text: name;
                selected: index + 1 == root.genre;
                picked => { root.select-genre(index + 1); }
            }
        }

        // ---- results -----------------------------------------------------
        // A line over the grid: what it is showing, and whether more of it is
        // still coming. Loading is only ever said here while there is already
        // something underneath — a tab being switched keeps the last one's
        // cards until the new ones arrive. With nothing underneath, the
        // indicator in the middle says it instead, and saying it in both
        // places at once says it worse than either.
        if root.searching || (root.loading && root.results.length > 0): HorizontalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            padding-top: Spacing.small;
            spacing: Spacing.small;

            Text {
                text: root.searching ? Tr.search-results : Tr.loading;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
                horizontal-stretch: 1;
            }

            if root.searching && root.loading && root.results.length > 0: Text {
                text: Tr.loading;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
                vertical-alignment: center;
            }
        }

        // Loading, with nothing yet to show under it.
        if root.loading && root.results.length == 0: HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;

            VerticalLayout {
                alignment: center;

                // Sized here rather than left to itself: the indicator keeps
                // itself round by binding its width to its height, and a
                // layout that has to measure one from the other measures in a
                // circle.
                CircularProgressIndicator {
                    indeterminate: true;
                    width: 48px;
                    height: 48px;
                }
            }
        }

        if !root.loading && root.results.length == 0: Text {
            text: root.notice != ""
                ? root.notice
                : (root.searching ? Tr.nothing-found : Tr.nothing-here);
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.body-large-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if root.results.length > 0: ScrollView {
            vertical-stretch: 1;
            content-height: wall.preferred-height;

            wall := FlexboxLayout {
                y: root.gutter;
                width: 100%;
                padding-left: Spacing.base;
                padding-right: Spacing.base;
                flex-wrap: wrap;
                alignment: start;
                spacing: root.gutter;

                for card[index] in root.results: PosterCard {
                    card: card;
                    width: root.card-width;
                    height: root.card-height;
                    clicked => { root.open-release(index); }
                }
            }
        }
    }
}
