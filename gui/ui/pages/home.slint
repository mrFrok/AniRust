// SPDX-License-Identifier: GPL-3.0-or-later
//
// Finding something to watch.
//
// One page behind every destination on the rail: a search field, a row of tabs,
// an optional row of genres, and a wall of posters. What the tabs are called
// and what they fetch is the window's business — this only says which is
// selected.
//
// The wall is a `FlexboxLayout`, which wraps to the next row on its own: the
// cards never have to know how many fit across, and nothing has to read the
// width it is being given to work it out.

import { ScrollView } from "std-widgets.slint";
import { MaterialPalette } from "../globals/material-palette.slint";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing, Motion } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { ReleaseCard } from "../structs.slint";
import { PosterCard, Chip, Tab } from "../components/release-cards.slint";

export component HomePage inherits Rectangle {
    in property <[ReleaseCard]> results;
    /// Whether the grid is showing search results rather than a tab.
    in property <bool> searching: false;
    in property <bool> loading: false;
    in-out property <string> query;
    /// The tabs of the current destination, and which is selected.
    in property <[string]> tabs: [];
    in property <int> tab: 0;
    /// Genre names the catalogue knows, supplied by Rust because they are data
    /// rather than interface text. Index 0 of the chip row is "all", which is
    /// not one of them. Empty everywhere but the catalogue.
    in property <[string]> genres: [];
    in property <int> genre: 0;
    /// Shown instead of the grid when there is a reason it is empty.
    in property <string> notice;
    in property <bool> signed-in: false;
    in property <string> account-name;

    callback search(string);
    callback open-release(int);
    callback sign-in();
    callback sign-out();
    callback select-tab(int);
    /// 0 means every genre.
    callback select-genre(int);

    background: MaterialPalette.surface;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    property <length> card-width: 160px;
    property <length> card-height: 280px;
    property <length> gutter: Spacing.base;

    VerticalLayout {
        // ---- search ------------------------------------------------------
        Rectangle {
            height: 72px;
            background: MaterialPalette.surface-container;

            HorizontalLayout {
                padding-left: Spacing.base;
                padding-right: Spacing.base;
                spacing: Spacing.base;

                Text {
                    text: "AniRust";
                    color: MaterialPalette.primary;
                    font-size: Typography.title-large-size;
                    font-weight: Typography.title-large-weight-em;
                    vertical-alignment: center;
                }

                field := Rectangle {
                    horizontal-stretch: 1;
                    height: Spacing.touch-target;
                    y: (parent.height - self.height) / 2;
                    border-radius: Shape.pill;
                    background: MaterialPalette.surface-container-highest;
                    border-width: input.has-focus ? 1px : 0px;
                    border-color: MaterialPalette.primary;

                    HorizontalLayout {
                        padding-left: Spacing.base;
                        padding-right: Spacing.base;
                        spacing: Spacing.small;

                        // In its own box, because a fixed-size image in a
                        // row sits at the top of it rather than on the row's
                        // centre line.
                        Rectangle {
                            width: 18px;
                            background: transparent;

                            Image {
                                source: @image-url("../icons/search.svg");
                                colorize: MaterialPalette.on-surface-variant;
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            if root.query == "" && !input.has-focus: Text {
                                text: Tr.search-hint;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-large-size;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            input := TextInput {
                                text <=> root.query;
                                color: MaterialPalette.on-surface;
                                font-size: Typography.body-large-size;
                                vertical-alignment: center;
                                single-line: true;
                                width: 100%;
                                height: 100%;
                                accepted => { root.search(self.text); }
                            }
                        }
                    }
                }

                // Signed in, the name is the control: hovering it offers the
                // one action there is. A menu for a single item is a menu
                // nobody wants.
                account := Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: Spacing.touch-target;
                    width: account-label.preferred-width + 2 * Spacing.base;
                    border-radius: Shape.pill;
                    background: account-touch.has-hover
                        ? MaterialPalette.surface-container-highest
                        : transparent;
                    border-width: 1px;
                    border-color: MaterialPalette.outline-variant;

                    account-label := Text {
                        text: root.signed-in
                            ? (account-touch.has-hover ? Tr.sign-out : root.account-name)
                            : Tr.sign-in;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.label-large-size;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    account-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.signed-in) { root.sign-out(); } else { root.sign-in(); }
                        }
                    }
                }
            }
        }

        // ---- tabs --------------------------------------------------------
        //
        // Hidden while searching: the tabs name a part of the catalogue, and a
        // search is not one of them.
        if !root.searching && root.tabs.length > 0: Rectangle {
            height: 48px;
            background: transparent;

            HorizontalLayout {
                padding-left: Spacing.base;
                padding-right: Spacing.base;
                spacing: Spacing.comfortable;
                alignment: start;

                for name[index] in root.tabs: Tab {
                    label: name;
                    selected: index == root.tab;
                    clicked => { root.select-tab(index); }
                }
            }
        }

        // Wrapped rather than scrolled sideways: nineteen chips do not fit on
        // one line of any window, and a row that runs off the edge hides half
        // the filter.
        if !root.searching && root.genres.length > 0: FlexboxLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            flex-wrap: wrap;
            alignment: start;
            spacing: Spacing.small;
            padding-bottom: Spacing.small;

            Chip {
                label: Tr.all-genres;
                small: true;
                selected: root.genre == 0;
                clicked => { root.select-genre(0); }
            }

            for name[index] in root.genres: Chip {
                label: name;
                small: true;
                selected: index + 1 == root.genre;
                clicked => { root.select-genre(index + 1); }
            }
        }

        // ---- results -----------------------------------------------------
        if root.searching || root.loading: HorizontalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            padding-top: Spacing.small;
            spacing: Spacing.small;

            Text {
                text: root.searching ? Tr.search-results : "";
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
                horizontal-stretch: 1;
            }

            if root.loading: Text {
                text: Tr.loading;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
                vertical-alignment: center;
            }
        }

        if !root.loading && root.results.length == 0: Text {
            text: root.notice != ""
                ? root.notice
                : (root.searching ? Tr.nothing-found : Tr.nothing-here);
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.body-large-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if root.results.length > 0: ScrollView {
            vertical-stretch: 1;
            content-height: wall.preferred-height;

            wall := FlexboxLayout {
                y: root.gutter;
                width: 100%;
                padding-left: Spacing.base;
                padding-right: Spacing.base;
                flex-wrap: wrap;
                alignment: start;
                spacing: root.gutter;

                for card[index] in root.results: PosterCard {
                    card: card;
                    width: root.card-width;
                    height: root.card-height;
                    clicked => { root.open-release(index); }
                }
            }
        }
    }
}
