// SPDX-License-Identifier: GPL-3.0-or-later
//
// Finding something to watch.
//
// One page behind every destination on the rail: a search field, a row of tabs,
// an optional row of genres, and a wall of posters. What the tabs are called
// and what they fetch is the window's business — this only says which is
// selected.
//
// The wall is a `FlexboxLayout`, which wraps to the next row on its own: the
// cards never have to know how many fit across, and nothing has to read the
// width it is being given to work it out.

import { ScrollView } from "std-widgets.slint";
import { MaterialPalette, SecondaryTabBar, FilterChip, NavigationItem, OutlineButton, CircularProgressIndicator, IconButton, Badge, TextButton, TonalButton } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { ReleaseCard, CollectionItem, PersonItem } from "../structs.slint";
import { PersonChip } from "../components/person-chip.slint";
import { PosterCard } from "../components/release-cards.slint";

/// A genre, as one of a row where exactly one of them is chosen.
///
/// A filter chip owns its checked state and flips it on a click, which is a
/// toggle; this row is a choice. So the chip is put back to what the app says
/// after every click: picking the chosen one again leaves it chosen, and
/// picking another clears it because the app says so.
component GenreChip inherits FilterChip {
    in property <bool> selected;
    callback picked();

    init => { self.checked = root.selected; }
    changed selected => { self.checked = root.selected; }
    changed checked => {
        if (self.checked == root.selected) { return; }
        if (self.checked) { root.picked(); }
        self.checked = root.selected;
    }
}

/// A labelled row of people or channels, scrolled sideways.
component SearchRow inherits VerticalLayout {
    in property <string> label;
    in property <[PersonItem]> items;
    callback clicked(int);

    padding-left: Spacing.base;
    padding-right: Spacing.base;
    padding-top: Spacing.small;
    spacing: Spacing.tight;
    // Its own height and no more: the grid below is what takes the rest.
    vertical-stretch: 0;

    Text {
        text: root.label;
        color: MaterialPalette.on-surface-variant;
        font-size: Typography.label-large-size;
    }

    row := Flickable {
        min-height: 52px;
        max-height: 52px;
        vertical-stretch: 0;
        interactive: self.content-width > self.width;
        content-width: chips.preferred-width;

        chips := HorizontalLayout {
            height: 52px;
            spacing: Spacing.small;
            alignment: start;

            for item[index] in root.items: PersonChip {
                width: 240px;
                person: item;
                clicked => { root.clicked(index); }
            }
        }
    }
}

/// A collection's own page, over the releases in it.
component CollectionHeader inherits Rectangle {
    in property <CollectionItem> collection;
    in property <bool> signed-in: false;
    callback toggle-favourite();
    callback open-comments();
    callback open-creator();
    callback edit();
    callback report();
    callback sign-in();

    height: layout.preferred-height;
    border-radius: Shape.large;
    background: MaterialPalette.surface-container;

    layout := HorizontalLayout {
        padding: Spacing.base;
        spacing: Spacing.base;

        // Wide rather than tall: the service draws collection covers as
        // banners.
        Rectangle {
            width: 192px;
            height: 108px;
            border-radius: Shape.medium;
            background: MaterialPalette.surface-container-high;
            clip: true;

            Image {
                source: root.collection.image;
                image-fit: cover;
                width: 100%;
                height: 100%;
                visible: root.collection.image-loaded;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Spacing.hair;
            alignment: start;

            HorizontalLayout {
                spacing: Spacing.small;

                if root.collection.private: Image {
                    source: @image-url("../icons/lock.svg");
                    colorize: MaterialPalette.on-surface-variant;
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.collection.title;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.title-large-size;
                    font-weight: Typography.title-large-weight-em;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            creator := Text {
                text: Tr.by-author(root.collection.creator);
                color: MaterialPalette.primary;
                font-size: Typography.label-large-size;

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-creator(); }
                }
            }

            Text {
                text: Tr.favourited-label(root.collection.favourites);
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
            }

            if root.collection.description != "": Text {
                text: root.collection.description;
                color: MaterialPalette.on-surface;
                font-size: Typography.body-medium-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: start;
                spacing: Spacing.tight;
                padding-top: Spacing.small;

                IconButton {
                    icon: @image-url("../icons/heart.svg");
                    checked-icon: @image-url("../icons/heart-filled.svg");
                    checkable: true;
                    checked: root.collection.favourite;
                    tooltip: root.collection.favourite ? Tr.remove-from-favourites : Tr.add-to-favourites;
                    clicked => {
                        if (root.signed-in) { root.toggle-favourite(); } else { root.sign-in(); }
                    }
                }

                TextButton {
                    icon: @image-url("../icons/comment.svg");
                    text: root.collection.comments;
                    clicked => { root.open-comments(); }
                }

                if root.collection.mine: TextButton {
                    text: Tr.edit;
                    clicked => { root.edit(); }
                }

                if !root.collection.mine: TextButton {
                    icon: @image-url("../icons/flag.svg");
                    text: Tr.report;
                    clicked => { root.report(); }
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    in property <[ReleaseCard]> results;
    /// Whether the grid is showing search results rather than a tab.
    in property <bool> searching: false;
    in property <bool> loading: false;
    in-out property <string> query;
    /// The tabs of the current destination, and which is selected.
    in property <[NavigationItem]> tabs: [];
    in property <int> tab: 0;
    /// Genre names the catalogue knows, supplied by Rust because they are data
    /// rather than interface text. Index 0 of the chip row is "all", which is
    /// not one of them. Empty everywhere but the catalogue.
    in property <[string]> genres: [];
    in property <int> genre: 0;
    /// The chip row is days of the week on the schedule, genres elsewhere.
    in property <bool> chips-are-days: false;
    callback open-random();
    /// Shown instead of the grid when there is a reason it is empty.
    in property <string> notice;
    in property <bool> signed-in: false;
    in property <string> account-name;
    /// How many downloads are still going, for the badge on the button that
    /// opens the queue. Zero hides it: a badge that always shows is a decal.
    in property <int> downloads-working: 0;
    /// Unseen notifications, for the bell's badge. Only with an account.
    in property <int> unseen: 0;
    callback open-notifications();

    /// A collection open over the grid, which then holds its releases.
    in property <bool> collection-open: false;
    in property <CollectionItem> collection;
    /// The account's collections are on screen, so a new one can be made.
    in property <bool> can-create-collection: false;
    callback close-collection();
    callback toggle-collection-favourite();
    callback open-collection-comments();
    callback open-collection-creator();
    callback edit-collection();
    callback new-collection();
    callback report-collection();

    /// People and channels a search found beside the releases. Only a search
    /// of the whole catalogue looks for them.
    in property <bool> loading-more: false;
    /// Asked for when the grid is scrolled near its end.
    callback load-more();
    in property <[PersonItem]> found-people: [];
    in property <[PersonItem]> found-channels: [];
    callback open-found-person(int);
    callback open-found-channel(int);

    callback open-downloads();
    callback search(string);
    callback open-release(int);
    callback sign-in();
    callback sign-out();
    callback open-profile();
    callback select-tab(int);
    /// 0 means every genre.
    callback select-genre(int);

    background: MaterialPalette.surface;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    /// The narrowest a tab may be before the strip scrolls instead: room for
    /// the longest label the destinations have, "Смотрят сейчас".
    property <length> tab-width: 132px;

    property <length> card-width: 160px;
    property <length> card-height: 280px;
    property <length> gutter: Spacing.base;

    VerticalLayout {
        // ---- search ------------------------------------------------------
        Rectangle {
            height: 72px;
            background: MaterialPalette.surface-container;
            // Painted after its siblings, so that what hangs below it — the
            // account button's tooltip — is not drawn over by the tabs and
            // the genres, which come after it in the column.
            z: 1;

            HorizontalLayout {
                padding-left: Spacing.base;
                padding-right: Spacing.base;
                spacing: Spacing.base;

                Text {
                    text: "AniRust";
                    color: MaterialPalette.primary;
                    font-size: Typography.title-large-size;
                    font-weight: Typography.title-large-weight-em;
                    vertical-alignment: center;
                }

                field := Rectangle {
                    horizontal-stretch: 1;
                    height: Spacing.touch-target;
                    y: (parent.height - self.height) / 2;
                    border-radius: Shape.pill;
                    background: MaterialPalette.surface-container-highest;
                    border-width: input.has-focus ? 1px : 0px;
                    border-color: MaterialPalette.primary;

                    HorizontalLayout {
                        padding-left: Spacing.base;
                        padding-right: Spacing.base;
                        spacing: Spacing.small;

                        // In its own box, because a fixed-size image in a
                        // row sits at the top of it rather than on the row's
                        // centre line.
                        Rectangle {
                            width: 18px;
                            background: transparent;

                            Image {
                                source: @image-url("../icons/search.svg");
                                colorize: MaterialPalette.on-surface-variant;
                                width: 18px;
                                height: 18px;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;

                            if root.query == "" && !input.has-focus: Text {
                                text: Tr.search-hint;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-large-size;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }

                            input := TextInput {
                                text <=> root.query;
                                color: MaterialPalette.on-surface;
                                font-size: Typography.body-large-size;
                                vertical-alignment: center;
                                single-line: true;
                                width: 100%;
                                height: 100%;
                                accepted => { root.search(self.text); }
                            }
                        }
                    }
                }

                // The bell, only with an account: notifications are the
                // account's, and a bell that can never ring is a decoration.
                if root.signed-in: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 40px;
                        height: 40px;

                        IconButton {
                            width: 100%;
                            height: 100%;
                            icon: @image-url("../icons/bell.svg");
                            tooltip: Tr.notifications;
                            clicked => { root.open-notifications(); }
                        }

                        if root.unseen > 0: Badge {
                            x: parent.width - self.width + 4px;
                            y: -2px;
                            text: root.unseen > 99 ? "99+" : root.unseen;
                        }
                    }
                }

                // Something to watch with no idea what: the official client's
                // dice, a release picked by the service.
                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/dice.svg");
                        tooltip: Tr.random-release;
                        clicked => { root.open-random(); }
                    }
                }

                // The download queue is this client's own addition, so it is
                // not one of the rail's destinations — it lives here, where it
                // is out of the way until it has something to say, and says it
                // with a badge.
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 40px;
                        height: 40px;

                        IconButton {
                            width: 100%;
                            height: 100%;
                            icon: @image-url("../icons/download.svg");
                            tooltip: Tr.nav-downloads;
                            clicked => { root.open-downloads(); }
                        }

                        if root.downloads-working > 0: Badge {
                            x: parent.width - self.width + 4px;
                            y: -2px;
                            text: root.downloads-working;
                        }
                    }
                }

                // Signed in, the name leads to the profile, where signing
                // out is — asked about there, never a click away from here.
                VerticalLayout {
                    alignment: center;

                    OutlineButton {
                        text: root.signed-in ? root.account-name : Tr.sign-in;
                        tooltip: root.signed-in ? Tr.my-profile : "";

                        clicked => {
                            if (root.signed-in) { root.open-profile(); } else { root.sign-in(); }
                        }
                    }
                }
            }
        }

        // ---- tabs --------------------------------------------------------
        //
        // Hidden while searching: the tabs name a part of the catalogue, and a
        // search is not one of them.
        //
        // The bar divides its width evenly between the tabs and draws its
        // indicator under one division, so every tab needs a division wide
        // enough for its label. Eight tabs do not get that from a narrow
        // window; there the bar keeps its comfortable width and scrolls
        // sideways under a fixed viewport rather than letting labels run into
        // each other.
        if root.collection-open: VerticalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            spacing: Spacing.small;

            HorizontalLayout {
                alignment: start;

                TextButton {
                    icon: @image-url("../icons/back.svg");
                    text: Tr.back-to-collections;
                    clicked => { root.close-collection(); }
                }
            }

            CollectionHeader {
                collection: root.collection;
                signed-in: root.signed-in;
                toggle-favourite => { root.toggle-collection-favourite(); }
                open-comments => { root.open-collection-comments(); }
                open-creator => { root.open-collection-creator(); }
                edit => { root.edit-collection(); }
                report => { root.report-collection(); }
                sign-in => { root.sign-in(); }
            }
        }

        if !root.searching && !root.collection-open && root.tabs.length > 0: tab-strip := Flickable {
            height: 48px;
            interactive: self.content-width > self.width;
            content-width: max(self.width, root.tab-width * root.tabs.length + 2 * Spacing.base);

            SecondaryTabBar {
                x: Spacing.base;
                width: tab-strip.content-width - 2 * Spacing.base;
                height: 100%;
                items: root.tabs;

                // Pushed, not bound: the bar writes its own index on a click,
                // and Rust decides which tab a destination opens on.
                property <int> wanted: root.tab;
                init => {
                    self.current-index = root.tab;
                    tab-strip.reveal(root.tab);
                }
                changed wanted => {
                    self.current-index = self.wanted;
                    tab-strip.reveal(self.wanted);
                }

                index-changed(i) => { root.select-tab(i); }
            }

            /// Scrolls the strip so the tab at `index` is in the middle of it,
            /// or as near as the ends allow. A selected tab out of sight is a
            /// question nobody can see the answer to.
            function reveal(index: int) {
                let division = (self.content-width - 2 * Spacing.base) / root.tabs.length;
                let centre = Spacing.base + division * (index + 0.5);
                self.content-x = clamp(self.width / 2 - centre, self.width - self.content-width, 0px);
            }
        }

        // Wrapped rather than scrolled sideways: nineteen chips do not fit on
        // one line of any window, and a row that runs off the edge hides half
        // the filter.
        if !root.searching && !root.collection-open && root.can-create-collection: HorizontalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            padding-bottom: Spacing.small;
            alignment: start;

            TonalButton {
                text: Tr.new-collection;
                clicked => { root.new-collection(); }
            }
        }

        if !root.searching && !root.collection-open && root.genres.length > 0: FlexboxLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            flex-wrap: wrap;
            alignment: start;
            spacing: Spacing.small;
            padding-bottom: Spacing.small;

            GenreChip {
                text: root.chips-are-days ? Tr.whole-week : Tr.all-genres;
                selected: root.genre == 0;
                picked => { root.select-genre(0); }
            }

            for name[index] in root.genres: GenreChip {
                text: name;
                selected: index + 1 == root.genre;
                picked => { root.select-genre(index + 1); }
            }
        }

        // ---- results -----------------------------------------------------
        // A line over the grid: what it is showing, and whether more of it is
        // still coming. Loading is only ever said here while there is already
        // something underneath — a tab being switched keeps the last one's
        // cards until the new ones arrive. With nothing underneath, the
        // indicator in the middle says it instead, and saying it in both
        // places at once says it worse than either.
        if root.searching || (root.loading && root.results.length > 0): HorizontalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            padding-top: Spacing.small;
            spacing: Spacing.small;

            Text {
                text: root.searching ? Tr.search-results : Tr.loading;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
                horizontal-stretch: 1;
            }

            if root.searching && root.loading && root.results.length > 0: Text {
                text: Tr.loading;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
                vertical-alignment: center;
            }
        }

        // Who and which channels go by that name, a row each, scrolled
        // sideways: the releases are what most searches are after, and these
        // should not push them off the screen.
        if root.searching && root.found-people.length > 0: SearchRow {
            label: Tr.found-people;
            items: root.found-people;
            clicked(i) => { root.open-found-person(i); }
        }

        if root.searching && root.found-channels.length > 0: SearchRow {
            label: Tr.feed-channels;
            items: root.found-channels;
            clicked(i) => { root.open-found-channel(i); }
        }

        // Loading, with nothing yet to show under it.
        if root.loading && root.results.length == 0: HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;

            VerticalLayout {
                alignment: center;

                // Sized here rather than left to itself: the indicator keeps
                // itself round by binding its width to its height, and a
                // layout that has to measure one from the other measures in a
                // circle.
                CircularProgressIndicator {
                    indeterminate: true;
                    width: 48px;
                    height: 48px;
                }
            }
        }

        if !root.loading && root.results.length == 0: Text {
            text: root.notice != ""
                ? root.notice
                : (root.searching ? Tr.nothing-found : Tr.nothing-here);
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.body-large-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            vertical-stretch: 1;
        }

        if root.results.length > 0: grid := ScrollView {
            vertical-stretch: 1;
            content-height: wall.preferred-height + (root.loading-more ? 72px : 0px);

            // Within a screen of the end, the next page is asked for. Rust
            // keeps it to one request at a time and stops at the last page.
            changed content-y => { self.near-end(); }
            changed content-height => { self.near-end(); }
            function near-end() {
                if (self.content-height - self.visible-height + self.content-y < self.visible-height) {
                    root.load-more();
                }
            }

            wall := FlexboxLayout {
                y: root.gutter;
                width: 100%;
                padding-left: Spacing.base;
                padding-right: Spacing.base;
                flex-wrap: wrap;
                alignment: start;
                spacing: root.gutter;

                for card[index] in root.results: PosterCard {
                    card: card;
                    width: root.card-width;
                    height: root.card-height;
                    clicked => { root.open-release(index); }
                }
            }

            if root.loading-more: CircularProgressIndicator {
                indeterminate: true;
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: wall.preferred-height + 18px;
            }
        }
    }
}
