// SPDX-License-Identifier: GPL-3.0-or-later
//
// Finding something to watch.
//
// One page behind every destination on the rail: a search field, a row of tabs,
// an optional row of genres, and a wall of posters. What the tabs are called
// and what they fetch is the window's business — this only says which is
// selected.
//
// The wall is a `FlexboxLayout`, which wraps to the next row on its own: the
// cards never have to know how many fit across, and nothing has to read the
// width it is being given to work it out.

import { MaterialPalette, FilterChip, CircularProgressIndicator, IconButton, Badge, TextButton, ScrollView } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { Tint } from "../globals/tint.slint";
import { ReleaseCard, CollectionItem, PersonItem } from "../structs.slint";
import { PersonChip } from "../components/person-chip.slint";
import { PosterCard } from "../components/release-cards.slint";
import { QuietButton } from "../components/quiet-button.slint";
import { TextTabs, SearchField, RoundIconButton, TintPill, EmptyState } from "../components/ui-kit.slint";

/// A genre, as one of a row where exactly one of them is chosen.
///
/// A filter chip owns its checked state and flips it on a click, which is a
/// toggle; this row is a choice. So the chip is put back to what the app says
/// after every click: picking the chosen one again leaves it chosen, and
/// picking another clears it because the app says so.
component GenreChip inherits FilterChip {
    in property <bool> selected;
    callback picked();

    init => { self.checked = root.selected; }
    changed selected => { self.checked = root.selected; }
    changed checked => {
        if (self.checked == root.selected) { return; }
        if (self.checked) { root.picked(); }
        self.checked = root.selected;
    }
}

/// A labelled row of people or channels, scrolled sideways.
component SearchRow inherits VerticalLayout {
    in property <string> label;
    in property <[PersonItem]> items;
    callback clicked(int);

    padding-left: Spacing.base;
    padding-right: Spacing.base;
    padding-top: Spacing.small;
    spacing: Spacing.tight;
    // Its own height and no more: the grid below is what takes the rest.
    vertical-stretch: 0;

    Text {
        text: root.label;
        color: MaterialPalette.on-surface-variant;
        font-size: Typography.label-large-size;
    }

    row := Flickable {
        min-height: 52px;
        max-height: 52px;
        vertical-stretch: 0;
        interactive: self.content-width > self.width;
        content-width: chips.preferred-width;

        chips := HorizontalLayout {
            height: 52px;
            spacing: Spacing.small;
            alignment: start;

            for item[index] in root.items: PersonChip {
                width: 240px;
                person: item;
                clicked => { root.clicked(index); }
            }
        }
    }
}

/// A collection's own page, over the releases in it.
component CollectionHeader inherits Rectangle {
    in property <CollectionItem> collection;
    in property <bool> signed-in: false;
    callback toggle-favourite();
    callback open-comments();
    callback open-creator();
    callback edit();
    callback report();
    callback sign-in();

    height: layout.preferred-height;
    border-radius: Shape.large;
    background: MaterialPalette.surface-container;

    layout := HorizontalLayout {
        padding: Spacing.base;
        spacing: Spacing.base;

        // Wide rather than tall: the service draws collection covers as
        // banners.
        Rectangle {
            width: 192px;
            height: 108px;
            border-radius: Shape.medium;
            background: MaterialPalette.surface-container-high;
            clip: true;

            Image {
                source: root.collection.image;
                image-fit: cover;
                width: 100%;
                height: 100%;
                visible: root.collection.image-loaded;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Spacing.hair;
            alignment: start;

            HorizontalLayout {
                spacing: Spacing.small;

                if root.collection.private: Image {
                    source: @image-url("../icons/lock.svg");
                    colorize: MaterialPalette.on-surface-variant;
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.collection.title;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.title-large-size;
                    font-weight: Typography.title-large-weight-em;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            creator := Text {
                text: Tr.by-author(root.collection.creator);
                color: MaterialPalette.primary;
                font-size: Typography.label-large-size;

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-creator(); }
                }
            }

            Text {
                text: Tr.favourited-label(root.collection.favourites);
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
            }

            if root.collection.description != "": Text {
                text: root.collection.description;
                color: MaterialPalette.on-surface;
                font-size: Typography.body-medium-size;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: start;
                spacing: Spacing.tight;
                padding-top: Spacing.small;

                IconButton {
                    icon: @image-url("../icons/heart.svg");
                    checked-icon: @image-url("../icons/heart-filled.svg");
                    checkable: true;
                    checked: root.collection.favourite;
                    tooltip: root.collection.favourite ? Tr.remove-from-favourites : Tr.add-to-favourites;
                    clicked => {
                        if (root.signed-in) { root.toggle-favourite(); } else { root.sign-in(); }
                    }
                }

                TextButton {
                    icon: @image-url("../icons/comment.svg");
                    text: root.collection.comments;
                    clicked => { root.open-comments(); }
                }

                if root.collection.mine: TextButton {
                    text: Tr.edit;
                    clicked => { root.edit(); }
                }

                if !root.collection.mine: TextButton {
                    icon: @image-url("../icons/flag.svg");
                    text: Tr.report;
                    clicked => { root.report(); }
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    in property <string> heading;
    in property <[ReleaseCard]> results;
    /// Whether the grid is showing search results rather than a tab.
    in property <bool> searching: false;
    in property <bool> loading: false;
    in-out property <string> query;
    /// The tabs of the current destination, and which is selected.
    in property <[string]> tabs: [];
    in property <int> tab: 0;
    /// Genre names the catalogue knows, supplied by Rust because they are data
    /// rather than interface text. Index 0 of the chip row is "all", which is
    /// not one of them. Empty everywhere but the catalogue.
    in property <[string]> genres: [];
    in property <int> genre: 0;
    /// The chip row is days of the week on the schedule, genres elsewhere.
    in property <bool> chips-are-days: false;
    callback open-random();
    /// Shown instead of the grid when there is a reason it is empty.
    in property <string> notice;
    in property <bool> signed-in: false;
    /// Enough room for the page title beside the search and for the featured
    /// release to put the poster next to its words. Decided by the window,
    /// not measured here: a page reading its own width is a layout loop.
    in property <bool> wide: false;
    in property <bool> feature-first;
    in property <string> account-name;
    in property <image> avatar;
    in property <bool> avatar-loaded: false;
    /// Unseen notifications, for the bell's badge. Only with an account.
    in property <int> unseen: 0;
    callback open-notifications();

    /// A collection open over the grid, which then holds its releases.
    in property <bool> collection-open: false;
    in property <CollectionItem> collection;
    /// The account's collections are on screen, so a new one can be made.
    in property <bool> can-create-collection: false;
    callback close-collection();
    callback toggle-collection-favourite();
    callback open-collection-comments();
    callback open-collection-creator();
    callback edit-collection();
    callback new-collection();
    callback report-collection();

    /// People and channels a search found beside the releases. Only a search
    /// of the whole catalogue looks for them.
    in property <bool> loading-more: false;
    /// Asked for when the grid is scrolled near its end.
    callback load-more();
    in property <[PersonItem]> found-people: [];
    in property <[PersonItem]> found-channels: [];
    callback open-found-person(int);
    callback open-found-channel(int);

    callback search(string);
    callback open-release(int);
    callback sign-in();
    callback sign-out();
    callback open-profile();
    callback select-tab(int);
    /// 0 means every genre.
    callback select-genre(int);

    background: MaterialPalette.surface;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    /// A poster's box, and the gap between two of them.
    ///
    /// Handed in by the window rather than read from this page's own width:
    /// a page whose preferred width is computed from a child, and a child
    /// whose width is computed from the page, is a binding loop — and Slint
    /// detects it at run time, not at compile time. The window knows its own
    /// width without asking its children.
    in property <length> card-width: 168px;
    /// Portrait proportions — a poster is two thirds as wide as it is tall —
    /// plus the two lines of title and the line of facts under it.
    property <length> card-height: root.card-width * 1.5 + 78px;
    property <length> gutter: Spacing.comfortable;
    /// Page edges grow with the card, so a wide screen gets air rather than
    /// more cards. Derived from the card width, which comes from outside.
    property <length> page-padding: root.wide ? Spacing.loose : Spacing.page;
    property <bool> featured: root.feature-first && !root.searching
        && !root.collection-open && !root.chips-are-days && root.results.length > 0;
    property <length> featured-height: root.wide ? 224px : 188px;
    property <bool> genres-open: false;
    changed heading => { root.genres-open = false; }

    VerticalLayout {
        // ---- search ------------------------------------------------------
        //
        // The phone client's bar: one round field with a magnifier, then the
        // few things that are always reachable — the bell, a random release,
        // the account. Enter searches; there is no button to hunt for.
        Rectangle {
            height: 76px;
            // Painted after its siblings, so that what hangs below it — the
            // account button's tooltip — is not drawn over by the tabs and
            // the genres, which come after it in the column.
            z: 1;

            HorizontalLayout {
                x: 0px;
                width: parent.width;
                padding-left: root.page-padding;
                padding-right: root.page-padding;
                spacing: Spacing.small;

                if root.wide: Text {
                    text: root.heading;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.headline-small-size;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                // Pushes the search to the right on a wide window, where a
                // field floating in the middle of the bar reads as a gap
                // rather than as the one control the bar is for.
                if root.wide: Rectangle { horizontal-stretch: 1; }

                VerticalLayout {
                    horizontal-stretch: 1;
                    max-width: 560px;
                    alignment: center;

                    SearchField {
                        width: 100%;
                        placeholder: Tr.search-hint;
                        text <=> root.query;
                        searched(q) => { root.search(q); }
                    }
                }

                // The bell, only with an account: notifications are the
                // account's, and a bell that can never ring is a decoration.
                if root.signed-in: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 44px;
                        height: 44px;

                        RoundIconButton {
                            icon: @image-url("../icons/bell.svg");
                            tooltip: Tr.notifications;
                            clicked => { root.open-notifications(); }
                        }

                        if root.unseen > 0: Badge {
                            x: parent.width - self.width + 2px;
                            y: -2px;
                            text: root.unseen > 99 ? "99+" : root.unseen;
                        }
                    }
                }

                // Something to watch with no idea what: the official client's
                // dice, a release picked by the service.
                VerticalLayout {
                    alignment: center;

                    RoundIconButton {
                        icon: @image-url("../icons/dice.svg");
                        tooltip: Tr.random-release;
                        clicked => { root.open-random(); }
                    }
                }

                // Signed in, the account is its own picture, as in the phone
                // client: one round thing at the edge of the bar, and the
                // profile behind it. Signing out is asked about there.
                if root.signed-in: VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        clip: true;
                        background: MaterialPalette.surface-container-high;
                        accessible-role: button;
                        accessible-label: Tr.my-profile;

                        Image {
                            source: root.avatar;
                            image-fit: cover;
                            width: 100%;
                            height: 100%;
                            visible: root.avatar-loaded;
                        }

                        Image {
                            source: @image-url("../icons/person.svg");
                            colorize: MaterialPalette.on-surface-variant;
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            visible: !root.avatar-loaded;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-profile(); }
                        }
                    }
                }

                if !root.signed-in: VerticalLayout {
                    alignment: center;

                    TintPill {
                        text: Tr.sign-in;
                        wash: Tint.coral-bg;
                        ink: Tint.coral-ink;
                        clicked => { root.sign-in(); }
                    }
                }
            }
        }

        // ---- tabs --------------------------------------------------------
        //
        // Hidden while searching: the tabs name a part of the catalogue, and a
        // search is not one of them.
        //
        // The bar divides its width evenly between the tabs and draws its
        // indicator under one division, so every tab needs a division wide
        // enough for its label. Eight tabs do not get that from a narrow
        // window; there the bar keeps its comfortable width and scrolls
        // sideways under a fixed viewport rather than letting labels run into
        // each other.
        if root.collection-open: VerticalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            spacing: Spacing.small;

            HorizontalLayout {
                alignment: start;

                TextButton {
                    icon: @image-url("../icons/back.svg");
                    text: Tr.back-to-collections;
                    clicked => { root.close-collection(); }
                }
            }

            CollectionHeader {
                collection: root.collection;
                signed-in: root.signed-in;
                toggle-favourite => { root.toggle-collection-favourite(); }
                open-comments => { root.open-collection-comments(); }
                open-creator => { root.open-collection-creator(); }
                edit => { root.edit-collection(); }
                report => { root.report-collection(); }
                sign-in => { root.sign-in(); }
            }
        }

        // ---- tabs --------------------------------------------------------
        //
        // Hidden while searching: the tabs name a part of the catalogue, and a
        // search is not one of them. The phone client's pattern — a row of
        // labels with a coral underline under the chosen one — rather than a
        // segmented bar: it says where you are without boxing in every word.
        if !root.searching && !root.collection-open && root.tabs.length > 0: HorizontalLayout {
            padding-left: root.page-padding;
            padding-right: root.page-padding;

            TextTabs {
                horizontal-stretch: 1;
                items: root.tabs;
                current: root.tab;
                select(i) => { root.select-tab(i); }
            }
        }

        if !root.searching && !root.collection-open && root.can-create-collection: HorizontalLayout {
            padding-left: root.page-padding;
            padding-right: root.page-padding;
            padding-top: Spacing.small;
            alignment: start;

            TintPill {
                text: Tr.new-collection;
                icon: @image-url("../icons/collection.svg");
                has-icon: true;
                clicked => { root.new-collection(); }
            }
        }

        if !root.searching && !root.collection-open && root.genres.length > 0 && !root.chips-are-days: HorizontalLayout {
            padding-left: root.page-padding;
            padding-right: root.page-padding;
            padding-top: Spacing.small;
            alignment: start;

            // The genre chooser is a filter, so it wears the filter's icon and
            // stays quiet until it is in use. A chosen genre turns it coral.
            TintPill {
                text: root.genre > 0 && root.genre <= root.genres.length
                    ? root.genres[root.genre - 1] : Tr.all-genres;
                icon: @image-url("../icons/filters.svg");
                has-icon: true;
                trailing: @image-url("../icons/chevron-down.svg");
                has-trailing: true;
                wash: root.genre > 0 ? Tint.coral-bg : MaterialPalette.surface-container;
                ink: root.genre > 0 ? Tint.coral-ink : MaterialPalette.on-surface;
                inner-height: 40px;
                clicked => { root.genres-open = !root.genres-open; }
            }
        }

        if !root.searching && !root.collection-open && root.genres.length > 0
            && (root.chips-are-days || root.genres-open): FlexboxLayout {
            padding-left: root.page-padding;
            padding-right: root.page-padding;
            flex-wrap: wrap;
            alignment: start;
            spacing: Spacing.small;
            padding-top: Spacing.small;

            GenreChip {
                text: root.chips-are-days ? Tr.whole-week : Tr.all-genres;
                selected: root.genre == 0;
                picked => { root.select-genre(0); root.genres-open = false; }
            }

            for name[index] in root.genres: GenreChip {
                text: name;
                selected: index + 1 == root.genre;
                picked => { root.select-genre(index + 1); root.genres-open = false; }
            }
        }

        // ---- results -----------------------------------------------------
        // A line over the grid: what it is showing, and whether more of it is
        // still coming. Loading is only ever said here while there is already
        // something underneath — a tab being switched keeps the last one's
        // cards until the new ones arrive. With nothing underneath, the
        // indicator in the middle says it instead, and saying it in both
        // places at once says it worse than either.
        if root.searching || (root.loading && root.results.length > 0): HorizontalLayout {
            padding-left: Spacing.base;
            padding-right: Spacing.base;
            padding-top: Spacing.small;
            spacing: Spacing.small;

            Text {
                text: root.searching ? Tr.search-results : Tr.loading;
                color: MaterialPalette.on-surface;
                font-size: Typography.title-medium-size;
                font-weight: Typography.title-medium-weight-em;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            if root.searching: QuietButton {
                text: Tr.clear-search;
                clicked => { root.query = ""; root.search(""); }
            }

            if root.searching && root.loading && root.results.length > 0: Text {
                text: Tr.loading;
                color: MaterialPalette.on-surface-variant;
                font-size: Typography.label-medium-size;
                vertical-alignment: center;
            }
        }

        // Who and which channels go by that name, a row each, scrolled
        // sideways: the releases are what most searches are after, and these
        // should not push them off the screen.
        if root.searching && root.found-people.length > 0: SearchRow {
            label: Tr.found-people;
            items: root.found-people;
            clicked(i) => { root.open-found-person(i); }
        }

        if root.searching && root.found-channels.length > 0: SearchRow {
            label: Tr.feed-channels;
            items: root.found-channels;
            clicked(i) => { root.open-found-channel(i); }
        }

        // Loading, with nothing yet to show under it.
        if root.loading && root.results.length == 0: HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;

            VerticalLayout {
                alignment: center;

                // Sized here rather than left to itself: the indicator keeps
                // itself round by binding its width to its height, and a
                // layout that has to measure one from the other measures in a
                // circle.
                CircularProgressIndicator {
                    indeterminate: true;
                    width: 48px;
                    height: 48px;
                }
            }
        }

        if !root.loading && root.results.length == 0: EmptyState {
            vertical-stretch: 1;
            icon: root.searching ? @image-url("../icons/search.svg") : @image-url("../icons/compass.svg");
            title: root.notice != ""
                ? root.notice
                : (root.searching ? Tr.nothing-found : Tr.nothing-here);
            detail: root.searching ? Tr.nothing-found-hint : "";
        }

        if root.results.length > 0: grid := ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-height: wall.y + wall.preferred-height + (root.loading-more ? 72px : root.gutter);

            // Within a screen of the end, the next page is asked for. Rust
            // keeps it to one request at a time and stops at the last page.
            changed content-y => { self.near-end(); }
            changed content-height => { self.near-end(); }
            function near-end() {
                if (self.content-height - self.visible-height + self.content-y < self.visible-height) {
                    root.load-more();
                }
            }

            if root.featured: Rectangle {
                x: root.page-padding;
                y: Spacing.base;
                width: grid.visible-width - 2 * root.page-padding;
                height: root.featured-height;
                border-radius: Shape.extra-large;
                clip: true;
                background: MaterialPalette.surface-container-low;
                border-width: 1px;
                border-color: MaterialPalette.outline-variant;

                if root.results[0].poster-loaded: Image {
                    source: root.results[0].poster;
                    image-fit: cover;
                    width: 100%;
                    height: 100%;
                    opacity: 0.35;
                }

                Rectangle {
                    background: @linear-gradient(90deg,
                        MaterialPalette.surface-container-low 0%,
                        MaterialPalette.surface-container-low.with-alpha(0.84) 42%,
                        MaterialPalette.surface-container-low.with-alpha(0.2) 100%);
                }

                HorizontalLayout {
                    padding: root.wide ? 24px : 20px;
                    spacing: Spacing.comfortable;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 8px;

                        if root.results[0].score != "": Text {
                            text: "★ " + root.results[0].score;
                            color: Tint.amber-ink;
                            font-size: 14px;
                            font-weight: 600;
                        }

                        Text {
                            text: root.results[0].title;
                            color: MaterialPalette.on-surface;
                            font-size: root.wide ? 28px : 22px;
                            font-weight: 600;
                            wrap: word-wrap;
                            max-lines: 2;
                            overflow: elide;
                        }

                        Text {
                            text: root.results[0].subtitle;
                            color: MaterialPalette.on-surface-variant;
                            font-size: 14px;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            padding-top: 8px;
                            alignment: start;

                            TintPill {
                                text: Tr.open-release;
                                icon: @image-url("../icons/play.svg");
                                has-icon: true;
                                wash: MaterialPalette.primary;
                                ink: MaterialPalette.on-primary;
                                inner-height: 48px;
                                clicked => { root.open-release(0); }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: root.wide ? 112px : 92px;
                            height: root.wide ? 168px : 138px;
                            border-radius: Shape.poster;
                            clip: true;
                            background: MaterialPalette.surface-container-high;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: #00000040;

                            if root.results[0].poster-loaded: Image {
                                source: root.results[0].poster;
                                image-fit: cover;
                                width: 100%;
                                height: 100%;
                            }

                            if !root.results[0].poster-loaded: Image {
                                source: @image-url("../icons/poster.svg");
                                colorize: MaterialPalette.on-surface-variant.with-alpha(0.35);
                                width: 32px;
                                height: 32px;
                            }
                        }
                    }
                }

                // Anywhere but the button opens the release too.
                TouchArea {
                    z: -1;
                    mouse-cursor: pointer;
                    clicked => { root.open-release(0); }
                }
            }

            wall := FlexboxLayout {
                y: root.featured ? Spacing.base + root.featured-height + root.gutter : root.gutter;
                width: grid.visible-width;
                height: self.preferred-height;
                padding-left: root.page-padding;
                padding-right: root.page-padding;
                flex-wrap: wrap;
                cross-axis-line-alignment: start;
                alignment: start;
                spacing: root.gutter;

                for row in root.results.length - (root.featured ? 1 : 0): PosterCard {
                    property <int> index: row + (root.featured ? 1 : 0);
                    card: root.results[self.index];
                    width: root.card-width;
                    height: root.card-height;
                    clicked => { root.open-release(self.index); }
                }
            }

            if root.loading-more: CircularProgressIndicator {
                indeterminate: true;
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: wall.y + wall.preferred-height + 18px;
            }
        }
    }
}
