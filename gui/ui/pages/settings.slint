// SPDX-License-Identifier: GPL-3.0-or-later
//
// Settings: how the client looks and plays, what brings a notification, the
// account, and what the program is.
//
// One page of grouped rows, the way the phone client does it: a heading, a
// card of rows under it, the control on the right of each row. Nothing is a
// form — a setting is read, not filled in — so there are no input boxes here
// except the ones a choice needs.
//
// Kept on a destination of its own at the foot of the rail rather than at the
// bottom of the profile, where it used to be: a profile is somebody, and
// settings are not.

import { MaterialPalette, SegmentedButton, FilledButton, OutlineButton, TonalButton, TextButton, Switch, ScrollView } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { Scheme, Accent } from "../globals/scheme.slint";
import { Tint } from "../globals/tint.slint";
import { QuietButton } from "../components/quiet-button.slint";

/// A heading over a group of rows, with a line of explanation when the group
/// needs one.
component SectionHeading inherits VerticalLayout {
    in property <string> text;
    in property <string> detail;

    spacing: 2px;
    padding-top: Spacing.loose;
    padding-bottom: Spacing.small;

    Text {
        text: root.text;
        color: MaterialPalette.on-surface;
        font-size: 18px;
        font-weight: 600;
    }

    if root.detail != "": Text {
        text: root.detail;
        color: MaterialPalette.on-surface-variant;
        font-size: Typography.body-medium-size;
        wrap: word-wrap;
    }
}

/// The surface a group of rows sits on: a card, not a form.
component Group inherits Rectangle {
    @children

    background: MaterialPalette.surface-container-low;
    border-radius: Shape.card;
    border-width: 1px;
    border-color: MaterialPalette.outline-variant;
    vertical-stretch: 0;
    min-width: 0px;
}

/// One switch with its label, and optionally a line of why.
component ToggleRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in property <bool> on: false;
    callback flipped(bool);

    padding-left: Spacing.base;
    padding-right: Spacing.base;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: Spacing.base;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.title;
            color: MaterialPalette.on-surface;
            font-size: Typography.body-large-size;
            wrap: word-wrap;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.body-small-size;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;

        // Its own width and no more: a switch stretched across the row is a
        // slider that does not slide.
        Switch {
            width: 50px;
            height: 30px;
            property <bool> wanted: root.on;
            init => { self.checked = root.on; }
            changed wanted => { self.checked = self.wanted; }
            changed checked => {
                if (self.checked != root.on) { root.flipped(self.checked); }
            }
        }
    }
}

/// A row of choices that can place the control below the label.
component ChoiceRow inherits FlexboxLayout {
    in property <string> title;
    in property <string> detail;

    padding-left: Spacing.base;
    padding-right: Spacing.base;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: Spacing.base;
    flex-wrap: wrap;
    cross-axis-alignment: center;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.title;
            color: MaterialPalette.on-surface;
            font-size: Typography.body-large-size;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: MaterialPalette.on-surface-variant;
            font-size: Typography.body-small-size;
            wrap: word-wrap;
        }
    }

    @children
}

/// The hairline between two rows of one group.
component RowSeparator inherits Rectangle {
    height: 1px;
    background: MaterialPalette.outline-variant;
}

export component SettingsPage inherits Rectangle {
    in property <bool> signed-in: false;
    in property <string> account-name;
    in property <string> version;
    /// The notification switches, in the order of the labels below.
    in property <[bool]> notify: [];
    in property <int> language: 0;
    /// The interface's size: S, M, L, XL.
    in property <int> ui-scale: 1;
    in property <int> appearance: 0;
    in property <int> accent: 0;
    in property <bool> translucent: false;
    in property <bool> remember-player: true;
    /// Drawn only when this build has a Discord application to post under.
    in property <bool> discord-available: false;
    in property <bool> discord-presence: false;
    /// The updater: whether it checks, and what it is doing (see Tr.update-status).
    in property <bool> check-updates: true;
    in property <string> update-state;
    in property <string> update-version;
    in property <string> update-error;
    in property <string> update-how;

    callback flip-notify(int);
    callback select-language(int);
    callback select-ui-scale(int);
    callback select-appearance(int);
    callback select-accent(int);
    callback set-translucent(bool);
    callback set-remember-player(bool);
    callback set-discord-presence(bool);
    callback test-machine();
    callback set-check-updates(bool);
    callback check-for-updates();
    callback install-update();
    callback open-account-settings();
    callback sign-in();
    callback sign-out();
    callback open-link(string);

    background: MaterialPalette.background;

    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    scroller := ScrollView {
        width: 100%;
        height: 100%;
        horizontal-scrollbar-policy: always-off;

        content-height: column.preferred-height;

        column := VerticalLayout {
            x: (scroller.visible-width - self.width) / 2;
            width: min(960px, scroller.visible-width - 2 * Spacing.page);
            height: self.preferred-height;
            alignment: start;
            padding-bottom: Spacing.loose;

            VerticalLayout {
                padding-top: Spacing.page;

                Text {
                    text: Tr.settings;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.headline-small-size;
                    font-weight: 600;
                }
            }

            // ---- the account --------------------------------------------
            SectionHeading {
                text: Tr.account-section;
            }

            Group {
                FlexboxLayout {
                    flex-wrap: wrap;
                    cross-axis-alignment: center;
                    padding: Spacing.base;
                    spacing: Spacing.base;

                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 26px;
                        background: Tint.coral-bg;

                        Image {
                            source: @image-url("../icons/person.svg");
                            colorize: Tint.coral-ink;
                            width: 24px;
                            height: 24px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.signed-in ? root.account-name : Tr.sign-in-title;
                            color: MaterialPalette.on-surface;
                            font-size: Typography.title-medium-size;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.signed-in ? Tr.account-signed-in : Tr.sign-in-to-profile;
                            color: MaterialPalette.on-surface-variant;
                            font-size: Typography.body-small-size;
                            wrap: word-wrap;
                        }
                    }

                    if !root.signed-in: FilledButton {
                        text: Tr.sign-in;
                        clicked => { root.sign-in(); }
                    }

                    if root.signed-in: TonalButton {
                        text: Tr.account-settings;
                        clicked => { root.open-account-settings(); }
                    }

                    if root.signed-in: TextButton {
                        text: Tr.sign-out;
                        clicked => { root.sign-out(); }
                    }
                }
            }

            // ---- Discord -----------------------------------------------
            // A section of its own rather than a row among the player's
            // switches: it is the only thing here that sends anything off the
            // machine, and that is worth finding at a glance.
            if root.discord-available: SectionHeading {
                text: Tr.discord;
                detail: Tr.discord-why;
            }

            if root.discord-available: Group {
                VerticalLayout {
                    alignment: start;

                    ToggleRow {
                        title: Tr.discord-presence;
                        detail: Tr.discord-presence-why;
                        on: root.discord-presence;
                        flipped(on) => { root.set-discord-presence(on); }
                    }
                }
            }

            // ---- what brings a notification ----------------------------
            if root.signed-in && root.notify.length > 0: SectionHeading {
                text: Tr.notification-settings;
            }

            if root.signed-in && root.notify.length > 0: Group {
                VerticalLayout {
                    alignment: start;

                    for label[i] in [
                        Tr.ns-episodes, Tr.ns-first-episode, Tr.ns-comments, Tr.ns-related,
                        Tr.ns-articles, Tr.ns-my-article-comments, Tr.ns-my-collection-comments,
                        Tr.ns-selected-releases, Tr.ns-reports,
                    ]: VerticalLayout {
                        alignment: start;

                        if i > 0: RowSeparator {}

                        ToggleRow {
                            title: label;
                            on: i < root.notify.length && root.notify[i];
                            flipped(on) => { root.flip-notify(i); }
                        }
                    }
                }
            }

            // ---- playback ----------------------------------------------
            SectionHeading {
                text: Tr.playback;
            }

            Group {
                VerticalLayout {
                    alignment: start;

                    ToggleRow {
                        title: Tr.remember-player;
                        detail: Tr.remember-player-why;
                        on: root.remember-player;
                        flipped(on) => { root.set-remember-player(on); }
                    }

                    RowSeparator {}

                    HorizontalLayout {
                        padding-left: Spacing.base;
                        padding-right: Spacing.base;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: Spacing.base;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            alignment: center;

                            Text {
                                text: Tr.bench-setting;
                                color: MaterialPalette.on-surface;
                                font-size: Typography.body-large-size;
                                wrap: word-wrap;
                            }

                            Text {
                                text: Tr.bench-setting-hint;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-small-size;
                                wrap: word-wrap;
                            }
                        }

                        TonalButton {
                            text: Tr.bench-start;
                            clicked => { root.test-machine(); }
                        }
                    }
                }
            }

            // ---- how it looks ------------------------------------------
            SectionHeading {
                text: Tr.appearance;
                detail: Tr.appearance-why;
            }

            Group {
                VerticalLayout {
                    alignment: start;

                    ChoiceRow {
                        title: Tr.language;

                        SegmentedButton {
                            items: [
                                { text: Tr.language-system },
                                { text: "Русский" },
                                { text: "English" },
                            ];

                            property <int> wanted: root.language;
                            init => { self.current-index = root.language; }
                            changed wanted => { self.current-index = self.wanted; }

                            index-changed(i) => { root.select-language(i); }
                        }
                    }

                    RowSeparator {}

                    ChoiceRow {
                        title: Tr.appearance;

                        SegmentedButton {
                            items: [
                                { text: Tr.appearance-system },
                                { text: Tr.appearance-light },
                                { text: Tr.appearance-dark },
                                { text: Tr.appearance-amoled },
                            ];

                            property <int> wanted: root.appearance;
                            init => { self.current-index = root.appearance; }
                            changed wanted => { self.current-index = self.wanted; }

                            index-changed(i) => { root.select-appearance(i); }
                        }
                    }

                    RowSeparator {}

                    ChoiceRow {
                        title: Tr.ui-scale;

                        SegmentedButton {
                            items: [{ text: "S" }, { text: "M" }, { text: "L" }, { text: "XL" }];
                            property <int> wanted: root.ui-scale;
                            init => { self.current-index = root.ui-scale; }
                            changed wanted => { self.current-index = self.wanted; }
                            index-changed(i) => { root.select-ui-scale(i); }
                        }
                    }

                    RowSeparator {}

                    // The accent: a swatch of each, its own primary colour.
                    HorizontalLayout {
                        padding-left: Spacing.base;
                        padding-right: Spacing.base;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: Spacing.base;

                        Text {
                            text: Tr.accent;
                            color: MaterialPalette.on-surface;
                            font-size: Typography.body-large-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: Spacing.small;

                            for colour[i] in [
                                Scheme.scheme-of(Accent.coral).light.primary,
                                Scheme.scheme-of(Accent.violet).light.primary,
                                Scheme.scheme-of(Accent.blue).light.primary,
                                Scheme.scheme-of(Accent.indigo).light.primary,
                                Scheme.scheme-of(Accent.teal).light.primary,
                                Scheme.scheme-of(Accent.green).light.primary,
                                Scheme.scheme-of(Accent.amber).light.primary,
                                Scheme.scheme-of(Accent.rose).light.primary,
                            ]: Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 15px;
                                background: colour;
                                border-width: i == root.accent ? 3px : 0px;
                                border-color: MaterialPalette.surface;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select-accent(i); }
                                }
                            }
                        }
                    }

                    RowSeparator {}

                    ToggleRow {
                        title: Tr.translucent-window;
                        detail: Tr.translucent-why;
                        on: root.translucent;
                        flipped(on) => { root.set-translucent(on); }
                    }
                }
            }

            // ---- the program --------------------------------------------
            SectionHeading {
                text: Tr.about;
            }

            Group {
                VerticalLayout {
                    alignment: start;

                    HorizontalLayout {
                        padding: Spacing.base;
                        spacing: Spacing.base;

                        Image {
                            source: @image-url("../../../packaging/icons/anirust.svg");
                            width: 56px;
                            height: 56px;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "AniRust " + root.version;
                                color: MaterialPalette.on-surface;
                                font-size: Typography.title-medium-size;
                                font-weight: 600;
                            }

                            Text {
                                text: Tr.about-what;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-medium-size;
                                wrap: word-wrap;
                            }
                        }
                    }

                    RowSeparator {}

                    FlexboxLayout {
                        padding: Spacing.base;
                        spacing: Spacing.small;
                        flex-wrap: wrap;
                        cross-axis-alignment: center;
                        alignment: start;

                        TonalButton {
                            text: Tr.faq;
                            clicked => { root.open-link("https://anixart-app.com/faq/"); }
                        }

                        OutlineButton {
                            text: Tr.service-rules;
                            clicked => { root.open-link("https://anixart-app.com/rules/"); }
                        }

                        QuietButton {
                            text: Tr.source-code;
                            clicked => { root.open-link("https://github.com/mrfrok/AniRust"); }
                        }
                    }

                    RowSeparator {}

                    ToggleRow {
                        title: Tr.update-check;
                        detail: Tr.update-check-why;
                        on: root.check-updates;
                        flipped(on) => { root.set-check-updates(on); }
                    }

                    RowSeparator {}

                    FlexboxLayout {
                        padding: Spacing.base;
                        spacing: Spacing.small;
                        flex-wrap: wrap;
                        cross-axis-alignment: center;
                        alignment: start;

                        OutlineButton {
                            text: Tr.update-check-now;
                            enabled: root.update-state != "checking" && root.update-state != "downloading" && root.update-state != "installing";
                            clicked => { root.check-for-updates(); }
                        }

                        if root.update-state == "available" && root.update-how == "": FilledButton {
                            text: Tr.update-install;
                            clicked => { root.install-update(); }
                        }

                        Text {
                            text: Tr.update-status(root.update-state, root.update-version, root.update-error, root.update-how);
                            color: MaterialPalette.on-surface-variant;
                            font-size: Typography.body-medium-size;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        padding: Spacing.base;

                        Text {
                            horizontal-stretch: 1;
                            text: Tr.about-unaffiliated;
                            color: MaterialPalette.on-surface-variant;
                            font-size: Typography.body-small-size;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
