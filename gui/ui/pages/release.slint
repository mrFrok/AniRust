// SPDX-License-Identifier: GPL-3.0-or-later
//
// The release screen: what a title is, and which of it to watch.
//
// The player lives here rather than on a screen of its own. Watching an episode
// and picking the next one are the same activity, and sending the viewer away
// from the release to do the first meant the screen spent most of its area
// holding a description nobody was reading. So: the picture takes the space, the
// release sits under it, and the episode list stays beside it the whole time.
//
// The player itself is injected as this component's child, so the one instance
// that owns the video texture is declared once, in the window.

import { ScrollView } from "std-widgets.slint";
import { MaterialPalette, IconButton, FloatingActionButton, FABStyle, TonalButton, ActionChip, OutlineButton, TextButton } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing, Motion } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { VideoItem, PickerOption, EpisodeItem, LinkItem } from "../structs.slint";
import { EpisodePicker, Poster, Dropdown } from "../components/release-parts.slint";

/// A heading and a wrapping row of chips under it.
component LinkRow inherits VerticalLayout {
    in property <string> heading;
    in property <[LinkItem]> items;
    callback picked(int);

    spacing: Spacing.tight;
    padding-top: Spacing.small;

    Text {
        text: root.heading;
        color: MaterialPalette.on-surface-variant;
        font-size: Typography.label-medium-size;
    }

    FlexboxLayout {
        flex-wrap: wrap;
        alignment: start;
        spacing: Spacing.small;

        for item[index] in root.items: ActionChip {
            text: item.detail != "" ? item.label + " · " + item.detail : item.label;
            clicked => { root.picked(index); }
        }
    }
}

/// The release's videos, a row of thumbnails scrolled sideways.
component VideoRow inherits VerticalLayout {
    in property <string> heading;
    in property <[VideoItem]> items;
    callback picked(int);

    spacing: Spacing.tight;
    padding-top: Spacing.small;

    Text {
        text: root.heading;
        color: MaterialPalette.on-surface-variant;
        font-size: Typography.label-medium-size;
    }

    Flickable {
        height: 150px;
        interactive: self.content-width > self.width;
        content-width: row.preferred-width;

        row := HorizontalLayout {
            spacing: Spacing.small;
            alignment: start;

            for item[index] in root.items: Rectangle {
                width: 192px;

                VerticalLayout {
                    spacing: Spacing.hair;

                    Rectangle {
                        height: 108px;
                        border-radius: Shape.medium;
                        clip: true;
                        background: MaterialPalette.surface-container-high;
                        border-width: touch.has-hover ? 2px : 0px;
                        border-color: MaterialPalette.primary;

                        Image {
                            source: item.image;
                            image-fit: cover;
                            width: 100%;
                            height: 100%;
                            visible: item.image-loaded;
                        }

                        Image {
                            source: @image-url("../icons/play.svg");
                            colorize: #FFFFFF;
                            width: 28px;
                            height: 28px;
                            opacity: 0.85;
                        }
                    }

                    Text {
                        text: item.title;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.body-small-size;
                        overflow: elide;
                    }

                    Text {
                        text: item.detail;
                        color: MaterialPalette.on-surface-variant;
                        font-size: Typography.label-small-size;
                        overflow: elide;
                    }
                }

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(index); }
                }
            }
        }
    }
}

/// Five stars, the account's rating lit, and a hover preview of the one a
/// click would give.
component Rating inherits HorizontalLayout {
    in property <int> vote: 0;
    callback clicked(int);

    /// The star under the pointer, or 0 with none.
    property <int> hovered: 0;

    alignment: center;
    spacing: 0px;

    for i in 5: Rectangle {
        width: 26px;
        height: 32px;

        Text {
            text: "★";
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
            color: (root.hovered > 0 ? i < root.hovered : i < root.vote)
                ? MaterialPalette.tertiary
                : MaterialPalette.outline-variant;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover) { root.hovered = i + 1; }
                else if (root.hovered == i + 1) { root.hovered = 0; }
            }
            clicked => { root.clicked(i + 1); }
        }
    }
}

export component ReleasePage inherits Rectangle {
    // ---- from Rust -------------------------------------------------------
    in property <string> title;
    in property <string> original-title;
    in property <string> year;
    in property <string> genres;
    in property <string> studio;
    in property <string> status;
    in property <string> description;
    in property <string> score;
    in property <string> episodes-label;
    in property <image> poster;
    in property <bool> poster-loaded: false;
    /// A still from the release, shown behind the play button before anything
    /// has been started.
    in property <image> backdrop;
    in property <bool> backdrop-loaded: false;
    in property <bool> loading: false;

    in property <[PickerOption]> dubbers;
    in property <int> dubber: 0;
    in property <[PickerOption]> sources;
    in property <int> source: 0;
    in property <[EpisodeItem]> episodes;
    in property <bool> all-watched: false;
    /// Episode to resume, or 0 when nothing was started.
    in property <int> resume-episode: 0;
    /// Episode in the player, or 0 when nothing is loaded.
    in property <int> current-episode: 0;
    /// Where that episode sits in the list.
    in property <int> current-index: 0;
    /// Whether the player has anything at all — the difference between showing
    /// the picture and showing the invitation to start it.
    in property <bool> playing: false;
    /// The player fills the window and everything else steps aside.
    in property <bool> theatre: false;
    /// Set when an episode could not be resolved, so the screen says so rather
    /// than quietly going back to the invitation to try again.
    in property <bool> failed: false;

    /// The franchise's other releases, and the services carrying this one.
    in property <int> comment-count: 0;
    callback open-comments();
    in property <[LinkItem]> related: [];
    in property <[LinkItem]> platforms: [];
    /// Trailers, openings and the like, opened where they are hosted.
    in property <[VideoItem]> videos: [];
    callback open-video(int);
    callback open-related(int);
    callback open-platform(int);

    // ---- the account's view of it ---------------------------------------
    in property <bool> signed-in: false;
    /// Which of the account's lists it is in: 0 none, then the five lists in
    /// the bookmarks' order.
    in property <int> list: 0;
    in property <bool> favourite: false;
    /// The account's rating, 1 to 5, or 0 for none.
    in property <int> vote: 0;

    // ---- to Rust ---------------------------------------------------------
    callback set-list(int);
    callback toggle-favourite();
    /// Out, so it can be rated. A release that is only announced cannot.
    in property <bool> rateable: true;
    callback add-to-collection();
    callback report();
    /// A star was clicked. Clicking the rating already given takes it back.
    callback set-vote(int);
    /// Asked for any of the three above without an account.
    callback sign-in();
    callback select-dubber(int);
    callback select-source(int);
    callback play-episode(int);
    callback download-episode(int);
    callback toggle-watched(int);
    callback toggle-all-watched();
    callback toggle-pin();
    callback go-back();

    background: MaterialPalette.surface;

    // Size constraints stated outright rather than derived from the children.
    //
    // The page is responsive: `narrow` reads its own width, and the children
    // lay out differently below the threshold. Deriving the page's constraints
    // from those children would close the loop — width feeds `narrow`, which
    // feeds the children, which feed the width — so the page instead fills
    // whatever it is given and lets the window declare the real limits.
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    /// The height the start button occupies, which the failure line above it
    /// is placed from. Stated rather than measured: the button it belongs to
    /// is one of two that take that place, and neither is always there.
    property <length> start-height: 56px;

    /// Whether the episode list goes under the player instead of beside it.
    ///
    /// Decided by the window rather than measured here. A component that reads
    /// its own width to choose which children exist is reading the answer to
    /// the question its children are being asked, and Slint rightly calls that
    /// a binding loop.
    in property <bool> narrow: false;

    /// What the play button starts: where the account left off, or the
    /// beginning.
    property <int> first-episode: root.resume-episode > 0
        ? root.resume-episode
        : (root.episodes.length > 0 ? root.episodes[0].position : 0);

    VerticalLayout {
        // ---- header ------------------------------------------------------
        if !root.theatre: Rectangle {
            height: 64px;
            background: MaterialPalette.surface-container;

            HorizontalLayout {
                padding-left: Spacing.small;
                padding-right: Spacing.base;
                spacing: Spacing.small;

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/back.svg");
                        clicked => { root.go-back(); }
                    }
                }

                Text {
                    text: root.title;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.title-large-size;
                    font-weight: Typography.title-large-weight-em;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // What the account thinks of it. All three are offered without
                // an account too, and lead to signing in: a control that does
                // nothing when clicked is worse than one that says why.
                // Shown at every width. The title gives way instead — it elides,
                // and a rating that disappears below some width is a feature
                // that disappears with it.
                // Not out yet: nothing to rate.
                if root.rateable: VerticalLayout {
                    alignment: center;

                    Rating {
                        vote: root.vote;
                        clicked(n) => {
                            if (root.signed-in) { root.set-vote(n); } else { root.sign-in(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/heart.svg");
                        checked-icon: @image-url("../icons/heart-filled.svg");
                        checkable: true;
                        checked: root.favourite;
                        tooltip: root.favourite ? Tr.remove-from-favourites : Tr.add-to-favourites;
                        clicked => {
                            if (root.signed-in) { root.toggle-favourite(); } else { root.sign-in(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: @image-url("../icons/collection-add.svg");
                        tooltip: Tr.add-to-collection;
                        clicked => {
                            if (root.signed-in) { root.add-to-collection(); } else { root.sign-in(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Dropdown {
                        width: 190px;
                        model: [
                            { label: Tr.not-in-list },
                            { label: Tr.list-watching },
                            { label: Tr.list-planned },
                            { label: Tr.list-watched },
                            { label: Tr.list-hold },
                            { label: Tr.list-dropped },
                        ];
                        current: root.list;
                        selected(i) => {
                            if (root.signed-in) { root.set-list(i); } else { root.sign-in(); }
                        }
                    }
                }
            }
        }

        // ---- body --------------------------------------------------------
        HorizontalLayout {
            vertical-stretch: 1;
            padding: root.theatre ? 0px : Spacing.base;
            spacing: root.theatre ? 0px : Spacing.base;

            // The whole column scrolls — picture, list on a narrow window,
            // and the release under them — rather than the picture taking
            // the height and the release getting a strip below it. In theatre
            // the picture fills the view and there is nothing to scroll to.
            column := ScrollView {
                horizontal-stretch: 1;

            VerticalLayout {
                spacing: root.theatre ? 0px : Spacing.base;

                // ---- the player ------------------------------------------
                //
                // 16:9 of the column's width, from the scroll view's own
                // width rather than the box's: a box sizing itself from its
                // own width is a layout loop. Never taller than the view, so
                // the controls under it stay in reach.
                Rectangle {
                    height: root.theatre
                        ? column.height
                        : max(180px, min(column.width * 9 / 16, column.height - Spacing.base));
                    background: #000000;
                    border-radius: root.theatre ? 0px : Shape.large;
                    clip: true;

                    @children

                    // Nothing loaded yet: a still from the release and the one
                    // button that matters, rather than a black rectangle.
                    if !root.playing: Rectangle {
                        background: MaterialPalette.surface-container;

                        Image {
                            source: root.backdrop;
                            image-fit: cover;
                            width: 100%;
                            height: 100%;
                            opacity: root.backdrop-loaded ? 0.45 : 0.0;
                            animate opacity {
                                duration: Motion.enter-duration;
                                easing: Motion.enter;
                            }
                        }

                        if root.failed: Text {
                            text: Tr.episode-failed;
                            color: #FFFFFFD9;
                            font-size: Typography.body-medium-size;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            width: min(parent.width - 2 * Spacing.loose, 460px);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - root.start-height) / 2 - self.height - Spacing.base;
                        }

                        // The one button that matters on this screen, so it is
                        // the one shape Material reserves for that: an
                        // extended floating action button, lifted off the
                        // still behind it.
                        if root.first-episode > 0: FloatingActionButton {
                            style: FABStyle.standard;
                            icon: @image-url("../icons/play.svg");
                            text: root.resume-episode > 0 && root.watched-any
                                ? Tr.continue-watching + " " + root.first-episode
                                : Tr.watch-episode + " " + root.first-episode;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;

                            clicked => { root.play-episode(root.first-episode); }
                        }

                        // Nothing to start yet. It keeps the button's place
                        // and says why, rather than leaving the still bare.
                        if root.first-episode == 0: TonalButton {
                            text: root.loading ? Tr.loading : Tr.nothing-to-play;
                            enabled: false;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // On a narrow window the list sits under the picture instead
                // of beside it, and the description gives up its place — the
                // column has room for two of the three, and the description is
                // the one nobody came for.
                if root.narrow && !root.theatre: EpisodePicker {
                    // A fixed height, with its own list scrolling inside: the
                    // page scrolls past it as a whole.
                    height: 420px;
                    dubbers: root.dubbers;
                    dubber: root.dubber;
                    sources: root.sources;
                    source: root.source;
                    episodes: root.episodes;
                    current: root.current-episode;
                    current-index: root.current-index;
                    select-dubber(i) => { root.select-dubber(i); }
                    select-source(i) => { root.select-source(i); }
                    play-episode(p) => { root.play-episode(p); }
                download-episode(p) => { root.download-episode(p); }
                toggle-watched(p) => { root.toggle-watched(p); }
                toggle-all-watched => { root.toggle-all-watched(); }
                toggle-pin => { root.toggle-pin(); }
                all-watched: root.all-watched;
                }

                // ---- the release itself ----------------------------------
                if !root.theatre: HorizontalLayout {
                    padding-bottom: Spacing.base;

                    HorizontalLayout {
                        spacing: Spacing.base;
                        alignment: start;

                        Poster {
                            source: root.poster;
                            loaded: root.poster-loaded;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Spacing.tight;
                            alignment: start;

                            if root.original-title != "": Text {
                                text: root.original-title;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-medium-size;
                            }

                            HorizontalLayout {
                                spacing: Spacing.small;
                                alignment: start;

                                if root.score != "": Text {
                                    text: "★ " + root.score;
                                    color: MaterialPalette.primary;
                                    font-size: Typography.title-medium-size;
                                    font-weight: Typography.title-medium-weight-em;
                                }

                                Text {
                                    text: root.year;
                                    color: MaterialPalette.on-surface-variant;
                                    font-size: Typography.body-medium-size;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.episodes-label;
                                    color: MaterialPalette.on-surface-variant;
                                    font-size: Typography.body-medium-size;
                                    vertical-alignment: center;
                                }

                                if root.status != "": Text {
                                    text: root.status;
                                    color: MaterialPalette.on-surface-variant;
                                    font-size: Typography.body-medium-size;
                                    vertical-alignment: center;
                                }
                            }

                            if root.genres != "": Text {
                                text: root.genres;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-small-size;
                                wrap: word-wrap;
                            }

                            if root.studio != "": Text {
                                text: root.studio;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-small-size;
                            }

                            Text {
                                text: root.description;
                                color: MaterialPalette.on-surface;
                                font-size: Typography.body-medium-size;
                                wrap: word-wrap;
                            }

                            // Chips rather than posters: a franchise can run to
                            // thirty releases, and a row of names reads at a
                            // glance where a row of covers needs scrolling and
                            // thirty more downloads.
                            HorizontalLayout {
                                alignment: start;
                                padding-top: Spacing.tight;

                                OutlineButton {
                                    icon: @image-url("../icons/comment.svg");
                                    text: Tr.comments-title + (root.comment-count > 0 ? " · " + root.comment-count : "");
                                    clicked => { root.open-comments(); }
                                }

                                TextButton {
                                    icon: @image-url("../icons/flag.svg");
                                    text: Tr.report;
                                    clicked => { root.report(); }
                                }
                            }

                            if root.related.length > 0: LinkRow {
                                heading: Tr.franchise;
                                items: root.related;
                                picked(i) => { root.open-related(i); }
                            }

                            if root.platforms.length > 0: LinkRow {
                                heading: Tr.watch-elsewhere;
                                items: root.platforms;
                                picked(i) => { root.open-platform(i); }
                            }

                            if root.videos.length > 0: VideoRow {
                                heading: Tr.videos;
                                items: root.videos;
                                picked(i) => { root.open-video(i); }
                            }
                        }
                    }
                }
            }
            }

            // ---- choosing what to play -----------------------------------
            if !root.narrow && !root.theatre: EpisodePicker {
                width: 400px;
                dubbers: root.dubbers;
                dubber: root.dubber;
                sources: root.sources;
                source: root.source;
                episodes: root.episodes;
                current: root.current-episode;
                current-index: root.current-index;
                select-dubber(i) => { root.select-dubber(i); }
                select-source(i) => { root.select-source(i); }
                play-episode(p) => { root.play-episode(p); }
                download-episode(p) => { root.download-episode(p); }
                toggle-watched(p) => { root.toggle-watched(p); }
                toggle-all-watched => { root.toggle-all-watched(); }
                toggle-pin => { root.toggle-pin(); }
                all-watched: root.all-watched;
            }
        }
    }

    /// Whether the account has any progress here, which is the difference
    /// between "continue" and "watch".
    property <bool> watched-any: root.resume-episode > 0
        && root.episodes.length > 0
        && root.resume-episode != root.episodes[0].position;
}
