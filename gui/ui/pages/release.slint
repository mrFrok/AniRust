// SPDX-License-Identifier: GPL-3.0-or-later
//
// The release screen: what a title is, and which of it to watch.
//
// The player lives here rather than on a screen of its own. Watching an episode
// and picking the next one are the same activity, and sending the viewer away
// from the release to do the first meant the screen spent most of its area
// holding a description nobody was reading. So: the picture takes the space, the
// release sits under it, and the episode list stays beside it the whole time.
//
// The player itself is injected as this component's child, so the one instance
// that owns the video texture is declared once, in the window.

import { MaterialPalette, ActionChip } from "@material";
import { Typography } from "../globals/typography.slint";
import { Shape, Spacing, Motion } from "../globals/shape.slint";
import { Tr } from "../globals/tr.slint";
import { Tint } from "../globals/tint.slint";
import { VideoItem, PickerOption, EpisodeItem, LinkItem } from "../structs.slint";
import { EpisodePicker, Poster, Dropdown } from "../components/release-parts.slint";
import { TintPill, RoundIconButton } from "../components/ui-kit.slint";
import { QuietButton } from "../components/quiet-button.slint";

/// A heading and a wrapping row of chips under it.
component LinkRow inherits VerticalLayout {
    in property <string> heading;
    in property <[LinkItem]> items;
    /// A button at the end of the heading, when there is more to see.
    in property <string> action;
    callback picked(int);
    callback act();

    spacing: Spacing.small;
    padding-top: Spacing.base;

    HorizontalLayout {
        spacing: Spacing.small;

        Text {
            text: root.heading;
            color: MaterialPalette.on-surface;
            font-size: Typography.title-medium-size;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.action != "": QuietButton {
            text: root.action;
            clicked => { root.act(); }
        }
    }

    // One line, scrolled sideways, rather than wrapped: a row that wraps
    // works its height out for one line and is then drawn on three, and the
    // page under it ends too soon.
    Flickable {
        height: 40px;
        interactive: self.content-width > self.width;
        content-width: chips.preferred-width;

        chips := HorizontalLayout {
            spacing: Spacing.small;
            alignment: start;

            for item[index] in root.items: ActionChip {
                text: item.detail != "" ? item.label + " · " + item.detail : item.label;
                clicked => { root.picked(index); }
            }
        }
    }
}

/// The release's videos, a row of thumbnails scrolled sideways.
component VideoRow inherits VerticalLayout {
    in property <string> heading;
    in property <[VideoItem]> items;
    callback picked(int);

    spacing: Spacing.small;
    padding-top: Spacing.base;

    Text {
        text: root.heading;
        color: MaterialPalette.on-surface;
        font-size: Typography.title-small-size;
        font-weight: Typography.title-small-weight-em;
    }

    Flickable {
        height: 150px;
        interactive: self.content-width > self.width;
        content-width: row.preferred-width;

        row := HorizontalLayout {
            spacing: Spacing.small;
            alignment: start;

            for item[index] in root.items: Rectangle {
                width: 192px;

                VerticalLayout {
                    spacing: Spacing.hair;

                    Rectangle {
                        height: 108px;
                        border-radius: Shape.medium;
                        clip: true;
                        background: MaterialPalette.surface-container-high;
                        border-width: 1px;
                        border-color: touch.has-hover ? MaterialPalette.on-surface-variant : transparent;

                        Image {
                            source: item.image;
                            image-fit: cover;
                            width: 100%;
                            height: 100%;
                            visible: item.image-loaded;
                        }

                        Image {
                            source: @image-url("../icons/play.svg");
                            colorize: #FFFFFF;
                            width: 28px;
                            height: 28px;
                            opacity: 0.85;
                        }
                    }

                    Text {
                        text: item.title;
                        color: MaterialPalette.on-surface;
                        font-size: Typography.body-small-size;
                        overflow: elide;
                    }

                    Text {
                        text: item.detail;
                        color: MaterialPalette.on-surface-variant;
                        font-size: Typography.label-small-size;
                        overflow: elide;
                    }
                }

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(index); }
                }
            }
        }
    }
}

/// Five stars, the account's rating lit, and a hover preview of the one a
/// click would give.
component Rating inherits HorizontalLayout {
    in property <int> vote: 0;
    callback clicked(int);

    /// The star under the pointer, or 0 with none.
    property <int> hovered: 0;

    alignment: center;
    spacing: 0px;

    for i in 5: Rectangle {
        width: 30px;
        height: 36px;

        Text {
            // A filled star means a vote; an empty one is a choice still to
            // be made. Five grey filled stars read as five out of five.
            text: (root.hovered > 0 ? i < root.hovered : i < root.vote) ? "★" : "☆";
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
            color: (root.hovered > 0 ? i < root.hovered : i < root.vote)
                ? MaterialPalette.tertiary
                : MaterialPalette.on-surface-variant;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover) { root.hovered = i + 1; }
                else if (root.hovered == i + 1) { root.hovered = 0; }
            }
            clicked => { root.clicked(i + 1); }
        }
    }
}

export component ReleasePage inherits Rectangle {
    // ---- from Rust -------------------------------------------------------
    in property <string> title;
    in property <string> original-title;
    in property <string> year;
    in property <string> genres;
    in property <string> studio;
    in property <string> status;
    in property <string> description;
    in property <string> score;
    in property <string> episodes-label;
    in property <image> poster;
    in property <bool> poster-loaded: false;
    /// A still from the release, shown behind the play button before anything
    /// has been started.
    in property <image> backdrop;
    in property <bool> backdrop-loaded: false;
    in property <bool> loading: false;

    in property <[PickerOption]> dubbers;
    in property <int> dubber: 0;
    in property <[PickerOption]> sources;
    in property <int> source: 0;
    in property <[EpisodeItem]> episodes;
    in property <bool> all-watched: false;
    /// Episode to resume, or 0 when nothing was started.
    in property <int> resume-episode: 0;
    /// Episode in the player, or 0 when nothing is loaded.
    in property <int> current-episode: 0;
    /// Where that episode sits in the list.
    in property <int> current-index: 0;
    /// Whether the player has anything at all — the difference between showing
    /// the picture and showing the invitation to start it.
    in property <bool> playing: false;
    /// The player fills the window and everything else steps aside.
    in property <bool> theatre: false;
    /// Set when an episode could not be resolved, so the screen says so rather
    /// than quietly going back to the invitation to try again.
    in property <bool> failed: false;

    /// The franchise's other releases, and the services carrying this one.
    in property <int> comment-count: 0;
    callback open-comments();
    in property <[LinkItem]> related: [];
    in property <[LinkItem]> platforms: [];
    /// Trailers, openings and the like, opened where they are hosted.
    in property <[VideoItem]> videos: [];
    callback open-video(int);
    callback open-related(int);
    callback open-platform(int);

    // ---- the account's view of it ---------------------------------------
    in property <bool> signed-in: false;
    /// Which of the account's lists it is in: 0 none, then the five lists in
    /// the bookmarks' order.
    in property <int> list: 0;
    in property <bool> favourite: false;
    /// The account's rating, 1 to 5, or 0 for none.
    in property <int> vote: 0;

    // ---- to Rust ---------------------------------------------------------
    callback set-list(int);
    callback toggle-favourite();
    /// Something can be played: the release is out. Only announced, the page
    /// is the release itself, without a player or a list.
    in property <bool> watchable: true;
    /// A note from the service's team, shown as given.
    in property <string> note;
    /// The whole franchise, oldest first, is asked for.
    callback open-franchise();
    /// Out, so it can be rated. A release that is only announced cannot.
    in property <bool> rateable: true;
    callback add-to-collection();
    callback report();
    /// A star was clicked. Clicking the rating already given takes it back.
    callback set-vote(int);
    /// Asked for any of the three above without an account.
    callback sign-in();
    callback select-dubber(int);
    callback select-source(int);
    callback play-episode(int);
    callback download-episode(int);
    callback toggle-watched(int);
    callback toggle-all-watched();
    callback toggle-pin();
    callback go-back();

    background: MaterialPalette.surface;

    // Size constraints stated outright rather than derived from the children.
    //
    // The page is responsive: `narrow` reads its own width, and the children
    // lay out differently below the threshold. Deriving the page's constraints
    // from those children would close the loop — width feeds `narrow`, which
    // feeds the children, which feed the width — so the page instead fills
    // whatever it is given and lets the window declare the real limits.
    min-width: 0px;
    min-height: 0px;
    preferred-width: 0px;
    preferred-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    /// The list of episodes beside the picture.
    property <length> picker-width: 380px;

    /// Whether the episode list goes under the player instead of beside it.
    ///
    /// Decided by the window rather than measured here. A component that reads
    /// its own width to choose which children exist is reading the answer to
    /// the question its children are being asked, and Slint rightly calls that
    /// a binding loop.
    in property <bool> narrow: false;

    /// What the play button starts: where the account left off, or the
    /// beginning.
    property <int> first-episode: root.resume-episode > 0
        ? root.resume-episode
        : (root.episodes.length > 0 ? root.episodes[0].position : 0);

    changed theatre => {
        if (root.theatre) { page.content-y = 0px; }
    }

    VerticalLayout {
        // ---- header ------------------------------------------------------
        if !root.theatre: Rectangle {
            height: 76px;
            background: MaterialPalette.surface;

            // A hairline under it, so the picture or the page below reads as
            // a separate thing without a second shade of grey.
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: MaterialPalette.outline-variant;
            }

            HorizontalLayout {
                padding-left: Spacing.base;
                padding-right: Spacing.page;
                spacing: Spacing.small;

                VerticalLayout {
                    alignment: center;

                    RoundIconButton {
                        icon: @image-url("../icons/back.svg");
                        tooltip: Tr.back;
                        clicked => { root.go-back(); }
                    }
                }

                // The title lives in the hero while the release is being
                // looked at; up here it would be said twice on one screen.
                Text {
                    visible: root.playing || root.narrow;
                    text: root.title;
                    color: MaterialPalette.on-surface;
                    font-size: Typography.title-medium-size;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if !root.playing && !root.narrow: Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                VerticalLayout {
                    alignment: center;

                    RoundIconButton {
                        icon: root.favourite ? @image-url("../icons/heart-filled.svg") : @image-url("../icons/heart.svg");
                        tooltip: root.favourite ? Tr.remove-from-favourites : Tr.add-to-favourites;
                        active: root.favourite;
                        clicked => {
                            if (root.signed-in) { root.toggle-favourite(); } else { root.sign-in(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    RoundIconButton {
                        icon: @image-url("../icons/collection-add.svg");
                        tooltip: Tr.add-to-collection;
                        clicked => {
                            if (root.signed-in) { root.add-to-collection(); } else { root.sign-in(); }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Dropdown {
                        width: 200px;
                        height: 44px;
                        model: [
                            { label: Tr.not-in-list },
                            { label: Tr.list-watching },
                            { label: Tr.list-planned },
                            { label: Tr.list-watched },
                            { label: Tr.list-hold },
                            { label: Tr.list-dropped },
                        ];
                        current: root.list;
                        selected(i) => {
                            if (root.signed-in) { root.set-list(i); } else { root.sign-in(); }
                        }
                    }
                }
            }
        }

        // ---- body --------------------------------------------------------
        //
        // One page that scrolls as a whole: the picture with the list of
        // episodes beside it, as tall as the picture and no taller, then the
        // release under both. In theatre the picture is the whole view, and
        // there is nothing to scroll to and no bar to show.
        // A plain flickable rather than a scroll view: the scroll view keeps
        // a strip down the side and along the foot for its bars whether or
        // not they show, which in theatre is a frame round the picture. The
        // bar is drawn by hand instead, thin, and only off theatre.
        page := Flickable {
            vertical-stretch: 1;
            // Its own constraints, stated: left to its content, the page's
            // height would follow the body, and the body's picture follows
            // the page's height.
            min-height: 0px;
            preferred-height: 0px;
            max-height: 100000px;
            min-width: 0px;
            preferred-width: 0px;
            max-width: 100000px;
            interactive: !root.theatre;
            content-width: self.width;
            content-height: body.preferred-height;

            body := VerticalLayout {
                width: page.width;
                padding: root.theatre ? 0px : Spacing.base;
                spacing: root.theatre ? 0px : Spacing.base;

                // ---- the picture, and what to play beside it ------------
                //
                // Not there for a release that is only announced: there is
                // nothing to play, and a black box with an empty list beside
                // it says so worse than the release's own page does.
                HorizontalLayout {
                    spacing: root.theatre ? 0px : Spacing.base;
                    visible: root.watchable || root.theatre;
                    // 16:9 of the width the picture gets, from the page's
                    // own width — a box sizing itself from its own width is
                    // a layout loop — and never taller than the view.
                    height: !self.visible ? 0px
                        : root.theatre ? page.height
                        : root.narrow && !root.playing ? clamp(page.height * 0.42, 148px, 230px)
                        : root.playing ? max(220px, min(
                            (page.width - 2 * Spacing.base
                                - (root.narrow ? 0px : root.picker-width + Spacing.base)) * 9 / 16,
                            page.height - 2 * Spacing.base))
                        // Before anything is playing this is a release page,
                        // not an empty player: a 16:9 frame 570px tall says
                        // "here will be video" and pushes the title, genres
                        // and description off the first screen.
                        : min(480px, max(220px, min(
                            (page.width - 2 * Spacing.base
                                - (root.narrow ? 0px : root.picker-width + Spacing.base)) * 9 / 16,
                            page.height - 2 * Spacing.base)));

                Rectangle {
                    horizontal-stretch: 1;
                    background: #000000;
                    border-radius: root.theatre ? 0px : Shape.large;
                    clip: true;

                    @children

                    // Nothing loaded yet: the release itself, the way the
                    // phone client opens it — a still behind, the poster, the
                    // name, and the one button that matters.
                    if !root.playing: Rectangle {
                        background: #0E0E10;

                        Image {
                            source: root.backdrop-loaded ? root.backdrop : root.poster;
                            image-fit: cover;
                            width: 100%;
                            height: 100%;
                            opacity: root.backdrop-loaded ? 0.8 : (root.poster-loaded ? 0.45 : 0.0);
                            animate opacity {
                                duration: Motion.enter-duration;
                                easing: Motion.enter;
                            }
                        }

                        // Before any art arrives: a picture frame rather than
                        // a black hole that looks like a failed video.
                        if !root.backdrop-loaded && !root.poster-loaded: Image {
                            source: @image-url("../icons/poster.svg");
                            colorize: #FFFFFF3D;
                            width: 56px;
                            height: 56px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        // A scrim under the words, so white stays white over a
                        // bright still. Neutral black, not a colour wash: the
                        // poster is the only colourful thing here.
                        Rectangle {
                            background: @linear-gradient(180deg, #00000000 22%, #000000B8 68%, #000000F2 100%);
                        }

                        HorizontalLayout {
                            padding: 28px;
                            spacing: 24px;

                            // The poster sits on the same baseline as the
                            // words beside it, which is what makes the two
                            // read as one block rather than as a picture
                            // parked in a corner.
                            if !root.narrow && self.height > 280px: VerticalLayout {
                                alignment: end;
                                vertical-stretch: 1;

                                Poster {
                                    width: 168px;
                                    height: 252px;
                                    source: root.poster;
                                    loaded: root.poster-loaded;
                                    drop-shadow-blur: 28px;
                                    drop-shadow-color: #00000080;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                alignment: end;
                                spacing: 8px;

                                Text {
                                    text: root.title;
                                    color: #FFFFFF;
                                    font-size: root.narrow ? 24px : 32px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                    max-lines: 2;
                                }

                                if root.original-title != "": Text {
                                    text: root.original-title;
                                    color: #FFFFFFB8;
                                    font-size: Typography.body-medium-size;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    if root.score != "": Text {
                                        text: "★ " + root.score;
                                        color: #FFD48A;
                                        font-size: Typography.title-small-size;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.year
                                            + (root.episodes-label != "" ? " · " + root.episodes-label : "")
                                            + (root.status != "" ? " · " + root.status : "");
                                        color: #FFFFFFC7;
                                        font-size: Typography.body-medium-size;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                if root.failed: Text {
                                    text: Tr.episode-failed;
                                    color: #FFFFFFD9;
                                    font-size: Typography.body-medium-size;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    padding-top: 8px;
                                    spacing: Spacing.small;
                                    alignment: start;

                                    if root.first-episode > 0: TintPill {
                                        text: root.resume-episode > 0 && root.watched-any
                                            ? Tr.continue-episode + " " + root.first-episode
                                            : Tr.watch-episode + " " + root.first-episode;
                                        icon: @image-url("../icons/play.svg");
                                        has-icon: true;
                                        wash: MaterialPalette.primary;
                                        ink: MaterialPalette.on-primary;
                                        inner-height: 52px;
                                        clicked => { root.play-episode(root.first-episode); }
                                    }

                                    // Nothing to start yet. It keeps the
                                    // button's place and says why, rather
                                    // than leaving the still bare.
                                    if root.first-episode == 0: TintPill {
                                        text: root.loading ? Tr.loading : Tr.nothing-to-play;
                                        enabled: false;
                                        wash: MaterialPalette.surface-container-high;
                                        ink: MaterialPalette.on-surface-variant;
                                        inner-height: 52px;
                                    }
                                }
                            }
                        }
                    }
                }

                    if !root.narrow && !root.theatre: EpisodePicker {
                    width: root.picker-width;
                    dubbers: root.dubbers;
                    dubber: root.dubber;
                    sources: root.sources;
                    source: root.source;
                    episodes: root.episodes;
                    current: root.current-episode;
                    current-index: root.current-index;
                    all-watched: root.all-watched;
                    select-dubber(i) => { root.select-dubber(i); }
                    select-source(i) => { root.select-source(i); }
                    play-episode(p) => { root.play-episode(p); }
                    download-episode(p) => { root.download-episode(p); }
                    toggle-watched(p) => { root.toggle-watched(p); }
                    toggle-all-watched => { root.toggle-all-watched(); }
                    toggle-pin => { root.toggle-pin(); }
                }
                }

                // On a narrow window the list sits under the picture.
                if root.narrow && !root.theatre && root.watchable: EpisodePicker {
                    height: 420px;
                    dubbers: root.dubbers;
                    dubber: root.dubber;
                    sources: root.sources;
                    source: root.source;
                    episodes: root.episodes;
                    current: root.current-episode;
                    current-index: root.current-index;
                    all-watched: root.all-watched;
                    select-dubber(i) => { root.select-dubber(i); }
                    select-source(i) => { root.select-source(i); }
                    play-episode(p) => { root.play-episode(p); }
                    download-episode(p) => { root.download-episode(p); }
                    toggle-watched(p) => { root.toggle-watched(p); }
                    toggle-all-watched => { root.toggle-all-watched(); }
                    toggle-pin => { root.toggle-pin(); }
                }

                // A word from the service's own team about this release —
                // that a film retells a series, that an order matters.
                if !root.theatre && root.note != "": Rectangle {
                    border-radius: Shape.large;
                    background: Tint.coral-bg;
                    height: note-text.preferred-height + 2 * Spacing.base;

                    note-text := Text {
                        x: Spacing.base;
                        width: parent.width - 2 * Spacing.base;
                        y: Spacing.base;
                        text: root.note;
                        color: Tint.coral-ink;
                        font-size: Typography.body-medium-size;
                        wrap: word-wrap;
                    }
                }

                // ---- the release itself ----------------------------------
                if !root.theatre: HorizontalLayout {
                        spacing: Spacing.base;
                        alignment: start;

                        // The hero already holds the poster; beside the
                        // details it would be the same picture twice.
                        if root.playing: Poster {
                            source: root.poster;
                            loaded: root.poster-loaded;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            max-width: 880px;
                            spacing: Spacing.tight;
                            alignment: start;

                            if root.playing && root.original-title != "": Text {
                                text: root.original-title;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-medium-size;
                            }

                            // One line of facts, the score first and the
                            // only one in full colour.
                            HorizontalLayout {
                                visible: root.playing;
                                spacing: Spacing.small;
                                alignment: start;

                                if root.score != "": Text {
                                    text: "★ " + root.score;
                                    color: MaterialPalette.on-surface;
                                    font-size: Typography.body-large-size;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.year
                                        + (root.episodes-label != "" ? " · " + root.episodes-label : "")
                                        + (root.status != "" ? " · " + root.status : "");
                                    color: MaterialPalette.on-surface-variant;
                                    font-size: Typography.body-medium-size;
                                    vertical-alignment: center;
                                }
                            }

                            if root.genres != "" || root.studio != "": Text {
                                text: root.genres
                                    + (root.genres != "" && root.studio != "" ? " · " : "")
                                    + root.studio;
                                color: MaterialPalette.on-surface-variant;
                                font-size: Typography.body-medium-size;
                                wrap: word-wrap;
                            }

                            if root.rateable: HorizontalLayout {
                                spacing: Spacing.small;
                                alignment: start;

                                Text {
                                    text: Tr.your-rating;
                                    color: MaterialPalette.on-surface-variant;
                                    font-size: Typography.label-medium-size;
                                    vertical-alignment: center;
                                }

                                Rating {
                                    vote: root.vote;
                                    clicked(n) => {
                                        if (root.signed-in) { root.set-vote(n); } else { root.sign-in(); }
                                    }
                                }
                            }

                            Rectangle {
                                height: Spacing.small;
                                background: transparent;
                                visible: !root.playing;
                            }

                            Text {
                                text: Tr.synopsis;
                                color: MaterialPalette.on-surface;
                                font-size: 18px;
                                font-weight: 600;
                            }

                            Text {
                                // Measured at the width it is drawn at: a
                                // wrapped paragraph in a layout reports the
                                // height of one line, and the page under it
                                // then ends too soon.
                                min-height: description-measure.preferred-height;
                                text: root.description;
                                color: MaterialPalette.on-surface;
                                font-size: 16px;
                                wrap: word-wrap;
                            }

                            // Chips rather than posters: a franchise can run to
                            // thirty releases, and a row of names reads at a
                            // glance where a row of covers needs scrolling and
                            // thirty more downloads.
                            HorizontalLayout {
                                alignment: start;
                                spacing: Spacing.small;
                                padding-top: Spacing.small;

                                TintPill {
                                    text: Tr.comments-title + (root.comment-count > 0 ? " · " + root.comment-count : "");
                                    icon: @image-url("../icons/comment.svg");
                                    has-icon: true;
                                    wash: MaterialPalette.surface-container;
                                    ink: MaterialPalette.on-surface;
                                    clicked => { root.open-comments(); }
                                }

                                // Needed rarely, and never instead of watching.
                                QuietButton {
                                    has-icon: true;
                                    icon: @image-url("../icons/flag.svg");
                                    text: Tr.report;
                                    clicked => { root.report(); }
                                }
                            }

                            if root.related.length > 0: LinkRow {
                                heading: Tr.franchise;
                                items: root.related;
                                action: Tr.show-all;
                                picked(i) => { root.open-related(i); }
                                act => { root.open-franchise(); }
                            }

                            if root.platforms.length > 0: LinkRow {
                                heading: Tr.watch-elsewhere;
                                items: root.platforms;
                                picked(i) => { root.open-platform(i); }
                            }

                            if root.videos.length > 0: VideoRow {
                                heading: Tr.videos;
                                items: root.videos;
                                picked(i) => { root.open-video(i); }
                            }
                        }
                    }
            }
        }
    }

    // The description as it wraps in its column — the page's width, less its
    // padding and, while a poster stands beside it, the poster and the gap —
    // for its true height. Invisible.
    description-measure := Text {
        visible: false;
        width: min(880px, max(1px, page.width - 2 * Spacing.base - (root.playing ? 150px + Spacing.base : 0px)));
        text: root.description;
        font-size: 16px;
        wrap: word-wrap;
    }

    // The page's own scroll bar: where the view is in the page, and how much
    // of it shows. Drawn over the page's right edge, so it takes no room.
    if !root.theatre && page.content-height > page.height + 1px: Rectangle {
        x: page.absolute-position.x - root.absolute-position.x + page.width - 10px;
        y: page.absolute-position.y - root.absolute-position.y
            + (page.height - self.height) * (-page.content-y / (page.content-height - page.height));
        width: 8px;
        height: max(40px, page.height * page.height / page.content-height);
        border-radius: 4px;
        background: MaterialPalette.on-surface-variant.with-alpha(0.45);
    }

    /// Whether the account has any progress here, which is the difference
    /// between "continue" and "watch".
    property <bool> watched-any: root.resume-episode > 0
        && root.episodes.length > 0
        && root.resume-episode != root.episodes[0].position;
}
