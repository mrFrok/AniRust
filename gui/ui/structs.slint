// SPDX-License-Identifier: GPL-3.0-or-later
//
// Shapes shared between Rust and the interface. `slint-build` generates a Rust
// struct of the same name for each, so these are the contract between the two
// halves — keep them narrow, and keep display formatting on the Slint side
// where the translations live.

/// One entry in a dropdown.
///
/// Voice-overs and sources are the same shape of choice — a name, and a hint at
/// how much is behind it — so they share a struct rather than each having one
/// that differs only in spelling.
export struct PickerOption {
    label: string,
    /// Episodes this option carries, or 0 when the server does not say.
    episodes: int,
    /// Subtitles rather than a dub. Only voice-overs set this.
    is-sub: bool,
    /// The voice-over the account opens this release with. Only voice-overs
    /// set this.
    pinned: bool,
}

/// A release as a browsing screen shows it.
///
/// Carries no id: which release a card is comes from its place in the list, and
/// Anixart ids are 64-bit while Slint's `int` is not.
export struct ReleaseCard {
    title: string,
    /// Year and episode count, already joined — the separator is punctuation,
    /// not data.
    subtitle: string,
    score: string,
    poster: image,
    poster-loaded: bool,
}

/// One entry in the download queue.
export struct DownloadItem {
    title: string,
    dubber: string,
    /// One of: queued, running, done, failed.
    status: string,
    progress: float,
    /// Where it was written, or why it was not.
    detail: string,
}

/// One episode in the list.
export struct EpisodeItem {
    position: int,
    /// The host's own title, empty unless it says something the number does
    /// not. Rust drops titles that are just the number restated.
    name: string,
    /// Already seen, according to the account.
    watched: bool,
    /// Where playback left off, as "12:30", or empty if never started.
    resume-at: string,
    /// Filler, so a viewer following the manga can skip it.
    filler: bool,
}

/// The account's own profile, as its screen shows it.
///
/// Counts rather than lists: the screen states how much is in each list and
/// opens the list itself when one is clicked, which is the only thing a count
/// is good for.
export struct Account {
    login: string,
    /// The line the account writes about itself. Usually empty.
    status: string,
    /// Registered on, as `2019-05-12`. A date without the name of a month is
    /// a date this client can show in either language without knowing twelve
    /// more words in each.
    registered: string,
    verified: bool,
    watching: int,
    planned: int,
    watched: int,
    hold: int,
    dropped: int,
    votes: int,
    comments: int,
    collections: int,
    friends: int,
}

/// One release on the profile screen's list of what was watched lately.
///
/// Carries no id for the same reason a card does not: which release it is
/// comes from its place in the list.
export struct HistoryItem {
    title: string,
    /// The episode the account left off on, or 0 when the server does not say.
    episode: int,
    poster: image,
    poster-loaded: bool,
    /// How long ago it was watched, in minutes. The wording is the interface's
    /// business, and Russian needs three forms of every counting word.
    minutes-ago: int,
}

/// One post, as the feed shows it.
///
/// Carries no id: which post it is comes from its place in the list, as with
/// every other list this interface shows.
export struct FeedPost {
    /// Where it was published — a channel's title, or the account's name for
    /// a personal blog.
    channel: string,
    channel-avatar: image,
    channel-avatar-loaded: bool,
    /// Whether the account follows that channel. Only offered for channels:
    /// a blog is followed by befriending its author, which this client does
    /// not do.
    subscribed: bool,
    can-subscribe: bool,
    /// How long ago it was posted, in minutes, worded by the interface.
    minutes-ago: int,
    /// The body with its markup taken out, blocks a blank line apart.
    text: string,
    /// The first picture in the post, if it has one.
    picture: image,
    picture-loaded: bool,
    has-picture: bool,
    comments: int,
    votes: int,
    /// Whether the account has given it a heart.
    liked: bool,
    pinned: bool,
}

/// Something on the release page that leads somewhere else: another release
/// of the franchise, or a service carrying this one.
export struct LinkItem {
    label: string,
    /// A quieter second part — a year, a kind of release.
    detail: string,
}

/// One comment, or one reply under it, as the thread shows it.
///
/// Replies are rows of the same list, marked and indented, rather than a list
/// inside a list: a thread is read top to bottom either way, and one flat
/// model scrolls as one.
export struct CommentItem {
    author: string,
    avatar: image,
    avatar-loaded: bool,
    /// How long ago, in minutes; the wording is the interface's.
    minutes-ago: int,
    text: string,
    spoiler: bool,
    /// Whether a spoiler has been opened. Kept with the row so it survives
    /// the row being redrawn.
    revealed: bool,
    edited: bool,
    deleted: bool,
    /// Up votes less down votes.
    score: int,
    /// This account's vote: 0 none, 1 down, 2 up.
    my-vote: int,
    /// Replies under it, and whether they are shown. Top-level rows only.
    replies: int,
    expanded: bool,
    is-reply: bool,
    /// Written by this account, so it can be edited and deleted.
    mine: bool,
    /// The episode a release comment was written at, or 0.
    episode: int,
}
